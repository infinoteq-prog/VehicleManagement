@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        var fullAccess = 'True';
        var viewAccess = 'True';

        $(document).ready(function () {
            setSideMenu("transporter-master");
            if (fullAccess === "True" || viewAccess === "True") {
                makeFieldsReadOnly();
                var transporterMasterId = GetParameterValues('transporterMasterId');
                getTransporterMaster(transporterMasterId);
            }
        });

        function makeFieldsReadOnly() {
            $("#txtUserName").prop("readonly", true);
            $("#txtStateName").prop("readonly", true);
            $("#txtDistrictName").prop("readonly", true);
            $("#txtCityName").prop("readonly", true);
            $("#txtTransporterCode").prop("readonly", true);
            $("#txtTransporterName").prop("readonly", true);
            $("#txtOwnerName").prop("readonly", true);
            $("#txtMobileNo").prop("readonly", true);
            $("#txtEmailAddress").prop("readonly", true);
            $("#txtAddress1").prop("readonly", true);
            $("#txtAddress2").prop("readonly", true);
            $("#txtAddress3").prop("readonly", true);
            $("#txtPincode").prop("readonly", true);
            $("#txtGstinNo").prop("readonly", true);
            $("#txtPanNo").prop("readonly", true);
            $("#txtBillPrefix").prop("readonly", true);
            $("#chkIsActive").prop('checked', false);
            $("#chkIsActive").attr("disabled", true);
        }

        function getTransporterMaster(transporterMasterId) {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "TransporterMaster/getTransporterMasterbyId")',
                type: "GET",
                data: { transporterMasterId: transporterMasterId },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $("#txtUserName").val(data.userName);
                        $("#txtStateName").val(data.stateName);
                        $("#txtDistrictName").val(data.districtName);
                        $("#txtCityName").val(data.cityName);
                        $("#txtTransporterCode").val(data.transporterCode);
                        $("#txtTransporterName").val(data.transporterName);
                        $("#txtOwnerName").val(data.ownerName);
                        $("#txtMobileNo").val(data.mobileNo);
                        $("#txtEmailAddress").val(data.emailID);
                        $("#txtAddress1").val(data.address1);
                        $("#txtAddress2").val(data.address2);
                        $("#txtAddress3").val(data.address3);
                        $("#txtPincode").val(data.pinCode);
                        $("#txtGstinNo").val(data.gstinNo);
                        $("#txtPanNo").val(data.panNo);
                        $("#txtBillPrefix").val(data.billPrifix);
                        $("#chkIsActive").prop('checked', data.isActive);
                    } else {
                        $.confirm({
                            title: 'Transporter Master',
                            content: 'Transporter Master does not Exists!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}