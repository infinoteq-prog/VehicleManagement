        function updateUserSubscription() {
            var isValid = checkValidation();
            if (isValid == true) {
                if ($('#ddlUser option:selected').val() != "0"
                    && $('#ddlState option:selected').val() != "0"
                    && $('#ddlDistrict option:selected').val() != "0"
                    && $('#ddlCity option:selected').val() != "0"
                    && $("#txtTransporterCode").val() != ""
                    && $("#txtTransporterName").val() != ""
                    && $("#txtOwnerName").val() != ""
                    && $("#txtMobileNo").val() != ""
                    && $("#txtEmailAddress").val() != ""
                    && $("#txtAddress1").val() != ""
                    && $("#txtGstinNo").val() != ""
                    && $("#txtPanNo").val() != ""
                    && $("#txtBillPrefix").val() != "") {
                    var id = $('#hdnTransporterMasterID').val();
                    var transporterCode = $("#txtTransporterCode").val();
                    var transporterName = $("#txtTransporterName").val();
                    var ownerName = $("#txtOwnerName").val();
                    var mobileNo = $("#txtMobileNo").val();
                    var emailId = $("#txtEmailAddress").val();
                    var address1 = $("#txtAddress1").val();
                    var address2 = $("#txtAddress2").val();
                    var address3 = $("#txtAddress3").val();
                    var userId = $('#ddlUser option:selected').val();
                    var stateId = $('#ddlState option:selected').val();
                    var districtId = $('#ddlDistrict option:selected').val();
                    var cityId = $('#ddlCity option:selected').val();
                    var pinCode = $("#txtPincode").val();
                    var gstinNo = $("#txtGstinNo").val();
                    var panNo = $("#txtPanNo").val();
                    var billPrefix = $("#txtBillPrefix").val();
                    var isActive = $("#chkIsActive").is(":checked");

                    $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "TransporterMaster/Update")',
                        type: "POST",
                        dataType: "json",
                            data: { id: id, transporterCode: transporterCode, transporterName: transporterName,
                                    ownerName: ownerName, mobileNo: mobileNo, emailId: emailId,
                                    address1: address1, address2: address2, address3: address3,
                                    userId: userId, stateId: stateId, districtId: districtId,
                                    cityId: cityId, pinCode: pinCode, gstinNo: gstinNo,
                                    panNo: panNo, billPrefix: billPrefix, isActive: isActive
                            },
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'Update Transporter Master!',
                                        content: "Transporter Master has been updated successfully!",
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    clearControls();
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "TransporterMaster/Update?transporterMasterId=")' + $("#hdnTransporterMasterID").val();
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'Transporter Master Already Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                    $("#divTransporterMaster").hide();
                                }
                            } else {
                                console.log(data);
                                //clearControls();
                                $.confirm({
                                    title: 'Error Occoured!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divTransporterMaster").hide();
                            }
                        }
                    });
                }
            }
            else
            {
                 $(".jconfirm-title").css('font-size', '22px');
                 $(".jconfirm-content").css('color', 'red');
                 $.confirm({
                    title: 'Transporter Master Validation',
                    content: valiationMessage,
                    icon: 'fa fa-warning',
                    type: 'red',
                    buttons: {
                        omg: {
                            text: 'OK',
                            btnClass: 'btn-red',
                        },
                    }
                });
            }
        }
            
