        function searchTransporterMaster() {
            if ($.fn.DataTable.isDataTable("#tblTransporterMaster")) {
                $('#tblTransporterMaster tbody').empty();
                $('#tblTransporterMaster').DataTable().clear().destroy();
            }

            var userId = 0;
            var stateId = 0;
            var districtId = 0;
            var cityId = 0;
            var transporterCode = $("#txtTransporterCode").val();
            var transporterName = $("#txtTransporterName").val();
            var ownerName = $("#txtOwnerName").val();
            var mobileNo = $("#txtMobileNo").val();
            var emailId = $("#txtEmailAddress").val();
            var address1 = $("#txtAddress1").val();
            var address2 = $("#txtAddress2").val();
            var address3 = $("#txtAddress3").val();
            var pinCode = $("#txtPincode").val();
            var gstinNo = $("#txtGstinNo").val();
            var panNo = $("#txtPanNo").val();
            var billPrefix = $("#txtBillPrefix").val();
            var isActive = $("#chkIsActive").is(":checked");

            if( $('#ddlUser option:selected').val() != null && $('#ddlUser option:selected').val() != undefined){
                userId = $('#ddlUser option:selected').val();
            }

            if( $('#ddlState option:selected').val() != null && $('#ddlState option:selected').val() != undefined){
                stateId = $('#ddlState option:selected').val();
            }

            if( $('#ddlDistrict option:selected').val() != null &&  $('#ddlDistrict option:selected').val() != undefined){
                districtId = $('#ddlDistrict option:selected').val();
            }

