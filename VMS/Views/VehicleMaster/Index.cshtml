        function getVehicleMasterList() {
            if ($.fn.DataTable.isDataTable("#tblVehicleMaster")) {
                $('#tblVehicleMaster tbody').empty();
                $('#tblVehicleMaster').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "VehicleMaster/getVehicleMasterList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $.each(data, function (i, item) {
                            var sno = 0;
                            var rows = "";
                            var row = "";
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
