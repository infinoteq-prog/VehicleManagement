@section scripts {  
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";

        $(document).ready(function () {
            //Fill Vehicle Master DropdownList
            setSideMenu("vehicle-master");
            // $("#chkIsActive").attr("checked", true);
            // $("#chkIsActive").attr("disabled", true);
            getMakeMaster();            
            getVehicleTypeMaster();
            getBodyTypeMaster();
            getManufacturerTypeMaster();
            if (fullAccess === "True" || addAccess === "True") {
                checkValidationOnChange();
            }
            if (fullAccess === "True" || viewAccess === "True") {
                getVehicleMasterList();
            }

            $(function () {
                  $("#ddlMakeMaster").change(function () {
                      var makeId = $(this).val();
                      getModelMasterWithMakeId(makeId);
               });

                var d = new Date();

                var month = d.getMonth()+1;
                var day = d.getDate();

                var output = d.getFullYear() + '-' +
                    (month<10 ? '0' : '') + month + '-' +
                    (day<10 ? '0' : '') + day;

                $("#txtVehicleCreationDate").val(output);
            });

            $(function () {
                $("#txtVehicleCreationDate").datepicker({
                    dateFormat: 'dd-mm-yy',
                    changeYear: true,
                    changeMonth: true,
                });
                 $("#txtRTODue").datepicker({
                    dateFormat: 'dd-mm-yy',
                    changeYear: true,
                    changeMonth: true,
                });
                 $("#txtRTODue").datepicker({
                    dateFormat: 'dd-mm-yy',
                    changeYear: true,
                    changeMonth: true,
                });

                 $("#txtFitnessDue").datepicker({
                    dateFormat: 'dd-mm-yy',
                    changeYear: true,
                    changeMonth: true,
                });

                 $("#txtPollutionDue").datepicker({
                    dateFormat: 'dd-mm-yy',
                    changeYear: true,
                    changeMonth: true,
                });

                 $("#txtRTODoc").datepicker({
                    dateFormat: 'dd-mm-yy',
                    changeYear: true,
                    changeMonth: true,
                });

                 $("#txtNationalPermitDue").datepicker({
                    dateFormat: 'dd-mm-yy',
                    changeYear: true,
                    changeMonth: true,
                });

                $("#txtLocalPermitDue").datepicker({
                    dateFormat: 'dd-mm-yy',
                    changeYear: true,
                    changeMonth: true,
                });

                 $("#txtRcValidityDue").datepicker({
                    dateFormat: 'dd-mm-yy',
                    changeYear: true,
                    changeMonth: true,
                });

                $("#txtInsuranceDue").datepicker({
                    dateFormat: 'dd-mm-yy',
                    changeYear: true,
                    changeMonth: true,
                });
                         
            });
        });

        function setDropDownStyle(cltr){
            if ($(cltr).find(":selected").val() == "0") {
                $(cltr).attr('class', 'form-control vaidationTextBoxError');
            } else {
                $(cltr).attr('class', 'form-control');
            }
        }

        function setTextboxStyle(cltr) {
            if ($(cltr).val() == "") {
                $(cltr).attr('class', 'form-control vaidationTextBoxError');
            } else {
                $(cltr).attr('class', 'form-control');
            }
        }

