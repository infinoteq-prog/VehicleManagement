        function saveVehicleMaster() {
            var isValid = checkValidation(); 

            if (isValid == true) {
                if ($('#ddlMakeMaster option:selected').val() != "0" &&
                    $('#ddlModelMaster option:selected').val() != "0" &&
                    $('#ddlVehicleType option:selected').val() != "0" &&
                    $('#ddlBodyType option:selected').val() != "0" &&
                    $('#ddlManufacturerType option:selected').val() != "0" &&
                    $("#txtVehicleNo").val() != "" &&
                    $("#txtVehicleCreationDate").val() != "" &&
                    $("#txtVehicleOwner").val() != "" &&
                    $("#txtNoOfTyres").val() != "" &&
                    $("#txtMfgYear").val() != "" &&
                    $("#txtEngineNo").val() != "" &&
                    $("#txtChasisNo").val() != "" &&
                    $("#txtFinencerName").val() != "" &&
                    $("#txtRunningKm").val() != "" &&
                    $("#txtPanNo").val() != "" &&
                    $("#txtInsuranceDue").val() != "" &&
                    $("#txtNationalPermitDue").val() != "" &&
                    $("#txtLocalPermitDue").val() != "" &&
                    $("#txtRcValidityDue").val() != "" &&
                    $("#txtRTODue").val() != "" &&
                    $("#txtPollutionDue").val() != "" &&
                    $("#txtFitnessDue").val() != "") {
                    var purchaseDate =  $("#txtVehicleCreationDate").val().split("-").reverse().join("-");
                    var insuranceDue = $("#txtInsuranceDue").val().split("-").reverse().join("-");
                    var nationalPermitDue = $("#txtNationalPermitDue").val().split("-").reverse().join("-");
                    var localPermitDue = $("#txtLocalPermitDue").val().split("-").reverse().join("-");
                    var rcValidityDue = $("#txtRcValidityDue").val().split("-").reverse().join("-");
                    var rtoDue = $("#txtRTODue").val().split("-").reverse().join("-");
                    var pollutionDue = $("#txtPollutionDue").val().split("-").reverse().join("-");
                    var fitnessDue = $("#txtFitnessDue").val().split("-").reverse().join("-");

                    var formData = new FormData();
                    formData.append("vehicleNo", $('#txtVehicleNo').val());
                    formData.append("vehicleOwner", $("#txtVehicleOwner").val());
                    formData.append("purchaseDate", purchaseDate);
                    formData.append("mfgYear", $("#txtMfgYear").val());
                    formData.append("makeId", $("#ddlMakeMaster option:selected").val());
                    formData.append("modelId", $("#ddlModelMaster option:selected").val());
                    formData.append("noOfTyres", $("#txtNoOfTyres").val());
                    formData.append("engineNo", $("#txtEngineNo").val());
                    formData.append("chasisNo", $("#txtChasisNo").val());
                    formData.append("vehicleTypeId", $("#ddlVehicleType option:selected").val());
                    formData.append("bodyTypeId", $("#ddlBodyType option:selected").val());
                    formData.append("financerName", $("#txtFinencerName").val());
                    formData.append("bodyManufacturerId", $("#ddlManufacturerType option:selected").val());
                    formData.append("runningKm", $("#txtRunningKm").val());
                    formData.append("panNo", $("#txtPanNo").val());
                    formData.append("panNoImage", $("#txtPanNoDoc")[0].files[0]);
                    formData.append("insuranceDue", insuranceDue);
                    formData.append("insuranceDoc", $("#txtInsuranceDoc")[0].files[0]);
                    formData.append("nationalPermitDue", nationalPermitDue);
                    formData.append("nationalPermitDoc", $("#txtNationalPermitDoc")[0].files[0]);
                    formData.append("localPermitDue", localPermitDue);
                    formData.append("localPermitDoc", $("#txtLocalPermitDoc")[0].files[0]);
                    formData.append("rcValidityDue", rcValidityDue);
                    formData.append("rcDoc", $("#txtRcValidityDoc")[0].files[0]);
                    formData.append("rtoDue", rtoDue);
                    formData.append("rtoDoc", $("#txtRTODoc")[0].files[0]);
                    formData.append("pollutionDue", pollutionDue);
                    formData.append("pollutionDoc", $("#txtPollutionDoc")[0].files[0]);
                    formData.append("fitnessDue", fitnessDue);
                    formData.append("fitnessDoc", $("#txtFitnessDoc")[0].files[0]);
                    formData.append("dimension", $("#txtDimension").val());
                    formData.append("branchOffice", $("#txtBranchOffice").val());
                    formData.append("rcCapicity", $("#txtRcCapicity").val());
                    formData.append("actualCapicity", $("#txtActualCapicity").val());    
                    formData.append("isActive", true);

                    $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "VehicleMaster/Save")',
                        type: "POST",
                        dataType: "json",
                        processData: false,
                        contentType: false,
                        data: formData,
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'Save Vehicle Master!',
                                        content: "Vehicle Master has been saved successfully!",
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    //getUserList();
                                                    //clearControls();
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "VehicleMaster/Index")';
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'Vehicle Master Already Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                    $("#divVehicleMaster").hide();
                                }
                            } else {
                                console.log(data);
                                //clearControls();
                                $.confirm({
                                    title: 'Error Occoured!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divVehicleMaster").hide();
                            }
                        }
                    });
                }
            }
        }
    </script>
}