@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        var fullAccess = 'True';
        var viewAccess = 'True';

        $(document).ready(function () {
            setSideMenu("vehicle-master");
            if (fullAccess === "True" || viewAccess === "True") {
                makeFieldsReadOnly();
                var vehicleMasterID = GetParameterValues('vehicleMasterID');
                getVehicleMasterID(vehicleMasterID);
            }
        });

        function makeFieldsReadOnly() {
            $("#txtMakeMaster").prop("readonly", true);
            $("#txtModelMaster").prop("readonly", true);
            $("#txtVehicleNo").prop("readonly", true);
            $("#txtVehicleCreationDate").prop("readonly", true);
            $("#txtVehicleOwner").prop("readonly", true);
            $("#txtMfgYear").prop("readonly", true);
            $("#txtEngineNo").prop("readonly", true);
            $("#txtChasisNo").prop("readonly", true);
            $("#txtVehicleType").prop("readonly", true);
            $("#txtBodyType").prop("readonly", true);
            $("#txtNoOfTyres").prop("readonly", true);
            $("#txtFinencerName").prop("readonly", true);
            $("#txtBodyManufacturer").prop("readonly", true);
            $("#txtRunningKm").prop("readonly", true);

            $("#txtPanNo").prop("readonly", true);
            $("#txtInsuranceDue").prop("readonly", true);
            $("#txtNationalPermitDue").prop("readonly", true);
            $("#txtLocalPermitDue").prop("readonly", true);
            $("#txtRcValidityDue").prop("readonly", true);
            $("#txtRTODue").prop("readonly", true);
            $("#txtPollutionDue").prop("readonly", true);
            $("#txtFitnessDue").prop("readonly", true);

            $("#txtDimension").prop("readonly", true);
            $("#txtBranchOffice").prop("readonly", true);
            $("#txtRcCapicity").prop("readonly", true);
            $("#txtActualCapicity").prop("readonly", true);
            $("#chkIsActive").attr("disabled", true);    
        }

        function getVehicleMasterID(vehicleMasterID) {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "VehicleMaster/getVehicleMasterByID")',
                type: "GET",
                data: { vehicleMasterID: vehicleMasterID },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $("#txtMakeMaster").val(data.makeName);
                        $("#txtModelMaster").val(data.modelName);
                        $("#txtVehicleNo").val(data.vehicleNo);
                        $("#txtVehicleCreationDate").val(data.purchaseDate);
                        $("#txtVehicleOwner").val(data.vehicleOwner);
                        $("#txtMfgYear").val(data.mfgYear);
                        $("#txtEngineNo").val(data.engineNo);
                        $("#txtChasisNo").val(data.chasisNo);
                        $("#txtVehicleType").val(data.vehicleTypeName);
                        $("#txtBodyType").val(data.bodyTypeName);
                        $("#txtNoOfTyres").val(data.noOfTyres);
                        $("#txtFinencerName").val(data.financerName);
                        $("#txtBodyManufacturer").val(data.bodyManufacturerName);
                        $("#txtRunningKm").val(data.runningKm);

                        $("#txtPanNo").val(data.panNo);
                        $("#imgPanNoPhoto").attr('src', '@(utilityHelper.SiteUrl())' + data.panNoImage);
                        $("#imgPanNoPhoto").attr('data-src', '@(utilityHelper.SiteUrl())' + data.panNoImage);
                        $("#aPanNoLink").attr('href', '@(utilityHelper.SiteUrl())' + data.panNoImage);

                        $("#txtInsuranceDue").val(data.insuranceDue);
                        $("#imgInsuranceDocPhoto").attr('src', '@(utilityHelper.SiteUrl())' + data.insuranceDoc);
                        $("#imgInsuranceDocPhoto").attr('data-src', '@(utilityHelper.SiteUrl())' + data.insuranceDoc);
                        $("#aInsuracneDocLink").attr('href', '@(utilityHelper.SiteUrl())' + data.insuranceDoc);

                        $("#txtNationalPermitDue").val(data.nationalPermitDue);
                        $("#imgNationalPermitDocPhoto").attr('src', '@(utilityHelper.SiteUrl())' + data.nationalPermitDoc);
                        $("#imgNationalPermitDocPhoto").attr('data-src', '@(utilityHelper.SiteUrl())' + data.nationalPermitDoc);
                        $("#aNationalPermitDocLink").attr('href', '@(utilityHelper.SiteUrl())' + data.nationalPermitDoc);

                        $("#txtLocalPermitDue").val(data.localPermitDue);
                        $("#imageLocalPermitDocPhoto").attr('src', '@(utilityHelper.SiteUrl())' + data.localPermitDoc);
                        $("#imageLocalPermitDocPhoto").attr('data-src', '@(utilityHelper.SiteUrl())' + data.localPermitDoc);
                        $("#aLocalPermitDocLink").attr('href', '@(utilityHelper.SiteUrl())' + data.localPermitDoc);

                        $("#txtRcValidityDue").val(data.rcValidityDue);
                        $("#imageRcValidityDocPhoto").attr('src', '@(utilityHelper.SiteUrl())' + data.rcDoc);
                        $("#imageRcValidityDocPhoto").attr('data-src', '@(utilityHelper.SiteUrl())' + data.rcDoc);
                        $("#aRcValidityDocLink").attr('href', '@(utilityHelper.SiteUrl())' + data.rcDoc);

                        $("#txtRTODue").val(data.rtoDue);
                        $("#imageRTOPhoto").attr('src', '@(utilityHelper.SiteUrl())' + data.rtoDoc);
                        $("#imageRTOPhoto").attr('data-src', '@(utilityHelper.SiteUrl())' + data.rtoDoc);
                        $("#aRTODocLink").attr('href', '@(utilityHelper.SiteUrl())' + data.rtoDoc);

                        $("#txtPollutionDue").val(data.pollutionDue);
                        $("#imagePollutionPhoto").attr('src', '@(utilityHelper.SiteUrl())' + data.pollutionDoc);
                        $("#imagePollutionPhoto").attr('data-src', '@(utilityHelper.SiteUrl())' + data.pollutionDoc);
                        $("#aPollutionDocLink").attr('href', '@(utilityHelper.SiteUrl())' + data.pollutionDoc);

                        $("#txtFitnessDue").val(data.fitnessDue);
                        $("#imageFitnessPhoto").attr('src', '@(utilityHelper.SiteUrl())' + data.fitnessDoc);
                        $("#imageFitnessPhoto").attr('data-src', '@(utilityHelper.SiteUrl())' + data.fitnessDoc);
                        $("#aFitnessDocLink").attr('href', '@(utilityHelper.SiteUrl())' + data.fitnessDoc);

                        $("#txtDimension").val(data.dimension);
                        $("#txtBranchOffice").val(data.branchOffice);
                        $("#txtRcCapicity").val(data.rcCapicity);
                        $("#txtActualCapicity").val(data.actualCapicity);


                        $("#chkIsActive").prop('checked', data.isActive);
                    } else {
                        $.confirm({
                            title: 'Vehicle Master',
                            content: 'Vehicle Master does not Exists!',
                            icon: 'fa fa-warning',
