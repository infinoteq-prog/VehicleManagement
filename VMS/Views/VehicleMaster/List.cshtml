        function bindDataTable() {
            $('#tblVehicleMaster').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "Vehicle Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "Vehicle Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "Vehicle Master List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }

         function setDropDownStyle(cltr){
            if ($(cltr).find(":selected").val() == "0") {
                $(cltr).attr('class', 'form-control vaidationTextBoxError');
            } else {
                $(cltr).attr('class', 'form-control');
            }
        }

        function setTextboxStyle(cltr) {
            if ($(cltr).val() == "") {
                $(cltr).attr('class', 'form-control vaidationTextBoxError');
            } else {
                $(cltr).attr('class', 'form-control');
            }
        }

