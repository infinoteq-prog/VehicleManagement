@model VMS.ViewModel.VMExpenseMaster
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
}
@if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
{ *@
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body" style="min-height:500px;">
                    <h4 class="card-title">Expense Master Details</h4>
                    <div>
                        <form id="frmUserRole" name="frmUserRole" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtExpType">Expense Type: </label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.ExpType, new { @class = "form-control", id = "txtExpType", @maxlength = "100" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtExpCode">Expense Code:</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.ExpCode, new { @class = "form-control", id = "txtExpCode", @maxlength = "100" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtExpOther">Expense Other: </label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.ExpOther, new { @class = "form-control", id = "txtExpOther", @maxlength = "100" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtExpDescription">Expense Description: </label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.ExpDescription, new { @class = "form-control", id = "txtExpDescription", @maxlength = "200" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="chkIsActive">Is Active</label>
                                        <div class="col-sm-8">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-label checkboxStyle", id = "chkIsActive" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        var fullAccess = 'True';
        var viewAccess = 'True';

        $(document).ready(function () {
            setSideMenu("expense-master");
            if (fullAccess === "True" || viewAccess === "True") {
                makeFieldsReadOnly();
                var expenseMasterId = GetParameterValues('expenseMasterId');
                getExpenseMasterId(expenseMasterId);
            }
        });

        function makeFieldsReadOnly() {
            $("#txtExpCode").prop("readonly", true);
            $("#txtExpType").prop("readonly", true);
            $("#txtExpOther").prop("readonly", true);
            $("#txtExpDescription").prop("readonly", true);
            $("#chkIsActive").attr("disabled", true);
        }

        function getExpenseMasterId(expenseMasterId) {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "ExpenseMaster/getExpenseMasterByID")',
                type: "GET",
                data: { expenseMasterId: expenseMasterId },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $('#txtExpCode').val(data.expCode);
                        $('#txtExpType').val(data.expTypeName);
                        $('#txtExpOther').val(data.expOther);
                        $('#txtExpDescription').val(data.expDescription);
                        $("#chkIsActive").prop('checked', data.isActive);
                    } else {
                        $.confirm({
                            title: 'Expense Master',
                            content: 'Expense Master does not Exists!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}