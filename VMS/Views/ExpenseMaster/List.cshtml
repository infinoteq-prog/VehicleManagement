@model VMS.ViewModel.VMExpenseMaster
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
}
@if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
{ *@
<div class="content-wrapper">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Expense Master List</h4>
                    <div class="row rowHeight">
                        <div class="col-md-6">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="ddlExpenseMaster">Expense Type: <span class="reqFields">*</span> </label>
                                <div class="col-sm-8">
                                    <select class="form-control" id="ddlExpenseMaster" name="ddlExpenseMaster" onchange="setDropDownStyle(this);"></select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="txtExpCode">Expense Code: <span class="reqFields">*</span> </label>
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(m => m.ExpCode, new { @class = "form-control", id = "txtExpCode", @maxlength = "100" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-6">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="txtExpOther">Expense Other: </label>
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(m => m.ExpOther, new { @class = "form-control", id = "txtExpOther", @maxlength = "100" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="txtExpDescription">Expense Description: <span class="reqFields">*</span> </label>
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(m => m.ExpDescription, new { @class = "form-control", id = "txtExpDescription", @maxlength = "200" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-6">
                            <div class="form-group row" style="display:none;">
                                <label class="col-sm-4 col-form-label" for="chkIsActive">Is Active:</label>
                                <div class="col-sm-8">
                                    @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-label checkboxStyle", id = "chkIsActive" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group row">
                            </div>
                        </div>
                    </div>
                    <div class="row rowHeight" style="text-align:center;">
                        <div class="col-md-12"></div>
                    </div>
                    @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
                        { *@
                    <div class="row rowHeight" style="text-align:center;">
                        <div class="col-md-12">
                            <button type="button" class="btn btn-primary mr-2" onclick="searchExpenseMaster();">Search</button>
                            @* <button type="button" class="btn btn-primary mr-2" onclick="getMakeMasterList();">View All</button> *@
                            <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button>
                        </div>
                    </div>
                    @*  } *@
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group row">
                                <div class="col-sm-12"></div>
                            </div>
                        </div>
                    </div>
                    @* @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
                    { *@
                    <div id="divExpenseMaster">
                        <div class="table-responsive pt-3">
                            <table id="tblExpenseMaster" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th>Actions</th>
                                        <th>Expense Type</th>
                                        <th>Expense Code</th>
                                        <th>Expense Other</th>
                                        <th>Expense Description</th>
                                        <th>Is Active</th>
                                        <th>Creation Date</th>
                                        <th>Created By</th>
                                        <th>Update Date</th>
                                        <th>Updatd By</th>
                                    </tr>
                                </thead>
                                <tbody id="ExpenseMasterBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                    @* } *@
                </div>
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";

        $(document).ready(function () {
            setSideMenu("expense-master");
            getFunctionName('EXPENSE MASTER', function (userRights) {
                if (userRights) {
                    console.log("Update Access:", userRights.updateAccess);
                    console.log("Add Access:", userRights.addAccess);
                    console.log("Delete Access:", userRights.deleteAccess);
                    console.log("View Access:", userRights.viewAccess);
                    console.log("Full Access:", userRights.fullAccess);

                    fullAccess = userRights.fullAccess;
                    addAccess = userRights.addAccess;
                    viewAccess = userRights.viewAccess;
                    updateAccess = userRights.updateAccess;
                    deleteAccess = userRights.deleteAccess;
                } else {
                    console.log("Failed to get user rights.");
                }
            });
            if (fullAccess === "True" || viewAccess === "True") {
                //checkValidationOnChange();
                getExpenseMaster();
                getExpenseMasterList();
                $(function () {
                    $("#from-date-picker").datepicker({
                        dateFormat: 'dd-mm-yy'
                    });

                    $("#to-date-picker").datepicker({
                        dateFormat: 'dd-mm-yy'
                    });
                });
            }
        });

        function bindDataTable() {
            $('#tblExpenseMaster').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "Expense Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "Expense Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "Expense Master List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }

        function checkValidation() {
            var isValid = true;

            if ($('#ddlExpenseMaster option:selected').val() == "0") {
                $("#ddlExpenseMaster").attr('class', 'form-control vaidationTextBoxError');
                $("#ddlExpenseMaster").focus();
                isValid = false;
            } else {
                $("#ddlExpenseMaster").attr('class', 'form-control');
                $("#ddlExpenseMaster").focus();
            }

            if ($("#txtExpCode").val() == "") {
                $("#txtExpCode").attr('class', 'form-control vaidationTextBoxError');
                $("#txtExpCode").focus();
                isValid = false;
            } else {
                $("#txtExpCode").attr('class', 'form-control');
                $("#txtExpCode").focus();
            }

            // if ($("#txtExpOther").val() == "") {
            //     $("#txtExpOther").attr('class', 'form-control vaidationTextBoxError');
            //     $("#txtExpOther").focus();
            //     isValid = false;
            // } else {
            //     $("#txtExpOther").attr('class', 'form-control');
            //     $("#txtExpOther").focus();
            // }

            if ($("#txtExpDescription").val() == "") {
                $("#txtExpDescription").attr('class', 'form-control vaidationTextBoxError');
                $("#txtExpDescription").focus();
                isValid = false;
            } else {
                $("#txtExpDescription").attr('class', 'form-control');
                $("#txtExpDescription").focus();
            }
            return isValid;
        }

        function checkValidationOnChange() {
            $(function () {
                $("#ddlExpenseMaster").change(function () {
                    if ($('option:selected', this).val() == "0") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtExpCode").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                // $("#txtExpOther").on("input", function () {
                //     if ($(this).val() == "") {
                //         $(this).attr('class', 'form-control vaidationTextBoxError');
                //         $(this).focus();
                //     } else {
                //         $(this).attr('class', 'form-control');
                //         $(this).focus();
                //     }
                // });

                $("#txtExpDescription").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });
            });
        }

        function clearControls() {
            $("#ddlExpenseMaster").prop("selectedIndex", 0).val();
            $("#txtExpCode").val("");
            $("#txtExpOther").val("");
            $("#txtExpDescription").val("");
            $("#chkIsActive").prop("checked", false);
        }

        function searchExpenseMaster() {
            if ($.fn.DataTable.isDataTable("#tblExpenseMaster")) {
                $('#tblExpenseMaster tbody').empty();
                $('#tblExpenseMaster').DataTable().clear().destroy();
            }

            var expCode = $("#txtExpCode").val();
            var expType = $('#ddlExpenseMaster option:selected').val();
            var expOther = $("#txtExpOther").val();
            var expDescription = $("#txtExpDescription").val();
            var Expense = $("#chkIsActive").is(":checked");

            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "ExpenseMaster/searchExpenseMaster")',
                type: "GET",
                dataType: "json",
                data: {expCode : expCode, expType: expType, expOther: expOther, expDescription: expDescription, isActive: isActive},
                success: function (data) {
                    if (data != null && data != undefined) {
                        console.log(data);
                        var rows = "";
                        var row = "";
                        $.each(data, function (i, item) {
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewExpenseMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editExpenseMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteExpenseMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.expTypeName + '</td>' +
                                '<td>' + item.expCode + '</td>' +
                                '<td>' + item.expOther + '</td>' +
                                '<td>' + item.expDescription + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.creationDate + '</td>' +
                                '<td>' + item.createdByName + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updatedByName + '</td>' +
                                '</tr>';
                            rows = rows + row;
                        });
                        $("#divExpenseMaster").show();
                        $("#tblExpenseMaster").focus();
                        $("#ExpenseMasterBody").html(rows);
                        rows = "";
                        bindDataTable();
                    }
                    else {
                        console.log(data);
                        $.confirm({
                            title: 'Expense Master List',
                            content: 'Expense Master Not Found!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                        var row = '<tr>' +
                            '<td>' +
                            '<div class="d-flex align-items-center">' +
                            '</div>' +
                            '</td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td style="text-align:center">No Data Found!!!</td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '</tr>';
                        $("#ExpenseMasterBody").html(row);
                    }
                }
            });
            //}
        }

        function getExpenseMasterList() {
            if ($.fn.DataTable.isDataTable("#tblExpenseMaster")) {
                $('#tblExpenseMaster tbody').empty();
                $('#tblExpenseMaster').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "ExpenseMaster/getExpenseMasterList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        var sno = 0;
                        var rows = "";
                        var row = "";
                        $("#ExpenseMasterBody").html("");
                        $.each(data, function (i, item) {
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewExpenseMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editExpenseMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteExpenseMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.expTypeName + '</td>' +
                                '<td>' + item.expCode + '</td>' +
                                '<td>' + item.expOther + '</td>' +
                                '<td>' + item.expDescription + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.creationDate + '</td>' +
                                '<td>' + item.createdByName + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updatedByName + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            row = "";
                            $("#tblExpenseMaster").focus();
                        });
                        $("#ExpenseMasterBody").append(rows);
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="10" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#ExpenseMasterBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}