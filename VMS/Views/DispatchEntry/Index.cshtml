        function saveOrUpdateDispatch() {

            function t(val) {
                return val ? $.trim(val) : '';
            }

            // Validation function
            function validateControls() {
                let isValid = true;
                let invalidFields = []; // ✅ Collect invalid field names

                // Reset all borders first
                $('input, select').css('border', '');

                // Vehicle No
                if ($('#ddlVehicleNo').val() === '' || $('#ddlVehicleNo').val() === null) {
                    $('#ddlVehicleNo').css('border', '2px solid red');
