                    $('#ownother').css('border', '2px solid red');
                    isValid = false;
                    invalidFields.push('Own/Other Type');
                }

                // BillType
                if ($('#ddlBillType').val() === '' || $('#ddlBillType').val() === null) {
                    $('#ddlBillType').css('border', '2px solid red');
                    isValid = false;
                    invalidFields.push('Bill Type');
                }

                // LoadingDate
                if ($('#txtLoadingDate').val().trim() === '') {
                    $('#txtLoadingDate').css('border', '2px solid red');
                    isValid = false;
                    invalidFields.push('Loading Date');
                }

                // LRNo
                if ($('#txtLRNo').val().trim() === '') {
                    $('#txtLRNo').css('border', '2px solid red');
                    isValid = false;
                    invalidFields.push('LR No');
                }

                // CustomerId
                if ($('#vendorName').val() === '' || $('#vendorName').val() === null) {
                    $('#vendorName').css('border', '2px solid red');
                    isValid = false;
                    invalidFields.push('Customer');
                }

                // BillNo
                if ($('#txtBillNo').val().trim() === '') {
                    $('#txtBillNo').css('border', '2px solid red');
                    isValid = false;
                    invalidFields.push('Bill No');
                }

                // DriverId
                if ($('#ddlDriver').val() === '' || $('#ddlDriver').val() === null) {
                    $('#ddlDriver').css('border', '2px solid red');
                    isValid = false;
                    invalidFields.push('Driver');
                }

                // FromStation
                if ($('#ddlStationID').val() === '' || $('#ddlStationID').val() === null) {
                    $('#ddlStationID').css('border', '2px solid red');
                    isValid = false;
                    invalidFields.push('From Station');
                }

                // ToStation
                if ($('#ddltoStationID').val() === '' || $('#ddltoStationID').val() === null) {
                    $('#ddltoStationID').css('border', '2px solid red');
                    isValid = false;
                    invalidFields.push('To Station');
                }

                // Material
                if ($('#ddlMaterial').val() === '' || $('#ddlMaterial').val() === null) {
                    $('#ddlMaterial').css('border', '2px solid red');
                    isValid = false;
                    invalidFields.push('Material');
                }

                // LoadWeight
                if ($('#txtLoadWeight').val().trim() === '') {
                    $('#txtLoadWeight').css('border', '2px solid red');
                    isValid = false;
                    invalidFields.push('Load Weight');
                }

                // UnloadWeight
                if ($('#txtUnloadWeight').val().trim() === '') {
                    $('#txtUnloadWeight').css('border', '2px solid red');
                    isValid = false;
                    invalidFields.push('Unload Weight');
                }

                // FreightRate
                if ($('#txtFreightRate').val().trim() === '') {
                    $('#txtFreightRate').css('border', '2px solid red');
                    isValid = false;
                    invalidFields.push('Freight Rate');
                }

                // Show alert if invalid
                if (!isValid) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Validation Error',
                        html: 'Please fill all required fields:<br><b>' + invalidFields.join(', ') + '</b>'
                    });
                }

                return isValid;
            }

            // Run validation before AJAX
            if (!validateControls()) {
                return; // stop execution if invalid
            }

            // Prepare model (existing logic, no changes)
            var model = {
                ID: $('#hdnDispatchId').val() || 0,
                VehicleNo: t($('#ddlVehicleNo option:selected').text()),
                OwnOtherType: t($('#ownother option:selected').text()),
