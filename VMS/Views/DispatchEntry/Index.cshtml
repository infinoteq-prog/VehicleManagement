        function saveInlineUpdates(id) {

            var row = $('#dispatchEntryTable tbody tr').filter(function () {
                return $(this).find('.chkRow').val() == id;
            });

            var unloadWeight = row.find('.unloadWeightInput').val();
            var freightRate = row.find('.freightRateInput').val();
            var loadWeight = parseFloat(row.find('td').eq(9).text()) || 0;
            var totalFreight = parseFloat(freightRate || 0) * loadWeight;

            var model = {
                ID: id,
                UnloadWeight: unloadWeight,
                FreightRate: freightRate,
                TotalFreight: totalFreight,   
                IsInlineUpdate: true
            };

            $.ajax({
                url: '/DispatchEntry/SaveOrUpdateDispatch',
                type: 'POST',
                data: model,
                success: function (res) {
                    if (res.success) {

                        // Replace inputs with text again
                        row.find('td').eq(7).text(unloadWeight);
                        row.find('td').eq(8).text(freightRate);
                        row.find('td').eq(10).text(totalFreight.toFixed(2)); // ✅ update Total Frt

                        Swal.fire({
                            icon: 'success',
                            title: 'Updated!',
                            confirmButtonColor: '#2ecc71'
                        });
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert('Inline update failed');
                }
            });
        }

        function saveInlineUpdate(id) {

            var row = $('#dispatchEntryTable tbody tr').filter(function () {
                return $(this).find('.chkRow').val() == id;
            });

            var unloadWeight = parseFloat(row.find('.unloadWeightInput').val()) || 0;
            var freightRate = parseFloat(row.find('.freightRateInput').val()) || 0;
            var loadWeight = parseFloat(row.find('td').eq(9).text()) || 0;

            var shortage = loadWeight - unloadWeight;
            if (shortage < 0) shortage = 0;
            var totalFreight = freightRate * loadWeight;
            var deduction = parseFloat($('#txtDeduction').val()) || 0;
            var freightForTally = totalFreight - deduction;
            if (freightForTally < 0) freightForTally = 0;

            var model = {
                ID: id,
                UnloadWeight: unloadWeight,
                FreightRate: freightRate,
                Shortage: shortage,
                TotalFreight: totalFreight,
                Deduction: deduction,               
                FreightForTally: freightForTally,   
                IsInlineUpdate: true
            };

            $.ajax({
                url: '/DispatchEntry/SaveOrUpdateDispatch',
                type: 'POST',
                data: model,
                success: function (res) {
                    if (res.success) {

                        // ✅ GRID UPDATE (NO FreightForTally COLUMN SHOWN)
                        row.find('td').eq(7).text(unloadWeight);
                        row.find('td').eq(8).text(freightRate);
                        row.find('td').eq(10).text(totalFreight.toFixed(2));

                        Swal.fire({
                            icon: 'success',
                            title: 'Updated!',
                            confirmButtonColor: '#2ecc71'
                        });
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert('Inline update failed');
                }
            });
        }

