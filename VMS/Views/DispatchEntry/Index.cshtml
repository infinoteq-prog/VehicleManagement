        function editDispatchEntry(button, id) {
            var isChecked = $('#dispatchEntryTable .chkRow[value="' + id + '"]').is(':checked');

            if (isChecked) {
                loadFullEditForm(id);   // full form edit
            }
            else {
                var row = $('#dispatchEntryTable tbody tr').filter(function () {
                    return $(this).find('.chkRow').val() == id;
                });

                if (button.textContent === "Edit") {
                    // --- Enable inline editing ---
                    var unloadCell = row.find('td').eq(7);   // UnloadWeight
                    var freightCell = row.find('td').eq(8);  // FreightRate

                    var unloadVal = unloadCell.text().trim();
                    var freightVal = freightCell.text().trim();

                    unloadCell.html(`<input type="text" class="form-control unloadWeightInput" value="${unloadVal}" />`);
                    freightCell.html(`<input type="text" class="form-control freightRateInput" value="${freightVal}" />`);

                    button.textContent = "Update";
                    button.classList.remove("btn-success");
                    button.classList.add("btn-primary");
                }
                else if (button.textContent === "Update") {         
                    // --- Save inline update ---
                    saveInlineUpdate(id);

                    // Reset button back to Edit
                    button.textContent = "Edit";
                    button.classList.remove("btn-primary");
                    button.classList.add("btn-success");
                }
            }
        }

