@model VMS.ViewModel.VMDispatchEntry
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Dispatch Entry";
}
<style>
    html {
        font-size: 16px;
    }

    input.form-control,
    select.form-control {
        height: 2.375rem;
        font-size: 0.8125rem;
        line-height: 1.2;
        padding: 0.375rem 0.75rem;
    }

    .form-group {
        margin-bottom: 14px;
    }

        .form-group label {
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 4px;
            display: block;
        }

    .reqFields {
        color: red;
        font-weight: bold;
    }

    .rowHeight {
        margin-bottom: 10px;
    }
    table.dataTable thead th {
        background-color: #6c2eb9;
        color: #fff;
        text-align: center;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    /* Enable vertical scrolling area */
    .dataTables_scrollBody {
        max-height: 350px !important;
        overflow-y: auto !important;
    }
    /* Enable horizontal scroll */
    .dataTables_scroll {
        overflow-x: auto;
    }

    .dataTables_wrapper .dt-buttons {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 0px;
    }

    .dataTables_filter {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Prevent column squeeze */
    table.dataTable {
        white-space: nowrap;
    }

    .select2-container--default .select2-selection--single {
        height: 38px !important;
        padding: 4px 8px !important;
        display: flex !important;
        align-items: center !important; /* TEXT CENTER vertically */
    }

        /* Fix selected text position */
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: normal !important;
            padding-left: 6px !important;
            padding-right: 20px !important;
        }

        /* Fix dropdown arrow alignment */
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px !important;
            top: 1px !important;
        }

        /* Fix placeholder color */
        .select2-container--default .select2-selection--single .select2-selection__placeholder {
            color: #6c757d !important;
        }

    .custom-swal-popup .swal2-title {
        font-size: 22px;
        font-weight: 600;
    }
</style>

<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Dispatch Entry</h4>
                    <div>
                        <div class="row rowHeight">
                            <div class="col-md-6">
                                <label class="reqFields">
                                    Note: All fields marked with * are mandatory fields
                                </label>
                            </div>
                        </div>

                        <!-- ROW 1 -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Vehicle No <span class="reqFields">*</span></label>
                                    <select class="form-control" id="ddlVehicleNo" name="ddlVehicleNo"></select>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Customer Name</label>
                                    <select class="form-control" id="vendorName" name="VendorID"></select>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Loading Date</label>
                                    <input type="date" class="form-control" id="txtLoadingDate">
                                </div>
                            </div>
                        </div>

                        <!-- ROW 2 -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>LR No <span class="reqFields">*</span></label>
                                    @Html.TextBoxFor(m => m.LRNo, new { @class = "form-control", id = "txtLRNo", placeholder = "Enter LR No" })
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Own / Other</label>
                                    <select class="form-control" id="ownother"></select>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Bill Type</label>
                                    <select class="form-control" id="ddlBillType"></select>
                                </div>
                            </div>
                        </div>

                        <!-- ROW 3 -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Bill No</label>
                                    @Html.TextBoxFor(m => m.BillNo, new { @class = "form-control", id = "txtBillNo", placeholder = "Auto Generated" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Driver Name</label>
                                    <select class="form-control" id="ddlDriver"></select>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Station From</label>
                                    <select class="form-control" id="ddlStationID"></select>
                                </div>
                            </div>
                        </div>

                        <!-- ROW 4 -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>To Station</label>
                                    <select class="form-control" id="ddltoStationID"></select>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Material</label>
                                    <select class="form-control" id="ddlMaterial"></select>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Load Weight</label>
                                    @Html.TextBoxFor(m => m.LoadWeight, new { @class = "form-control", id = "txtLoadWeight", placeholder = "Enter Load Weight" })
                                </div>
                            </div>
                        </div>

                        <!-- ROW 5 -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Unload Weight</label>
                                    @Html.TextBoxFor(m => m.UnloadWeight, new { @class = "form-control", id = "txtUnloadWeight" })
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Shortage</label>
                                    @Html.TextBoxFor(m => m.Shortage, new { @class = "form-control", id = "txtShortage" })
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Freight Rate</label>
                                    @Html.TextBoxFor(m => m.FreightRate, new { @class = "form-control", id = "txtFreightRate" })
                                </div>
                            </div>
                        </div>

                        <!-- ROW 6 -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Total Freight</label>
                                    @Html.TextBoxFor(m => m.TotalFreight, new { @class = "form-control", id = "txtTotalFreight", @readonly = "readonly" })
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Deduction</label>
                                    @Html.TextBoxFor(m => m.Deduction, new { @class = "form-control", id = "txtDeduction" })
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Freight For Tally</label>
                                    @Html.TextBoxFor(m => m.FreightForTally, new { @class = "form-control", id = "txtFreightForTally", @readonly = "readonly" })
                                </div>
                            </div>
                        </div>
                        <!-- ROW 7 -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Remarks</label>
                                    @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control", id = "txtRemarks" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Invoice No</label>
                                    @Html.TextBoxFor(m => m.InvoiceNo, new { @class = "form-control", id = "txtInvoiceNo" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Shipment No</label>
                                    @Html.TextBoxFor(m => m.ShipmentNo, new { @class = "form-control", id = "txtShipmentNo" })
                                </div>
                            </div>
                        </div>
                        <!-- ROW 8 -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Delivery No</label>
                                    @Html.TextBoxFor(m => m.DeliveryNo, new { @class = "form-control", id = "txtDeliveryNo" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Trade/NT</label>
                                    @Html.TextBoxFor(m => m.TradeNT, new { @class = "form-control", id = "txtTradeNT" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Other1 </label>
                                    @Html.TextBoxFor(m => m.Other1, new { @class = "form-control", id = "txtOther1" })
                                </div>
                            </div>
                        </div>
                        <!-- ROW 9 -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Other2 </label>
                                    @Html.TextBoxFor(m => m.Other2, new { @class = "form-control", id = "txtOther2" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row rowHeight" style="text-align:center;">
                        <div class="col-md-12">
                            <button type="button" class="btn btn-primary mr-2" onclick="saveOrUpdateDispatch(false)">Save </button>
                            <button type="button" class="btn btn-primary mr-2" onclick="saveOrUpdateDispatch(true)">Update</button>
                            <button type="button" class="btn btn-light" onclick="clearDispatchForm();">Clear</button>
                        </div>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                </div>

                <div class="card" style="padding: 14px; margin-bottom: 19px; border: 1px solid #ccc; border-radius: 5px;">
                    <form id="searchDieselHisabForm">
                        <div class="row">
                            <div class="col-md-3">

                                <div class="form-group">
                                    <label for="ddlVehicleNos">Vehicle No</label>
                                    <select class="form-control" id="ddlVehicleNos" name="ddlVehicleNos"></select>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="txtStartDate">Start Date</label>
                                    <input type="date" class="form-control" id="txtStartDate" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="txtEndDate">End Date</label>
                                    <input type="date" class="form-control" id="txtEndDate" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="vendorNamedeatail">Customer Name</label>
                                    <select class="form-control" id="vendorNamedeatail" name="VendorIDs"></select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="ddlMaterials">Material</label>
                                    <select class="form-control" id="ddlMaterials" name="ddlMaterials"></select>

                                </div>
                            </div>


                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="txtState">State</label>
                                    <select class="form-control" id="ddlState" name="ddlState" onchange="setDropDownStyle(this);"></select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="txtDistrict">District</label>
                                    <select class="form-control" id="ddlDistrict" name="ddlDistrict" onchange="setDropDownStyle(this);"></select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="txtStation">Station</label>
                                    <select class="form-control" id="ddlStations"></select>

                                </div>
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-primary mt-4" onclick="getDispatchEntryByDate()">Search</button>
                            </div>
                        </div>
                        <input type="hidden" id="hdnDispatchId" value="" />
                    </form>
                </div>
                <h4 class="mt-4">All Dispatch Entries</h4>
                <table id="dispatchEntryTable" class="display nowrap table table-bordered" style="width:100%">
                    <thead>
                        <tr>
                            <th style="width:2%">
                                <input type="checkbox" id="chkAll" />
                            </th>
                            <th style="width:4%">LR No</th>
                            <th style="width:4%">Loading Date</th>
                            <th style="width:7%">Vehicle No</th>
                            <th style="width:7%">Material</th>
                            <th style="width:9%">From</th>
                            <th style="width:9%">To</th>
                            <th style="width:7%">Unload Wt.</th>
                            <th style="width:7%">Frt. Rate</th>
                            <th style="width:7%">Load Weight</th>
                            <th style="width:7%">Total Frt</th>
                            <th style="width:7%">Action</th>
                        </tr>
                    </thead>
                    <tbody id="modeldispatchEntry">
                    </tbody>
                </table>
            </div>


        </div>
    </div>
</div>
@section scripts {
