        function calculateTotalFreight() {

            var loadWeight = parseFloat($('#txtLoadWeight').val()) || 0;
            var freightRate = parseFloat($('#txtFreightRate').val()) || 0;

            var totalFreight = loadWeight * freightRate;

            $('#txtTotalFreight').val(totalFreight.toFixed(2)); // 2 decimal
        }
        function calculateFreightForTally() {

            var totalFreight = parseFloat($('#txtTotalFreight').val()) || 0;
            var deduction = parseFloat($('#txtDeduction').val()) || 0;

            var freightForTally = totalFreight - deduction;

            // Prevent negative values
            if (freightForTally < 0) {
                freightForTally = 0;
            }

            $('#txtFreightForTally').val(freightForTally.toFixed(2));
        }
