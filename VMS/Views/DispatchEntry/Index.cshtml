                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Server Error',
                        text: 'Please try again later'
                    });
                }
            });
        }
        function getDispatchEntryByDate() {

            var startDate = $('#txtStartDate').val();
            var endDate = $('#txtEndDate').val();
            var vehicleNoText = $('#ddlVehicleNos option:selected').text().trim();
            var materialText = $('#ddlMaterials option:selected').text().trim();
            var stationText = $('#ddlStations option:selected').text().trim();
            var customerIdtext = $('#vendorNamedeatail').val();
            var stateText = $('#ddlState option:selected').text().trim();
            var districtText = $('#ddlDistrict option:selected').text().trim();

            var material = materialText === "-- Select Material Type --" ? null : materialText;
            var vehicleNo = vehicleNoText === "Select a Vehicle" ? null : vehicleNoText;
            var customerId = customerIdtext === "-- Select Customer Name --" ? null : customerIdtext;
            var station = stationText === "-- Select from Station --" ? null : stationText;
            var state = stateText === "Select a State" ? null : stateText;
            var district = districtText === "Select a State" ? null : districtText;

            $.ajax({
                url: '@(utilityHelper.SiteUrl() + "DispatchEntry/GetDispatchByDateRange")',
                type: "GET",
                data: {
                    vehicleno: vehicleNo,
                    material: material,
                    customerId: customerId,
                    startDate: startDate,
                    endDate: endDate,
                    station: station,
                    state: state,
                    district: district
                },
                dataType: "json",
                success: function (data) {

                    dispatchTable.clear();

                    if (data && data.length > 0) {
                        $.each(data, function (i, item) {

                            dispatchTable.row.add([
                                '<input type="checkbox" class="chkRow" value="' + item.id + '" />',
                                item.lrNo,
                                item.loadingDate ?? '',
                                item.vehicleNo,
                                item.material,
                                item.fromStation,
                                item.toStation,
                                item.unloadWeight,
                                item.freightRate,
                                item.loadWeight,
                                item.totalFreight,
                                `
                                                                        <button type="button" class="btn btn-success btn-sm"
                                                                                        onclick="editDispatchEntry(this,'${item.id}')">Edit</button>

                                                                        <button type="button" class="btn btn-danger btn-sm ms-1"
                                                                                onclick="deleteDispatchEntry('${item.id}')">Delete</button>
                                                                        `
                            ]);
                        });
                    }

                    dispatchTable.draw();
                },
                error: function () {
                    alert("Error loading data");
                }
            });
        }

