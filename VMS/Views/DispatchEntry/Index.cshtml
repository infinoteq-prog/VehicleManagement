    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var dispatchTable;

        $(document).ready(function () {
            $('#ddlVehicleNo').select2();
            $('#ddlVehicleNos').select2();
            $('#ddlDriver').select2();
            $('#ddlStationID').select2();
            $('#ddltoStationID').select2();
            $("#vendorName").select2();
            $("#vendorNamedeatail").select2();
            $("#ddlMaterial").select2();
            $("#ddlBillType").select2();
            $("#ddlStations").select2();
            getVehicleNumber();
            getDriverMaster();
            loadCustomers();
            getVehicleNumberList();
            getStateByCountryId(1);
            setCurrentLoadingDate();
            loadFromStationDropdown();
            loadToStationDropdown();
            loadBillTypeDropdown();
            loadMaterailTypeDropdown();
            loadFilterStationDropdown();
            getDispatchEntryByDate();
            loadNextBillNo();

            $('#txtLoadWeight, #txtUnloadWeight').on('keyup change', function () {

                var loadWeight = parseFloat($('#txtLoadWeight').val()) || 0;
                var unloadWeight = parseFloat($('#txtUnloadWeight').val()) || 0;

                var shortage = loadWeight - unloadWeight;

                $('#txtShortage').val(shortage >= 0 ? shortage.toFixed(2) : 0);
            });

            $('#txtLoadWeight, #txtFreightRate').on('input', function () {
                calculateTotalFreight();
            });

            $('#txtDeduction').on('input', function () {
                calculateFreightForTally();
            });
            dispatchTable = $('#dispatchEntryTable').DataTable({
                deferRender: true,
                scrollY: '350px',
                scrollX: true,
                scrollCollapse: true,
                paging: true,
                searching: true,
                info: true,
                ordering: false,
                dom: 'Bfrtip',

                buttons: [
                    {
                        extend: 'excelHtml5',
                        title: 'Dispatch Entry List',
                        text: 'Download'
                    },
                    {
                        extend: 'pdfHtml5',
                        title: 'Dispatch Entry List',
                        text: 'PDF',
                        orientation: 'landscape',
                        pageSize: 'A4'
                    },

                    // {
                    //     text: 'Print',
                    //     action: function (e, dt, node, config) {
                    //         window.location.href = '/DispatchEntry/ViewBillDetails';
                    //     },
                    //     className: 'btn-print-custom'
                    // }
                    {
                        text: 'Print',
                        action: function () {
                            window.open('/DispatchEntry/ViewBillDetails', '_blank');
                        }
                    }
                ]
            });


            // dispatchTable = $('#dispatchEntryTable').DataTable({

            //     deferRender: true,

            //     scrollY: '350px',
            //     scrollX: true,
            //     scrollCollapse: true,

            //     paging: true,
            //     searching: true,
            //     info: true,
            //     ordering: false,

            //     dom: 'Bfrtip',

            //     buttons: [
            //         {
            //             extend: 'excelHtml5',
            //             title: 'Dispatch Entry List',
            //             text: 'Download'
            //         },
            //         {
            //             extend: 'pdfHtml5',
            //             title: 'Dispatch Entry List',
            //             text: 'PDF',
            //             orientation: 'landscape',
            //             pageSize: 'A4'
            //         },
            //         {
            //             extend: 'print',
            //             text: 'Print',
            //             title: 'Dispatch Entry List',
            //             orientation: 'landscape',
            //             pageSize: 'A4'
            //         }
            //     ]
            // });
        });



        /* ================= LOAD VEHICLE ================= */
        function getVehicleNumberList() {
            $.ajax({
                url: '@(utilityHelper.SiteUrl() + "VehicleMaster/getVehicleMaster")',
                type: "GET",
                dataType: "json",
                success: function (data) {

                    var $ddl = $("#ddlVehicleNos");
                    $ddl.empty();
                    $ddl.append('<option></option>');

                    $.each(data || [], function (i, v) {
                        $ddl.append(
                            `<option value="${v.vehicleId}">${v.vehicleName}</option>`
                        );
                    });
                    if ($ddl.hasClass("select2-hidden-accessible")) {
                        $ddl.select2('destroy');
                    }

                    $ddl.select2({
                        placeholder: "Select a Vehicle",
                        allowClear: true,
                        width: '100%'
                    });
                }
            });
        }
        function loadCustomers() {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DispatchEntry/GetCustomerNameList")',
                type: "GET",
                dataType: "json",
                success: function (data) {

                    var defaultOpt = '<option value="">-- Select Customer Name --</option>';

                    // Upper dropdown
                    $("#vendorName").html(defaultOpt);

                    // Lower dropdown
                    $("#vendorNamedeatail").html(defaultOpt);

                    if (data && data.length > 0) {
                        for (var i = 0; i < data.length; i++) {
                            var opt = `<option value="${data[i].vendorID}">
                                                                                   ${data[i].vendorName}
                                                                               </option>`;
                            $("#vendorName").append(opt);
                            $("#vendorNamedeatail").append(opt);
                        }
                    }


                    $("#vendorName").select2({
                        placeholder: "-- Select Customer Name --",
                        allowClear: true,
                        width: '100%'
                    });

                    $("#vendorNamedeatail").select2({
                        placeholder: "-- Select Customer Name --",
                        allowClear: true,
                        width: '100%'
                    });

                    $("#vendorName").trigger('change');
                    $("#vendorNamedeatail").trigger('change');
                },
                error: function () {
                    alert('Error loading customer list.');
                }
            });
        }
        function setCurrentLoadingDate() {
            var today = new Date();

            var day = String(today.getDate()).padStart(2, '0');
            var month = String(today.getMonth() + 1).padStart(2, '0');
            var year = today.getFullYear();

            var currentDate = year + '-' + month + '-' + day;

            $('#txtLoadingDate').val(currentDate);
        }
        function loadFromStationDropdown() {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DispatchEntry/GetStationDropdown")',
                type: "GET",
                dataType: "json",
                success: function (data) {

                    var s = '<option value="">-- Select from Station --</option>';

                    if (data && data.length > 0) {
                        for (var i = 0; i < data.length; i++) {
                            s += `<option value="${data[i].cityId}">
                                                     ${data[i].cityName}
                                                    </option>`;
                        }
                    }

                    $("#ddlStationID").html(s);
                    $("#ddlStationID").select2({
                        placeholder: "-- Select from Station --",
                        allowClear: true,
                        width: '100%'
                    });

                    $("#ddlStationID").trigger('change');
                },
                error: function () {
                    alert('Error loading from station list.');
                }
            });
        }
