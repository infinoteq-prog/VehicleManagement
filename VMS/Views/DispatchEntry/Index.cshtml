        function deleteDispatchEntry(id) {
            Swal.fire({
                title: 'Delete Dispatch!',
                text: 'Are you sure you want to delete this dispatch record?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#e74c3c', // red
                cancelButtonColor: '#95a5a6'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/DispatchEntry/DeleteDispatch',
                        type: 'POST',
                        data: { id: id },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: res.message || 'Dispatch deleted successfully.',
                                    confirmButtonColor: '#2ecc71'
                                }).then(() => {
                                    getDispatchEntryByDate(); // reload grid
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Delete Failed',
                                    text: res.message || 'Unable to delete record.'
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Server Error',
                                text: 'Please try again later.'
                            });
                        }
                    });
                }
            });
        }


        function normalizeText(text) {
            if (!text) return '';
            return text
                .replace(/\u00A0/g, ' ')
                .replace(/\s+/g, ' ')
                .trim();
        }

        $.fn.select2.defaults.defaults.matcher = function (params, data) {

            if ($.trim(params.term) === '') {
                return data;
            }

            if (!data.text) {
                return null;
            }

            var searchText = normalizeText(params.term).toLowerCase();
            var optionText = normalizeText(data.text).toLowerCase();

            if (optionText.indexOf(searchText) > -1) {
                return data;
            }

            return null;
        };

