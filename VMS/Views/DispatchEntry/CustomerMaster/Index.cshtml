@model List<VMS.ViewModel.VendorViewModel>
@{
    ViewData["Title"] = "Vendor / Bill To List";
}
<style>
    .btn-purple {
        background-color: #7d4ac1;
        color: white;
        border: none;
    }

        .btn-purple:hover {
            background-color: #5e3aa0;
        }

    table.dataTable thead th {
        background-color: #6c2eb9;
        color: white;
        text-align: center;
    }

    .content-container {
        background-color: white;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        margin-bottom: 30px;
    }
</style>

<div class="container">
    <div class="content-container">
        <h4 class="mb-4">Vendor / Bill Details</h4>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <table id="vendorTable" class="display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>Actions</th>
                    <th>Vendor Code</th>
                    <th>Vendor Type</th>
                    <th>Vendor Name</th>
                    <th>Address 1</th>
                    <th>Address 2</th>
                    <th>Address 3</th>
                    <th>City</th>
                    <th>District</th>
                    <th>State</th>
                    <th>Pin</th>
                    <th>GSTIN</th>
                    <th>PAN</th>
                    <th>LR No Prefix</th>
                    <th>LR No Start</th>
                    <th>Contact Person</th>
                    <th>Mobile No</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.VendorID" class="btn btn-sm btn-success">Edit</a>
                            <a href="javascript:void(0);" class="btn btn-sm btn-danger" onclick="confirmDelete(@item.VendorID)">Delete</a>
                        </td>
                        <td>@item.VendorCode</td>
                        <td>@item.VendorType</td>
                        <td>@item.VendorName</td>
                        <td>@item.Address1</td>
                        <td>@item.Address2</td>
                        <td>@item.Address3</td>
                        <td>@item.City</td>
                        <td>@item.District</td>
                        <td>@item.State</td>
                        <td>@item.Pin</td>
                        <td>@item.GSTIN</td>
                        <td>@item.PAN</td>
                        <td>@item.LRNoPrefix</td>
                        <td>@item.LRNoStart</td>
                        <td>@item.ContactPerson</td>
                        <td>@item.ContactMobileNo</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 🔒 Hidden Delete Form -->
<form id="deleteForm" method="post" asp-controller="VendorBill" asp-action="Delete">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteId" />
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(document).ready(function () {
            $('#vendorTable').DataTable({
                dom: 'Bfrtip',
                buttons: ['copy', 'excel', 'pdf', 'print'],
                scrollX: true,                 // ✅ Horizontal scroll only
                paging: true,                  // ✅ Enable pagination
                pageLength: 5,                // ✅ Show 10 rows per page by default
                lengthMenu: [10, 25, 50, 100], // ✅ User can select rows per page
                responsive: true,
            });
        });

        function confirmDelete(id) {
            if (confirm("Are you sure you want to delete this vendor?")) {
                $('#deleteId').val(id);
                $('#deleteForm').submit();
            }
        }
    </script>

    <script>
        $(document).ready(function () {
            setSideMenu("VendorBillMasterCollapse");
        });
    </script>
}
