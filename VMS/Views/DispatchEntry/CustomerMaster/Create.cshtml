@model VMS.ViewModel.VendorViewModel
@{
    ViewData["Title"] = "Create Vendor";
}
<style>
    .select2-container {
        width: 100% !important;
    }
</style>
<div class="container" style="margin-bottom:20px">
    <div class="bg-white p-4 rounded shadow-sm border">
        <h4 class="card-title mb-4">Create Vendor / Bill To Master</h4>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            </div>
        }

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row mb-3">
                <label class="col-sm-12 text-danger fw-bold">Fields marked with <span class="text-danger">*</span> are mandatory.</label>
            </div>

            <!-- Vendor Code -->
            <div class="row mb-3">
                <div class="col-md-6 d-flex">
                    <label asp-for="VendorCode" class="col-form-label col-4">Vendor Code <span class="text-danger">*</span></label>
                    <div class="col-8">
                        <input asp-for="VendorCode" class="form-control" />
                        <span asp-validation-for="VendorCode" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6 d-flex">
                    <label asp-for="VendorType" class="col-form-label col-4">Vendor Type <span class="text-danger">*</span></label>
                    <div class="col-8">
                        <select asp-for="VendorType" class="form-control">
                            <option value="">-- Select Vendor Type --</option>
                            <option value="Own Vendors">Own Vendors</option>
                            <option value="Market Vendors">Market Vendors</option>
                        </select>
                        <span asp-validation-for="VendorType" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Vendor Name -->
            <div class="row mb-3">
                <div class="col-md-6 d-flex">
                    <label asp-for="VendorName" class="col-form-label col-4">Vendor Name <span class="text-danger">*</span></label>
                    <div class="col-8">
                        <input asp-for="VendorName" class="form-control" />
                        <span asp-validation-for="VendorName" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6 d-flex">
                    <label asp-for="Address1" class="col-form-label col-4">Address 1 <span class="text-danger">*</span></label>
                    <div class="col-8">
                        <input asp-for="Address1" class="form-control" />
                        <span asp-validation-for="Address1" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Address 2 & 3 -->
            <div class="row mb-3">
                <div class="col-md-6 d-flex">
                    <label asp-for="Address2" class="col-form-label col-4">Address 2</label>
                    <div class="col-8">
                        <input asp-for="Address2" class="form-control" />
                        <span asp-validation-for="Address2" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6 d-flex">
                    <label asp-for="Address3" class="col-form-label col-4">Address 3</label>
                    <div class="col-8">
                        <input asp-for="Address3" class="form-control" />
                        <span asp-validation-for="Address3" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- City / District -->
            <div class="row mb-3">
                <div class="col-md-6 d-flex">
                    <label asp-for="City" class="col-form-label col-4">City <span class="text-danger">*</span></label>
                    <div class="col-8">
                        <select asp-for="City" class="form-control" id="ddlCity">
                        </select> <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6 d-flex">
                    <label asp-for="District" class="col-form-label col-4">District <span class="text-danger">*</span></label>
                    <div class="col-8">
                        <select asp-for="District" class="form-control" id="ddlDistrict">
                        </select>
                        <span asp-validation-for="District" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- State / Pin -->
            <div class="row mb-3">
                <div class="col-md-6 d-flex">
                    <label asp-for="State" class="col-form-label col-4">State <span class="text-danger">*</span></label>
                    <div class="col-8">
                        <select asp-for="State" class="form-control" id="ddlState">
                        </select>
                        <span asp-validation-for="State" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6 d-flex">
                    <label asp-for="Pin" class="col-form-label col-4">Pin </label>
                    <div class="col-8">
                        <input asp-for="Pin" class="form-control" />
                        <span asp-validation-for="Pin" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- GSTIN / PAN -->
            <div class="row mb-3">
                <div class="col-md-6 d-flex">
                    <label asp-for="GSTIN" class="col-form-label col-4">GSTIN No</label>
                    <div class="col-8">
                        <input asp-for="GSTIN" class="form-control" />
                        <span asp-validation-for="GSTIN" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6 d-flex">
                    <label asp-for="PAN" class="col-form-label col-4"></label>
                    <div class="col-8">
                        <input asp-for="PAN" class="form-control" />
                        <span asp-validation-for="PAN" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- LR Prefix / Start -->
            <div class="row mb-3" style="display:none">
                <div class="col-md-6 d-flex" style="display:none">
                    <label asp-for="LRNoPrefix" class="col-form-label col-4">LR No Prefix</label>
                    <div class="col-8">
                        <input asp-for="LRNoPrefix" class="form-control" />
                        <span asp-validation-for="LRNoPrefix" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6 d-flex" style="display:none">
                    <label asp-for="LRNoStart" class="col-form-label col-4">LR No Start</label>
                    <div class="col-8">
                        <input asp-for="LRNoStart" class="form-control" />
                        <span asp-validation-for="LRNoStart" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Contact Info -->
            <div class="row mb-3">
                <div class="col-md-6 d-flex">
                    <label asp-for="ContactPerson" class="col-form-label col-4">Contact Person </label>
                    <div class="col-8">
                        <input asp-for="ContactPerson" class="form-control" />
                        <span asp-validation-for="ContactPerson" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6 d-flex">
                    <label asp-for="ContactMobileNo" class="col-form-label col-4">Contact Mobile </label>
                    <div class="col-8">
                        <input asp-for="ContactMobileNo" class="form-control" />
                        <span asp-validation-for="ContactMobileNo" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Submit Buttons -->
            <div class="row mt-4">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary me-2">Save</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="button" class="btn btn-primary me-2" onclick="redirectToList()">Show</button>
                </div>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            initializeSelect2();
            loadCityDropdown();
            setupDropdownEvents();
            setupFormSubmit();

            setSideMenu("VendorBillMasterCollapse");
        });

        function initializeSelect2() {
            $('#ddlCity').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Select City --',
                allowClear: true,
                width: '100%'
            });

            $('#ddlDistrict').select2({
                theme: 'bootstrap-5',
               // placeholder: '-- Select District --',
                allowClear: true,
                width: '100%'
            });

            $('#ddlState').select2({
                theme: 'bootstrap-5',
              //  placeholder: '-- Select State --',
                allowClear: true,
                width: '100%'
            });
        }

        function loadCityDropdown() {
            $.ajax({
                url: '/VendorBill/GetCities',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    var $ddlCity = $('#ddlCity');
                    $ddlCity.empty();
                    $ddlCity.append($('<option>', {
                        value: '',
                        text: '-- Select City --'
                    }));

                    if (data && data.length > 0) {
                        $.each(data, function (i, item) {
                            $ddlCity.append($('<option>', {
                                value: item.cityName,
                                text: item.cityName
                            }));
                        });
                    }
                    $ddlCity.trigger('change.select2');
                },
                error: function (xhr, status, error) {
                    console.error('Error loading city list:', error);
                    alert('Error loading city list. Please try again.');
                }
            });
        }

        function setupDropdownEvents() {
           
            $('#ddlCity').on('change', function () {
                var cityName = $(this).val();
                $('#ddlDistrict').empty().append(
                    $('<option>', {
                        value: '',
                        text: '-- Select District --'
                    })
                ).val('').trigger('change.select2');
                $('#ddlState').empty().append(
                    $('<option>', {
                        value: '',
                        text: '-- Select State --'
                    })
                ).val('').trigger('change.select2');

                if (cityName) {
                    loadDistrictsByCity(cityName);
                }
            });

           
            $('#ddlDistrict').on('change', function () {
                var districtName = $(this).val();
               
                $('#ddlState').empty().append(
                    $('<option>', {
                        value: '',
                        text: '-- Select State --'
                    })
                ).val('').trigger('change.select2');
                if (districtName) {
                    loadStatesByDistrict(districtName);
                }
            });
        }

        function loadDistrictsByCity(cityName) {
            $.ajax({
                url: '/VendorBill/GetDistrictsByCity',
                type: 'GET',
                data: { cityName: cityName },
                success: function (data) {
                    var $ddlDistrict = $('#ddlDistrict');
                    $ddlDistrict.empty();
                    $ddlDistrict.append($('<option>', {
                        value: '',
                        text: '-- Select District --'
                    }));

                    if (data && data.length > 0) {
                        $.each(data, function (i, item) {
                            $ddlDistrict.append($('<option>', {
                                value: item.districtName,
                                text: item.districtName
                            }));
                        });
                    }

                    $ddlDistrict.trigger('change.select2');
                },
                error: function (xhr, status, error) {
                    console.error('Error loading districts:', error);
                }
            });
        }

        function loadStatesByDistrict(districtName) {
            $.ajax({
                url: '/VendorBill/GetStateByDistrict',
                type: 'GET',
                data: { districtName: districtName },
                success: function (data) {
                    var $ddlState = $('#ddlState');
                    $ddlState.empty(); 

                    if (data && data.length > 0) {
                        $.each(data, function (i, item) {
                            $ddlState.append($('<option>', {
                                value: item.stateName,
                                text: item.stateName
                            }));
                        });
                    } else {
                        $ddlState.append($('<option>', {
                            value: '',
                            text: 'No states available'
                        }));
                    }

                    $ddlState.trigger('change.select2');
                },
                error: function (xhr, status, error) {
                    console.error('Error loading states:', error);
                    var $ddlState = $('#ddlState');
                    $ddlState.empty();
                    $ddlState.append($('<option>', {
                        value: '',
                        text: 'Error loading states'
                    }));
                    $ddlState.trigger('change.select2');
                }
            });
        }

        function setupFormSubmit() {
            $('#vendorForm').on('submit', function (e) {
                $('#ddlCity, #ddlDistrict, #ddlState').each(function () {
                    var $select = $(this);
                    var select2Instance = $select.data('select2');
                    if (select2Instance) {
                        $select.val(select2Instance.val()).trigger('change');
                    }
                });

                var validator = $(this).validate();
                if (!validator.checkForm()) {
                    e.preventDefault();
                    validator.focusInvalid();

                    console.log('Validation errors:', validator.errorList);
                    return false;
                }
                return true;
            });
        }

        function redirectToList() {
            window.location.href = '/VendorBill/Index';
        }
    </script>
}
