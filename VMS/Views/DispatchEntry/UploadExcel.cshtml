@model VMS.Models.ExcelUploadViewModel
@{
    ViewData["Title"] = "Upload Excel";
}

<div class="container mb-4">
    <div class="bg-white p-4 rounded shadow-sm border">
        <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
            <h4 class="mb-0">Upload Dispatch Excel Data</h4>
        </div>

        <p class="text-danger mb-3">
            <strong>Note:</strong> Please follow the below Excel format:<br />
            <code>LR_No, VehicleNo, OwnOther,BillType,CustomerName,FreightRate, FreightAmt,BillNo,LoadingDate,FromStation,ToStation, Deduction,Shortage,Remark</code><br />
            <a href="@Url.Content("~/uploadsample/ExcelTemplate.xlsx")" class="text-decoration-underline" download>
                Download Sample Template
            </a>
        </p>

        @if (TempData["Success"] != null)
        {
            <div id="alertMessage" class="alert alert-success">
                @TempData["Success"]
            </div>
        }
        else if (TempData["Error"] != null)
        {
            <div id="alertMessage" class="alert alert-danger">
                @TempData["Error"]
            </div>
        }
        else if (TempData["Warning"] != null)
        {
            <div id="alertMessage" class="alert alert-warning">
                @TempData["Warning"]
            </div>
        }


        @using (Html.BeginForm("UploadExcel", "DispatchEntry", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <!-- Options Row -->
            <!-- File Input -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <label class="form-label"><strong>Select Excel File</strong></label>
                    <input type="file" class="form-control" name="excelFile" style="width:300px" accept=".xls,.xlsx" required />
                </div>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-primary">Upload</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        }
    </div>
</div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const alertBox = document.getElementById("alertMessage");

            if (alertBox) {
                setTimeout(function () {
                    alertBox.style.transition = "opacity 0.5s ease";
                    alertBox.style.opacity = "0";

                    setTimeout(function () {
                        alertBox.remove();
                    }, 500);
                }, 4000); // 4 seconds
            }
        });
    </script>
}



