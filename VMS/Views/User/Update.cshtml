        function clearControls() {
            $("#ddlRole").prop("selectedIndex", 0).val();
            $("#from-date-picker").val("");
            $("#to-date-picker").val("");
            $("#txtUserName").val("");
            $("#txtPassword").val("");
            $("#txtEmail").val("");
            $("#txtPhone").val("");
            $("#txtUserId").val("");
            $("#chkIsActive").prop("checked", false);
        }

        function getUserbyID(userID) {
            if ($.fn.DataTable.isDataTable("#tblUser")) {
                $('#tblUser tbody').empty();
                $('#tblUser').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "User/getUserbyID")',
                type: "GET",
                data: { userID: userID },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        var sno = 0;
                        var rows = "";
                        var row = "";
                        sno = sno + 1;
                        if (fullAccess === "True" || viewAccess === "True") {
                            viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewUser(\'' + data.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || updateAccess === "True") {
                            updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editUser(\'' + data.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || deleteAccess === "True") {
                            deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteUser(\'' + data.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                        }
                        row = '<tr>' +
                            '<td>' +
                            '<div class="d-flex align-items-center">' +
                            viewButton +
                            updateButton +
                            deleteButton +
                            '</div>' +
                            '</td>' +
                            '<td>' + data.roleName + '</td>' +
                            '<td>' + data.userId + '</td>' +
                            '<td>' + data.userName + '</td>' +
                            '<td>' + data.email + '</td>' +
                            '<td>' + data.phoneNumber + '</td>' +
                            '<td>' + data.startDateString + '</td>' +
                            '<td>' + data.endDateString + '</td>' +
                            '<td>' + data.isActive + '</td>' +
                            '<td>' + data.createDate + '</td>' +
                            '<td>' + data.createdBy + '</td>' +
                            '<td>' + data.updateDate + '</td>' +
                            '<td>' + data.updateBy + '</td>' +
                            '</tr>';

                        //Setting User Details to Page Controls
                        // $('#ddlRole option').map(function () {
                        //     if ($(this).text() == data.roleName) return this;
                        // }).attr('selected', 'selected');

                        getAllUserRole(data.roleName);

                        // $("#ddlRole option").prop('selected', false).filter(function() {
                        //     return $(this).text() === data.roleName;
                        // }).prop('selected', true);

                        $('#txtFirstName').val(data.firstName);
                        $('#from-date-picker').val(data.startDateString);
                        $('#to-date-picker').val(data.endDateString);
                        
                        $('#txtUserId').val(data.userId);
                        $('#txtEmail').val(data.email);
                        $('#txtPhone').val(data.phoneNumber);
                        $("#chkIsActive").prop('checked', data.isActive);
                        $('#hdnUserID').val(data.id);

                        rows = rows + row;
                        $("#userBody").html(rows);
                        rows = "";
                        $("#tblUser").focus();

                        bindDataTable(); 
                    } else {
                        var row = '<tr>' +
                            '<td colspan="13" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#userBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }

        function getUserList() {
            if ($.fn.DataTable.isDataTable("#tblUser")) {
                $('#tblUser tbody').empty();
                $('#tblUser').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "User/getUserList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $.each(data, function (i, item) {
                            var sno = 0;
                            var rows = "";
                            var row = "";
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewUser(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editUser(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteUser(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.roleName + '</td>' +
                                '<td>' + item.userId + '</td>' +
                                '<td>' + item.userName + '</td>' +
                                '<td>' + item.email + '</td>' +
                                '<td>' + item.phoneNumber + '</td>' +
                                '<td>' + item.startDateString + '</td>' +
                                '<td>' + item.endDateString + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.createDate + '</td>' +
                                '<td>' + item.createdBy + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updateBy + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            $("#userBody").append(rows);
                            rows = "";
                            $("#tblUser").focus();
                        });
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="13" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#userBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }

        function updateUser() {
            var isValid = checkValidation();

            if (isValid == true) {
                if ($('#ddlRole option:selected').val() != "0"
                    && $("#txtFirstName").val() != ""
                    && $("#txtLastName").val() != ""
                    && $("#txtUserName").val() != ""
                    && $("#txtPassword").val() != ""
                    && $("#txtEmail").val() != ""
                    && $("#txtPhone").val() != ""
                    && $("#txtUserId").val() != "") {

                    var id = $('#hdnUserID').val();
                    var role = $('#ddlRole option:selected').val();
                    var userId = $("#txtUserId").val();
                    //var stDate = $("#from-date-picker").val();
                    //var enDate = $("#to-date-picker").val();
                    var userName = $("#txtUserName").val();
                    var password = $("#txtPassword").val();
                    var email = $("#txtEmail").val();
                    var phone = $("#txtPhone").val();
                    var isActive = $("#chkIsActive").is(":checked");
                    // var fDate = stDate.split("-").reverse().join("-");
                    // var tDate = enDate.split("-").reverse().join("-");

                    var startDate = $("#from-date-picker").val();
                    var endDate = $("#to-date-picker").val();

                    //var fromDate = startDate.split("-").reverse().join("-");
                    //var toDate = endDate.split("-").reverse().join("-");

                    var fDate = startDate.split("-").reverse().join("-");
                    var tDate = "";
                    if(endDate != "") {
                       tDate = endDate.split("-").reverse().join("-");
                    }

                    $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "User/Update")',
                        type: "POST",
                        dataType: "json",
                        data: { id: id, role: role, startDate: fDate, endDate: tDate, userName: userName, userId: userId, password: password, email: email, phone: phone, isActive: isActive },
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'User Saved Successfully!',
                                        content: "User Detail has been updated successfully.",
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "User/Update?userID=")' + $("#hdnUserID").val();
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'User Already Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                    $("#divUser").hide();
                                }
                            } else {
                                console.log(data);
                                //clearControls();
                                $.confirm({
                                    title: 'Error Occoured!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divUser").hide();
                            }
                        }
                    });
                }
            }
        }
    </script>
}