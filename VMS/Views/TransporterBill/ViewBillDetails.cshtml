        function generatePdf(){
            var pageHTML = $('#divPrint').html();
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "TransporterBill/downloadPDF")',
                type: "POST",
                dataType: "json",
                data: { divHTML: pageHTML },
                success: function (data) {
                    if (data != null && data != undefined) {
                        if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                            //alert(data);
                        }
                        console.log(data);
                    } else {
                        console.log(data);
                    }
                }
            });
        }

        function downloadPDF() {
            var pageHTML = $('#divPrint').html();
            var billNo = $("#hdnBillNo").val();
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "TransporterBill/saveITextSharpPDF")',
                type: "POST",
                dataType: "json",
                data: { divHTML: pageHTML, billNo: billNo },
                success: function (data) {
                    if (data != null && data != undefined) {
                        if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                            window.location = '@Url.Action("downlodPDF", "TransporterBill")';
                        }
                        console.log(data);
                    } else {
                        console.log(data);
                    }
                }
            });
        }

        function savePDFandSendEmail() {
            var pageHTML = $('#divPrint').html();
            var billNo = $("#hdnBillNo").val();
            var transporterName = $("#spanTransporterName").html();
            var transporterEmail = $("#hdnTransporterEmail").val();
            var companyName = $("#hdnCompanyName").val();

            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "TransporterBill/savePDFandEmail")',
                type: "POST",
                dataType: "json",
                data: {
                    divHTML: pageHTML, billNo: billNo, transName: transporterName,
                    transEmail: transporterEmail, companyName: companyName },
                success: function (data) {
                    if (data != null && data != undefined) {
                        if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                            $.confirm({
                                title: 'Transporter Bill Generated & Email Sent!',
                                content: 'Transporter Bill has been generated and Email sent to  Transporter.',
                                icon: 'fa fa-warning',
                                type: 'green',
                                buttons: {
                                    omg: {
                                        text: 'OK',
                                        btnClass: 'btn-green',
                                    },
                                }
                            });
                        }
                        console.log(data);
                    } else {
                        console.log(data);
                    }
                }
            });
        }

        function sendEmailWithAttachemnt() {
            var transporterName = $("#spanTransporterName").html();
            var transporterEmail = $("#hdnTransporterEmail").val();
            var companyName = $("#hdnCompanyName").val();

            window.location = '@Url.Action("SendEmailWithAttachment", "TransporterBill")?transName=' + transporterName + '&transEmail=' + transporterEmail + '&companyName=' + companyName;
        }
