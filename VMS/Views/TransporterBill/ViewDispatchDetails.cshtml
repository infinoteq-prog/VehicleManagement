@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        var fullAccess = 'True';
        var viewAccess = 'True';
        
        $(document).ready(function () {
            //setSideMenu("transporter-master");
            if (fullAccess === "True" || viewAccess === "True") {
                makeFieldsReadOnly();
                var dispatchId = GetParameterValues('dispatchId');
                getDispatchDetails(dispatchId);
            }
        });

        function makeFieldsReadOnly() {
            $("#txtBillNo").prop("readonly", true);
            $("#txtBillDt").prop("readonly", true);
            $("#txtSupplyingPlant").prop("readonly", true);
            $("#txtShipmentNo").prop("readonly", true);
            $("#txtDeliveryNo").prop("readonly", true);
            $("#txtTruckNo").prop("readonly", true);
            $("#txtLRGRNo").prop("readonly", true);
            $("#txtLRGRDate").prop("readonly", true);
            $("#txtShipToPartyTzone").prop("readonly", true);
            $("#txtDispatchQuantity").prop("readonly", true);
            $("#txtEbidNetAmount").prop("readonly", true);
            $("#txtEbidRate").prop("readonly", true);
            $("#txtForwardingAgentCode").prop("readonly", true);
            $("#txtForwardingAgentName").prop("readonly", true);
            $("#txtForwardingAgentName").prop("readonly", true);
            $("#txtRegionState").prop("readonly", true);
            $("#txtPgiNo").prop("readonly", true);
            $("#txtPgiDate").prop("readonly", true);
            $("#txtDistributionChannel").prop("readonly", true);
            $("#txtDivision").prop("readonly", true);
            $("#txtIncoTerm").prop("readonly", true);
            $("#txtRouteCode").prop("readonly", true);
            $("#txtRouteDescription").prop("readonly", true);
            $("#txtEpodNo").prop("readonly", true);
            $("#txtEpodDate").prop("readonly", true);
            $("#txtCgstRate").prop("readonly", true);
            $("#txtSgstRate").prop("readonly", true);
            $("#txtIgstRate").prop("readonly", true);
            $("#txtUgstRate").prop("readonly", true);
            $("#txtTotalAmount").prop("readonly", true);
            $("#chkIsActive").attr("disabled", true);
        }

        function getDispatchDetails(dispatchId) {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "TransporterBill/getDispatchDetailsById")',
                type: "GET",
                data: { dispatchId: dispatchId },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                       
                        $("#txtBillNo").val(data.billNo);
                        $("#txtBillDt").val(data.billDate);
                        $("#txtSupplyingPlant").val(data.supplyingPlant);
                        $("#txtShipmentNo").val(data.shipmentNo);
                        $("#txtDeliveryNo").val(data.deliveryNo);
                        $("#txtTruckNo").val(data.truckNo);
                        $("#txtLRGRNo").val(data.lrGrNo);
                        $("#txtLRGRDate").val(data.lrGrDate);
                        $("#txtShipToPartyTzone").val(data.shipToPartyTzone);
                        $("#txtDispatchQuantity").val(data.dispatchQtyRoad);
                        $("#txtEbidNetAmount").val(data.ebidNetAmt);
                        $("#txtEbidRate").val(data.ebidFrtRate);
                        $("#txtForwardingAgentCode").val(data.forwardingAgentCode);
                        $("#txtForwardingAgentName").val(data.forwardingAgentName);
                        $("#txtRegionState").val(data.regionState);
                        // $("#txtPgiNo").val(data.pgiNo);
                        $("#txtPgiDate").val(data.pgiDate);
                        $("#txtDistributionChannel").val(data.distributionChannel);
                        $("#txtDivision").val(data.division);
                        $("#txtIncoTerm").val(data.incoTerm);
                        $("#txtRouteCode").val(data.routeCode);
                        $("#txtRouteDescription").val(data.routeDescription);
                        $("#txtEpodNo").val(data.epodNo);
                        $("#txtEpodDate").val(data.epodDate);
                        $("#txtCgstRate").val(data.cgstRate);
                        $("#txtSgstRate").val(data.sgstRate);
                        $("#txtIgstRate").val(data.igstRate);
                        $("#txtUgstRate").val(data.utgstRate);
                        $("#txtTotalAmount").val(data.totalAmount);
                        $("#chkIsActive").prop('checked', data.isActive);
                    } else {
                        $.confirm({
                            title: 'Dispatch Transaction Details',
                            content: 'Dispatch Transaction Details not Exists!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}