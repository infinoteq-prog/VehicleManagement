        function GetParameterValues(param) {
            var url = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
            for (var i = 0; i < url.length; i++) {
                var urlparam = url[i].split('=');
                if (urlparam[0] == param) {
                    return urlparam[1];
                }
            }
        }

        function clearControls() {
            $("#ddlCompanyMaster").prop("selectedIndex", 0).val();
            $("#ddlTransporter").prop("selectedIndex", 0).val();
            $("#txtBillNo").val("");
            $("#txtBillDate").val("");
            $("#from-date-picker").val("");
            $("#to-date-picker").val("");
        }

        function searchTransporterBills() {
            if ($.fn.DataTable.isDataTable("#tblBillDetail")) {
                $('#tblBillDetail tr').remove();
                $('#tblBillDetail tbody').empty();
                $('#tblBillDetail').DataTable().clear().destroy();
            }

            $("#thTransporterBillDetails").html("");   
            var billNo = $('#txtBillNo').val();
            var companyCode = $('#ddlCompanyMaster option:selected').text();
            var transporterCode = $('#ddlTransporter option:selected').text();
            var fromDate = $("#from-date-picker").val();
            var toDate = $("#to-date-picker").val();
            var billDate = $("#txtBillDate").val();
            var newFromdate = "";
            var newTodate = "";
            if(fromDate != ""){
                newFromdate = fromDate.split("-").reverse().join("-");
            }
            if(toDate != ""){
                newTodate = toDate.split("-").reverse().join("-");
            }

            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "TransporterBill/searchTransporterBills")',
                type: "GET",
                dataType: "json",
                data: { billNo: billNo, companyCode: companyCode, transporterCode: transporterCode,
                        billDate: billDate, fromDate: newFromdate, toDate: newTodate },
                success: function (data) {
                    if (data != null && data != undefined) {
                        $("#divTransporterBillDetails").show();
                        $("#divTransporterBill").show();
                        $("#divTransporterBillTransactions").hide();
                        $("#thActions").show();
                        console.log(data);
                        var sno = 0;
                        $("#thBillDetails").html("");
                        if ($("#thBillDetails").html() == "") {
                            $.each(data, function (i, item) {
                                sno = sno + 1;
                                if (fullAccess === "True" || viewAccess === "True") {
                                    viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewTransporterBillTrans(\'' + item.billNumber + '\');"> View Details <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                                }

                                if (fullAccess === "True" || printAccess === "True") {
                                    printButton = '<button id="btnPrint" type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewTransportBillDetails(\'' + item.billNumber + '\');"> Print <i class="typcn typcn-printer btn-icon-append"></i></button> ';
                                }
                                var rows = '<tr>' +
                                    '<td>' +
                                    '<div class="d-flex align-items-center">' +
                                    viewButton +
                                    printButton +
                                    '</div>' +
                                    '</td>' +
                                    // '<td class="table-grid-td">' + sno + '</td>' +
                                    '<td class="table-grid-td">' + item.billNumber + '</td>' +
                                    '<td class="table-grid-td">' + item.billDate + '</td>' +
                                    '<td class="table-grid-td">' + item.transporterName + '</td>' +
                                    '<td class="table-grid-td">' + item.companyName + '</td>' +
                                    '<td class="table-grid-td">' + item.sgstAmount + '</td>' +
                                    '<td class="table-grid-td">' + item.cgstAmount + '</td>' +
                                    '<td class="table-grid-td">' + item.igstAmount + '</td>' +
                                    '<td class="table-grid-td">' + item.ugstAmount + '</td>' +
                                    '<td class="table-grid-td">' + item.totalBillAmount + '</td>' +
                                    '<td class="table-grid-td">' + item.createdOn + '</td>' +
                                    '<td class="table-grid-td">' + item.createdByName  + '</td>' +
                                    '</tr>';

                                $("#thBillDetails").append(rows);
                            });
                            bindMainDataTable();
                        }

                    } else {
                        console.log(data);
                        var row = '<tr>' +
                            '<td colspan="12" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#thBillDetails").html(row);
                        $("#divTransporterBillDetails").show();
                        $("#divTransporterBill").show();
                        $("#divTransporterBillTransactions").hide();
                        //$("#divTransporterBillDetails").hide();
                    }
