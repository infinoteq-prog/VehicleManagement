        var deductableAmount = 0;
        var netAmount = 0;
        var chk = "";
        $.ajax({
            cache: false,
            url: '@(utilityHelper.SiteUrl() + "TransporterBill/getTransporterBillTrans")',
            type: "GET",
            dataType: "json",
            data: { billNo: billNo },
            success: function (data) {
                if (data != null && data != undefined) {
                    $("#divTransporterBillTransactions").show();
                    console.log(data);
                    var sno = 0;
                    $("#thTransporterBillDetails").html("");
                    if ($("#thTransporterBillDetails").html() == "") {
                        $.each(data, function (i, item) {
                            sno = sno + 1;
