    function generateBillNo(){
            if ($('#ddlCompanyMaster option:selected').val() != "0"
                    && $('#ddlBillCategory option:selected').val() != "0"
                    && $('#ddlDivision option:selected').val() != "0"
                    && $('#ddlCode option:selected').val() != "0"
                    && $("#txtBillDate").val() != ""
                    && $("#txtHsnCode").val() != ""
                    && $("#from-date-picker").val() != ""
                    && $("#to-date-picker").val() != ""
                    && $("#txtBillNumber").val() != "") {
            if ($("#hdnDispatchId").val() == null && $("#hdnDispatchId").val() == "") {
                $.confirm({
                    title: 'No Dispatch Entry Found!',
                    content: 'Transporter Bill will not be generated because no Dispatch Entry Found.',
                    icon: 'fa fa-warning',
                    type: 'red',
                    buttons: {
                        omg: {
                            text: 'OK',
                            btnClass: 'btn-red',
                        },
                    }
                });
            }
            else {
                var billTo = $('#ddlCompanyMaster option:selected').text();
                var billCategory = $('#ddlBillCategory option:selected').text();
                var division = $('#ddlDivision option:selected').text();
                var incoTerm = $('#ddlCode option:selected').text();
                var billDate = $("#txtBillDate").val();
                billDate = billDate.split("-").reverse().join("-");
                var hsnCode = $("#txtHsnCode").val();
                var transCode = $("#hdnTransporterCode").val();
                var startDate = $("#from-date-picker").val();
                var fromDate = startDate.split("-").reverse().join("-");
                var endDate = $("#to-date-picker").val();
                var toDate = endDate.split("-").reverse().join("-");
                var uniqueDispatchId = $("#hndUniqueDispatchNo").val();
                var dispatchIds = "";
                var billToId =  $('#ddlCompanyMaster option:selected').val();
                var transId =  $('#hdnTransporterId').val();
                var billNo = $("#txtBillNumber").val();

                $('.chkSelect').each(function () {
                      var isChecked = $(this).is(":checked");
                      if(isChecked == true){
                        if($(this).prop("alt") != undefined){
                            dispatchIds = dispatchIds + $(this).prop("alt") + ",";
                        }
                      }
                });

                if(dispatchIds != ""){
                        $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "TransporterBill/generateBillNo")',
                        type: "POST",
                        dataType: "json",
                                    data: { billTo: billTo, billCategory: billCategory, transCode: transCode, division: division,
                                            incoTerm: incoTerm, billDate: billDate, hsnCode: hsnCode, fromDate: fromDate,
                                            toDate: toDate, uniqueDispatchId: uniqueDispatchId, dispatchIds: dispatchIds,
                                            billToId: billToId, transId: transId, billNo: billNo},
                        success: function (data) {
                            if (data != null && data != undefined) {
                                console.log(data);
                                 if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {

                                    $.confirm({
                                        title: 'Bill Generation Success!',
                                        content: data.transactionMessage.message + "Bill Number is : " + data.billNumber,
                                        icon: 'fa fa-warning',
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    $("#hdnBillNo").val(data.billNumber);
                                                    searchTransporterBills(data.billNumber);
                                                    $("#divGenerateBill").hide();
                                                    getBillNumber(@ViewBag.TransporterCode);
                                                }
                                                // action: function () {
                                                //     window.location.href = '@Url.Action("ViewTransporterBill", "TransporterBill")?billno=' + data.autoGeneratedBillNo;
                                                // }
                                            },
                                            view: {
                                                text: 'View',
                                                btnClass: 'btn-purple',
                                                action: function () {
                                                    var url = '@(VMS.Helper.utilityHelper.SiteUrl() + "TransporterBill/ViewBillDetails?billno=")' + data.billNumber;
                                                    window.open(url, '_blank');
                                                    return false;
                                                }
                                            },
                                        }
                                    });
                                }
                               else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: data.transactionMessage.title,
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });

                                    $("#divGenerateBill").show();
                                }
                            } else {
                                //clearControls();
                                $.confirm({
                                    title: 'Data Not Found!',
                                    content: 'No Data Found! Please try Again.',
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divGenerateBill").show();
                                console.log(data);
                            }
                        }
                    });
                }else{
                    $.confirm({
                        title: 'Dispatch Transation Validation',
                        content: 'Please select a Dispatch Transaction to Generate a Bill!',
                        icon: 'fa fa-warning',
                        type: 'red',
                        buttons: {
                            omg: {
                                text: 'OK',
                                btnClass: 'btn-red',
                            },
                        }
                    });
                }
            }
        }
    }

    function searchTransporterBills(billNo) {
        if ($.fn.DataTable.isDataTable("#tblBillDetail")) {
            $('#tblBillDetail tbody').empty();
            $('#tblBillDetail').DataTable().clear().destroy();
        }
        var companyCode = "";
        var transporterCode ="";
        var fromDate = "";
        var toDate = "";
        var billDate = "";
        var newFromdate = "";
        var newTodate = "";
        $.ajax({
            cache: false,
            url: '@(utilityHelper.SiteUrl() + "TransporterBill/searchTransporterBills")',
            type: "GET",
            dataType: "json",
            data: { billNo: billNo, companyCode: companyCode, transporterCode: transporterCode, 
                    billDate: billDate, fromDate: newFromdate, toDate: newTodate },
            success: function (data) {
                if (data != null && data != undefined) {
                    $("#divTransporterBillDetails").show();
                    $("#divTransporterBillTransactions").hide();
                    $("#divTransporterBillDetail").show();
                    $("#divTransporterBillHeading").show();
                    $("#divGenerateBill").hide();
                    $("#thActions").show();
                    console.log(data);
                    var sno = 0;
                    $("#thBillDetails").html("");
                    if ($("#thBillDetails").html() == "") {
                        $.each(data, function (i, item) {
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewTransporterBillTrans(\'' + item.billNumber + '\');"> View Details <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || printAccess === "True") {
                                    printButton = '<button id="btnPrint" type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewTransportBillDetails(\'' + item.billNumber + '\');"> Print <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            var rows = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                    viewButton +
                                    printButton +
                                '</div>' +
                                '</td>' +
                                // '<td class="table-grid-td">' + sno + '</td>' +
                                '<td class="table-grid-td">' + item.billNumber + '</td>' +
                                '<td class="table-grid-td">' + item.billDate + '</td>' +
