    function clearControls() {
        $("#ddlCompanyMaster").prop("selectedIndex", 0).val();
        $("#ddlBillCategory").prop("selectedIndex", 0).val();
        $("#ddlDivision").prop("selectedIndex", 0).val();
        $("#ddlCode").prop("selectedIndex", 0).val();
        $("#txtBillDate").val(""); 
        $("#txtHsnCode").val("");
        $("#from-date-picker").val("");
        $("#to-date-picker").val("");
    }

    function bindDataTable() {
        $('#tblTransporterTrans').DataTable({
            deferRender: true,
            scroller: true,
            scrollX: true,
            scrollY: true,
            searching: true,
            info: true,
            paging: false,
            dom: 'Bfrtip',
            "bDestroy": true,
            buttons: [
                {
                    extend: 'copyHtml5',
                    text: 'Copy'
                },
                {
                    extend: 'csvHtml5',
                    text: 'Csv',
                    title: function () {
                        return "Transporter Bill Transactions";
                    },
                    text: '<span class="fa fa-file-pdf-o">Csv</span>',
                    titleAttr: 'Csv'
                },
                {
                    extend: 'excelHtml5',
                    text: 'Excel',
                    title: function () {
                            return "Transporter Bill Transactions";
                    },
                    text: '<span class="fa fa-file-pdf-o">Excel</span>',
                    titleAttr: 'Excel'
                },
                {
                    extend: "print",
                    exportOptions: {
                        orientation: 'landscape'
                    },
                    title: function () {
                        return "Transporter Bill Transactions";
                    },
                    pageSize: 'A0',
                    customize: function (win) {
                        var last = null;
                        var current = null;
                        var bod = [];

                        var css = '@@page { size: landscape; }',
                            head = win.document.head || win.document.getElementsByTagName('head')[0],
                            style = win.document.createElement('style');

                        style.type = 'text/css';
                        style.media = 'print';

                        if (style.styleSheet) {
                            style.styleSheet.cssText = css;
                        }
                        else {
                            style.appendChild(win.document.createTextNode(css));
                        }
                        head.appendChild(style);
                    }
                },
                {
                    extend: 'pdfHtml5',
                    title: function () {
                        return "Transporter Bill Transactions";
                    },
                    orientation: 'landscape',
                    pageSize: 'A1',
                    text: '<span class="fa fa-file-pdf-o">PDF</span>',
                    titleAttr: 'PDF'
                }
            ]
        });
    }

    function bindMainDataTable() {
        $('#tblBillDetail').DataTable({
            deferRender: true,
            scroller: true,
            scrollX: true,
            scrollY: true,
            searching: true,
            info: true,
            paging: true,
            "bDestroy": true,
            dom: 'Bfrtip',
            buttons: [
                {
                    extend: 'copyHtml5',
                    text: 'Copy'
                },
                {
                    extend: 'csvHtml5',
                    text: 'Csv',
                    title: function () {
                        return "Transporter Bill Details";
                    },
                    text: '<span class="fa fa-file-pdf-o">Csv</span>',
                    titleAttr: 'Csv'
                },
                {
                    extend: 'excelHtml5',
                    text: 'Excel',
                    title: function () {
                            return "Transporter Bill Details";
                    },
                    text: '<span class="fa fa-file-pdf-o">Excel</span>',
                    titleAttr: 'Excel'
                },
                {
                    extend: "print",
                    exportOptions: {
                        orientation: 'landscape'
                    },
                    title: function () {
                        return "Transporter Bill Details";
                    },
                    pageSize: 'A0',
                    customize: function(win)
                    {
                        var last = null;
                        var current = null;
                        var bod = [];

                        var css = '@@page { size: landscape; }',
                            head = win.document.head || win.document.getElementsByTagName('head')[0],
                            style = win.document.createElement('style');

                        style.type = 'text/css';
                        style.media = 'print';

                        if (style.styleSheet)
                        {
                            style.styleSheet.cssText = css;
                        }
                        else
                        {
                            style.appendChild(win.document.createTextNode(css));
                        }
                        head.appendChild(style);
                        }
                },
                {
                    extend: 'pdfHtml5',
                    title: function () {
                        return "Transporter Bill Details";
                    },
                    orientation: 'landscape',
                    pageSize: 'A3',
                    text: '<span class="fa fa-file-pdf-o">PDF</span>',
                    titleAttr: 'PDF'
                }
            ]
        });
    }

    function getTransporter(transporterId) {
        $.ajax({
            cache: false,
            url: '@(utilityHelper.SiteUrl() + "TransporterBill/getTransporter")',
            type: "GET",
            data: { transporterId: transporterId },
            dataType: "json",
            success: function (data) {
                if (data != null && data != undefined) {
                    $('#ddlCompanyMaster option').map(function () {
                        if ($(this).val() == data.id) return this;
                    }).attr('selected', 'selected');
                    $("#ddlCompanyMaster").prop("disabled", true);
                } 
                else{
                    $("#ddlCompanyMaster").prop("disabled", false);
                }
            }
        });
    }

    function calculateAmount(cltr){
        if(cltr !== null && cltr !== undefined){
            var cltrId = cltr.id; 
            cltrId = cltrId.replace("chkBillTrans", "");

            var noOfItemsId = 'spanNoOfItems' + cltrId;
            var totalQuantity = 'spanTotalQuantity' + cltrId;
            var totalAmount = 'spanTotalAmount' + cltrId;

            if($('#' + cltr.id).prop("checked") == true){
                $("#lblTotalItems").html(parseFloat($("#lblTotalItems").html()) + parseFloat(1));
                $("#lblTotalQuantity").html(parseFloat($("#lblTotalQuantity").html()) + parseFloat($('#' + totalQuantity).html()));
                $("#lblTotalAmount").html(parseFloat($("#lblTotalAmount").html()) + parseFloat($('#' + totalAmount).html()));
            }else{
                $("#lblTotalItems").html(parseFloat($("#lblTotalItems").html()) - parseFloat(1));
                $("#lblTotalQuantity").html(parseFloat($("#lblTotalQuantity").html()) - parseFloat($('#' + totalQuantity).html()));
                $("#lblTotalAmount").html(parseFloat($("#lblTotalAmount").html()) - parseFloat($('#' + totalAmount).html()));
            }
        }
    }

