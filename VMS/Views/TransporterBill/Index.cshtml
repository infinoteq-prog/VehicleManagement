                                            <th>SHIPMENT <br />NUMBER</th>
                                            <th>EBID NET <br />AMOUNT</th>
                                            <th>EBID RATE</th>
                                            <th>SUPPLYING <br />PLANT</th>
                                            <th>SHIP TO <br />PARTY TZONE</th>
                                            <th>FORWARDING <br />AGENT CODE</th>
                                            <th>FORWARDING <br />AGENT NAME</th>
                                            <th>REGION STATE</th>
                                            <th>PGI DATE</th>
                                            <th>DISTRIBUTION <br />CHANNEL</th>
                                            <th>DIVISION</th>
                                            <th>INCO TERM</th>
                                            <th>ROUTE CODE</th>
