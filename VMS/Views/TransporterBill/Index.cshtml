                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlCompanyMaster" name="ddlCompanyMaster" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                        <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlBillCategory">Bill Category: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlBillCategory" name="ddlBillCategory" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtBillDate">Bill Date: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtBillDate" name="txtBillDate" placeholder="Select Billing Date" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                        </div>
                                    </div>
                                </div> 
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="to-date-picker">Division: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlDivision" name="ddlDivision" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>            
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div id="divShortagePercentage" class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlCode">Inco Term: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlCode" name="ddlCode" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div id="divShortageRate" class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtHsnCode">HSN Code: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtHsnCode" placeholder="Enter HSN Code" class="form-control numberonly" maxlength="15" onchange="setTextboxStyle(this);">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
