@section scripts {
<script type="text/javascript">
    // var fullAccess = '@ViewBag.TransporterBillFullAccess';
    // var addAccess = '@ViewBag.TransporterBillInsertAccess';
    // var viewAccess = '@ViewBag.TransporterBillViewAccess';
    // var viewPendingBillAccess = '@ViewBag.TransporterBillPendingAccess';
    // var printAccess = '@ViewBag.TransporterBillPrintAccess';

    var fullAccess = 'True';
    var addAccess = 'True';
    var viewAccess = 'True';
    var viewPendingBillAccess = 'True';
    var printAccess = 'True';

    var viewButton = "";
    var printButton = "";
    var showUpdateButton = true;
    var defaultShortage = true;

    $(document).ready(function () {
        setSideMenu("transporter-bill");
        $("#divBillTrans").hide();   
        var transporterCode = '@ViewBag.TransporterCode';
        if(transporterCode  == null || transporterCode == undefined || transporterCode == ""){
            transporterNotFound();
        }else{
            getCompanyMasterListWithCode();
            getCodeMaster("CATEGORY");
            getCodeMaster("INCOTERM");
            getCodeMaster("DIVISION");

            if (fullAccess === "True" || addAccess === "True") {
                $(function () {
                    $(".wmd-view-topscroll").scroll(function () {
                        $(".wmd-view").scrollLeft($(".wmd-view-topscroll").scrollLeft());
                    });
                    $(".wmd-view").scroll(function () {
                        $(".wmd-view-topscroll").scrollLeft($(".wmd-view").scrollLeft());
                    });
                });

                $(function () {
                    $("#txtBillDate").datepicker({
                        dateFormat: 'dd-mm-yy',
                        changeYear: true,
                        changeMonth: true,
                        defaultDate: "today"
                    });
                });

                //Fetching Auto Generated Bill Number
                getBillNumber(@ViewBag.TransporterCode);
                $("#hdnNetAmount").val("0");
                $("#divTransporterBillDetails").hide();
                $("#thTransporterBillDetails").html("");
                $("#divGenerateBill").show();
                $("#hdnTransporterCode").val(@ViewBag.TransporterCode);
                $("#hdnTransporterId").val(@ViewBag.TransporterId);

                // $("#txtShortagePercentage").val('@(utilityHelper.shortagePercentage)');
                // $("#txtShortageRate").val('@(utilityHelper.shortageRate)');
                // $("#hndAutoGeneratedNoExists").val("");
                // $("#hndAutoGeneratedNo").val("");
                // $("#hndAutoGeneratedNoforDate").val("");
                // $("#divTransporterBillDetails").hide();
                // $("#thTransporterBillDetails").html("");
                // $("#divGenerateBill").show();
                // getTransporter();
                // getSiteList();
                // getCompanyList();
                
                $("#chkSelectAll").bind("change", function () {
                    $(".chkSelect").prop("checked", $(this).prop("checked"));
                    if($(this).prop("checked") == true){
                        $("#lblTotalItems").html($("#hndSno").val());
                        $("#lblTotalQuantity").html($("#hdnQty").val());
                        $("#lblTotalAmount").html($("#hdnAmount").val());
                    }else{
                        $("#lblTotalItems").html(0);
                        $("#lblTotalQuantity").html(0);
                        $("#lblTotalAmount").html(0);
                    }   
                });

                $(".chkSelect").bind("change", function () {
                    //alert($(this).prop("checked"));
                    if (!$(this).prop("checked")) {
                        $("#chkSelectAll").prop("checked", false);
                        //alert("check2");
                    }
                });

                $("#ddlDivision").change(function(e){
                    getHsnCode($('#ddlDivision option:selected').text());
                });

                getHsnCode("CM");
            }
        }
    });

    function getHsnCode(divisionCode) {
        $.ajax({
            cache: false,
            url: '@(utilityHelper.SiteUrl() + "TransporterBill/getHsnCode")',
            type: "GET",
            data: { divisionCode: divisionCode },
            dataType: "json",
            success: function (data) {
                if (data != null && data != undefined) {
                    $("#txtHsnCode").val(data.description);
                } else {
                    console.log(data);
                }
            }
        });
    }

