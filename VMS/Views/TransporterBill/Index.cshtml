                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtBillNumber"> Bill Number: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtBillNumber" placeholder="Enter Bill Number" class="form-control numberonly" maxlength="30" onchange="setTextboxStyle(this);">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                    </div>
                                </div>
