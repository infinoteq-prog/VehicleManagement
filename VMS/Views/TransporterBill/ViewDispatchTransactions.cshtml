@model VMS.ViewModel.VMTransporterBill
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
} *@

@* @if (userAccess.TransporterBillFullAccess == true || userAccess.TransporterBillViewAccess == true)
{ *@

<div class="content-wrapper">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Search Dispatch Transations</h4>
                    <div class="row rowHeight">
                        <div class="col-md-6 div-table-style">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="from-date-picker">From Date :</label>
                                <div class="col-sm-8">
                                    <input type="text" id="from-date-picker" placeholder="Select From Date" class="form-control" readonly="readonly">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 div-table-style">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="to-date-picker">To Date :</label>
                                <div class="col-sm-8">
                                    <input type="text" id="to-date-picker" placeholder="Select To Date" class="form-control" readonly="readonly">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                    @* @if (userAccess.TransporterBillFullAccess == true || userAccess.TransporterBillViewAccess == true)
                        { *@
                    <div class="row" style="text-align:center;margin-top:30px;">
                        <div class="col-md-12">
                            <button type="button" class="btn btn-primary mr-2" onclick="viewTransporterBillTrans('search');">Search</button>
                            <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button>
                        </div>
                    </div>
                    @*  } *@
                    @* @if (userAccess.TransporterBillFullAccess == true || userAccess.TransporterBillViewAccess == true)
                        { *@
                    <div id="divDispatchList">
                        <div class="row">
                            <div class="col-12 grid-margin stretch-card"></div>
                        </div>
                        <div id="divDispatchDetails" class="row">
                            <div class="col-md-12" style="text-align:center;">
                                <h4 class="card-title">View Dispatch Transactions</h4>
                            </div>
                            <div class="table-responsive pt-3">
                                <table id="tblTransporterTrans" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                    <thead>
                                        <tr>
                                            @*<th>Actions</th> *@
                                            <th>S. No.</th>
                                            <th style="width:250px;">SALES RETRUN</th>
                                            <th style="width:250px;">LR GR NUMBER</th>
                                            <th>LR GR DATE</th>
                                            <th>BILL NUMBER</th>
                                            <th>BILL DATE</th>
                                            <th>TRUCK NUNBER</th>
                                            <th>SHIPMENT NUMBER</th>
                                            <th>DELIVERY NUMBER</th>
                                            <th>SUPPLYING PLANT</th>
                                            <th>SHIP TO PARTY TZONE</th>
                                            <th>DISPATCHED QUANTITY</th>
                                            <th>EBID NET AMOUNT</th>
                                            <th>EBID RATE</th>
                                            <th>FORWARDING AGENT CODE</th>
                                            <th>FORWARDING AGENT NAME</th>
                                            <th>REGION STATE</th>
                                            @* <th>PGI NUMBER</th> *@
                                            <th>PGI DATE</th>
                                            <th>DISTRIBUTION CHANNEL</th>
                                            <th>DIVISION</th>
                                            <th>INCO TERM</th>
                                            <th>ROUTE CODE</th>
                                            <th>ROUTE DESCRIPTION</th>
                                            <th>EPOD NUMBER</th>
                                            <th>EPOD DATE</th>
                                            <th>CGST RATE</th>
                                            <th>SGST RATE</th>
                                            <th>IGST RATE</th>
                                            <th>UGST Rate</th>
                                            <th>TOTAL AMOUNT</th>
                                            <th>Is Active</th>
                                            <th>Creation Date</th>
                                            <th>Created By</th>
                                            <th>Update Date</th>
                                            <th>Updatd By</th>
                                        </tr>
                                    </thead>
                                    <tbody id="thTransporterBillDetails">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    @*  } *@
                </div>
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.TransporterBillFullAccess';
        // var addAccess = '@ViewBag.TransporterBillInsertAccess';
        // var viewAccess = '@ViewBag.TransporterBillViewAccess';
        // var viewPendingBillAccess = '@ViewBag.TransporterBillPendingAccess';
        // var printAccess = '@ViewBag.TransporterBillPrintAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var viewPendingBillAccess = 'True';
        var printAccess = 'True';
        var viewButton = "";
        var viewExceptionalItemButton = "";
        var viewTransButton = "";
        var printButton = "";
        $(document).ready(function () {
            setSideMenu("transporter-bill");
            if (fullAccess === "True" || viewAccess === "True") {
                $('.chkSelect').prop('checked', false);
                $(function () {
                    $("#from-date-picker").datepicker({
                        dateFormat: 'dd-mm-yy'
                    });

                    $("#to-date-picker").datepicker({
                        dateFormat: 'dd-mm-yy'
                    });
                });
                viewTransporterBillTrans("pageload");
            }
        });

        function checkValidation() {
            var isValid = true;
            if ($("#from-date-picker").val() == "") {
                $("#from-date-picker").attr('class', 'form-control vaidationTextBoxError');
                $("#from-date-picker").focus();
                isValid = false;
            } else {
                $("#from-date-picker").attr('class', 'form-control');
                $("#from-date-picker").focus();
            }

            if ($("#to-date-picker").val() == "") {
                $("#to-date-picker").attr('class', 'form-control vaidationTextBoxError');
                $("#to-date-picker").focus();
                isValid = false;
            } else {
                $("#to-date-picker").attr('class', 'form-control');
                $("#to-date-picker").focus();
            }

            return isValid;
        }

        function checkValidationOnChange() {
            $(function () {
                $("#from-date-picker").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });
                $("#to-date-picker").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });
            });
        }

        function bindDataTable() {
            $('#tblTransporterTrans').DataTable({
                pageLength: 100,
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "Transporter Bill Transactions";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "Transporter Bill Transactions";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        title: function () {
                            return "Transporter Bill Transactions";
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "Transporter Bill Transactions";
                        },
                        orientation: 'landscape',
                        pageSize: 'A1',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }

        function clearControls() {
            $("#from-date-picker").val("");
            $("#to-date-picker").val("");
        }

        function viewTransporterBillTrans(mode) {
            if ($.fn.DataTable.isDataTable("#tblTransporterTrans")) {
                $('#tblTransporterTrans tbody').empty();
                $('#tblTransporterTrans').DataTable().clear().destroy();
            }

            if(mode == "search")
            {
                var lrGrNo = "";
                var excepNo = "";
                var isValid = checkValidation();
                 if (isValid == true) {
                    var startDate = $("#from-date-picker").val();
                    var fromDate = startDate.split("-").reverse().join("-");
                    var endDate = $("#to-date-picker").val();
                    var toDate = endDate.split("-").reverse().join("-");
                    var lblCltrId = "";
                    var lblCltrExcepId = "";
                    $("#thTransporterBillDetails").html("");
                    if ($("#thTransporterBillDetails").html() == "") {
                        $.ajax({
                            cache: false,
                            url: '@(utilityHelper.SiteUrl() + "TransporterBill/getDispatchItemList")',
                            type: "GET",
                            dataType: "json",
                            data: { startDate: fromDate, endDate: toDate },
                            success: function (data) {
                                if (data != null && data != undefined) {
                                console.log(data);
                                var sno = 0;
                                $.each(data, function (i, item) {
                                sno = sno + 1;
                                if (fullAccess === "True" || viewAccess === "True") {
                                    if(item.isUserAdmin){
                                       lrGrNo = item.lrGrNo;
                                       viewExceptionalItemButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewDispatchDetails(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                                       lblCltrExcepId = "lblExceptionalItem_" + item.id.toString();
                                       excepNo = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="setExceptionalItem(\'' + item.id + '\', \'' + lblCltrExcepId + '\');">Update<i class="typcn typcn-edit btn-icon-append"></i></button> &nbsp; <label id="' + lblCltrExcepId + '" class="col-sm-3 col-form-label">' + item.exceptionalEntry + '</label>';
                                    }else{
                                       viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewDispatchDetails(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                                       lblCltrId = "lblLRGRNO_" + item.id.toString();
                                       lrGrNo = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="setLRGRNO(\'' + item.id + '\', \'' + lblCltrId + '\');">Update<i class="typcn typcn-edit btn-icon-append"></i></button> &nbsp; <label id="' + lblCltrId + '" class="col-sm-3 col-form-label">' + item.lrGrNo + '</label>';
                                       excepNo = item.exceptionalEntry;
                                    }
                                }
                                   var rows =  '<tr>' +
                                                '<td>' + sno + '</td>' +
                                                '<td>' + excepNo + '</td>' +
                                                '<td>' + lrGrNo + '</td>' +
                                                '<td>' + item.lrGrDate + '</td>' +
                                                '<td>' + item.billNo + '</td>' +
                                                '<td>' + item.billDate + '</td>' +
                                                '<td>' + item.truckNo + '</td>' +
                                                '<td>' + item.shipmentNo + '</td>' +
                                                '<td>' + item.deliveryNo + '</td>' +
                                                '<td>' + item.supplyingPlant + '</td>' +
                                                '<td>' + item.shipToPartyTzone + '</td>' +
                                                '<td>' + item.dispatchQtyRoad + '</td>' +
                                                '<td>' + item.ebidNetAmt + '</td>' +
                                                '<td>' + item.ebidFrtRate + '</td>' +
                                                '<td>' + item.forwardingAgentCode + '</td>' +
                                                '<td>' + item.forwardingAgentName + '</td>' +
                                                '<td>' + item.regionState + '</td>' +
                                                '<td>' + item.pgiDate + '</td>' +
                                                '<td>' + item.distributionChannel + '</td>' +
                                                '<td>' + item.division + '</td>' +
                                                '<td>' + item.incoTerm + '</td>' +
                                                '<td>' + item.routeCode + '</td>' +
                                                '<td>' + item.routeDescription + '</td>' +
                                                '<td>' + item.epodNo + '</td>' +
                                                '<td>' + item.epodDate + '</td>' +
                                                '<td>' + item.cgstRate + '</td>' +
                                                '<td>' + item.sgstRate + '</td>' +
                                                '<td>' + item.igstRate + '</td>' +
                                                '<td>' + item.utgstRate + '</td>' +
                                                '<td>' + item.totalAmount + '</td>' +
                                                '<td>' + item.isActive + '</td>' +
                                                '<td>' + item.creationDate + '</td>' +
                                                '<td>' + item.createdByName + '</td>' +
                                                '<td>' + item.updateDate + '</td>' +
                                                '<td>' + item.updatedByName + '</td>' +
                                        '</tr>';

                                        $("#thTransporterBillDetails").append(rows);
                                    });
                                    bindDataTable();
                                    $("#divDispatchList").show();
                                } else {
                                    console.log(data);
                                    var row = '<tr>' +
                                        '<td colspan="35" style="text-align:center">No Data Found!!!</td>' +
                                        '</tr>';
                                    $("#thTransporterBillDetails").html(row);
                                    $("#divDispatchList").show();
                                }
                            }
                        });
                    }
                }
                else{
                    var row = '<tr>' +
                              '<td colspan="36" style="text-align:center">No Data Found!!!</td>' +
                              '</tr>';
                              $("#thTransporterBillDetails").html(row);
                              $("#divDispatchList").show();
                }
            }else{
                    var row = '<tr>' +
                              '<td colspan="36" style="text-align:center">No Data Found!!!</td>' +
                              '</tr>';
                              $("#thTransporterBillDetails").html(row);
                              $("#divDispatchList").show();
            }
        }
    </script>
}