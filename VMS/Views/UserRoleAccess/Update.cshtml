@model VMS.ViewModel.VMUserRoleAccess
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
} *@

@* @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleUpdateAccess == true)
{ *@
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Update User Role Access</h4>
                    <div id="divUpdateUserRole">
                        <form id="frmUserRole" name="frmUserRole" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <input id="hdnUserRoleAccessId" name="hdnUserRoleAccessId" type="hidden">
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <label id="lblMandatoryMessage" class="reqFields">@SiteConstants.ReqFieldMessage</label>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlUser">User: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlUser" name="ddlUser" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlRole">Role: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlRole" name="ddlRole" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlFunction">Function: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlFunction" name="ddlFunction" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtFunctionName"> Function Name: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.FunctionName, new { @class = "form-control", id = "txtFunctionName" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="from-date-picker">From Date: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="from-date-picker" placeholder="Select From Date" class="form-control" onchange="setTextboxStyle(this);" readonly=" readonly">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="to-date-picker">To Date: </label>
                                        <div class="col-sm-8">
                                            <input type="text" id="to-date-picker" placeholder="Select To Date" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="chkIsActive">Is Active:</label>
                                        <div class="col-sm-8">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-label checkboxStyle", id = "chkIsActive" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlMenuMaster">Menu: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlMenuMaster" name="ddlMenuMaster" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6"></div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-12"></div>
                            </div>
                           @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleUpdateAccess == true)
                            { *@
                                <div class="row rowHeight" style="text-align:center;">
                                    <div class="col-md-12">
                                        <button type="button" class="btn btn-primary mr-2" onclick="updateUserRoleAccess();">Update</button>
                                        <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button>
                                    </div>
                                </div>
                           @*  } *@
                        </form>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                        @* @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
                        { *@
                            <div id="divUserRoleAccess">
                                <div class="table-responsive pt-3">
                                    <table id="tblUserRoleAccess" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th>Actions</th>
                                                <th>User Name</th>
                                                <th>Role Name</th>
                                                <th>User Access Name</th>
                                                <th>Start Date</th>
                                                <th>End Date</th>
                                                <th>Is Active</th>
                                                <th>Creation Date</th>
                                                <th>Created By</th>
                                                <th>Update Date</th>
                                                <th>Updatd By</th>
                                                <th>Menu Access</th>
                                            </tr>
                                        </thead>
                                        <tbody id="userAccessBody">
                                        </tbody>
                                    </table>
                                </div>
                                <input id="hdnSaveRate" name="hdnTotalBasicRate" type="hidden">
                            </div>
                        @* } *@
                    </div>
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";
        $(document).ready(function () {
            setSideMenu("users-access");
            if (fullAccess === "True" || viewAccess === "True") {
                clearControls();
                checkValidationOnChange();
                //getUserRoleAccessList();
                var userRoleAccessId = GetParameterValues('userRoleAccessId');
                getUserRoleAccessbyId(userRoleAccessId);
                getUserList();
                getRoleList();
                getMenuList();
                getFunctionList();
                makeFieldsReadOnly();

                $("#ddlUser").on("change", function () {
                    if ($("#ddlUser option:selected").val() != 0) {
                        getUserRole($("#ddlUser option:selected").val());
                    }
                });

                $("#ddlFunction").on("change", function () {
                    if ($("#ddlFunction option:selected").val() == 0) {
                        $("#txtFunctionName").val("");
                    } else {
                        $("#txtFunctionName").val($("#ddlFunction option:selected").text());
                    }
                });
            }
        });

        function makeFieldsReadOnly() {
            $("#txtFunctionName").prop("readonly", true);
            $("#from-date-picker").prop("readonly", true);
            $("#to-date-picker").prop("readonly", true);
            $('#ddlRole').prop("disabled", true);
        }

        function bindDataTable() {
            $('#tblUserRoleAccess').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "User Role Access List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "User Role Access List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "User Role Access List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }

        function checkValidation() {
            var isValid = true;
            if ($('#ddlUser option:selected').val() == "0") {
                $("#ddlUser").attr('class', 'form-control vaidationTextBoxError');
                $("#ddlUser").focus();
                isValid = false;
            } else {
                $("#ddlUser").attr('class', 'form-control');
                $("#ddlUser").focus();
            }

            if ($('#ddlRole option:selected').val() == "0") {
                $("#ddlRole").attr('class', 'form-control vaidationTextBoxError');
                $("#ddlRole").focus();
                isValid = false;
            } else {
                $("#ddlRole").attr('class', 'form-control');
                $("#ddlRole").focus();
            }

            if ($('#ddlFunction option:selected').val() == "0") {
                $("#ddlFunction").attr('class', 'form-control vaidationTextBoxError');
                $("#ddlFunction").focus();
                isValid = false;
            } else {
                $("#ddlFunction").attr('class', 'form-control');
                $("#ddlFunction").focus();
            }

            if ($("#txtFunctionName").val() == "") {
                $("#txtFunctionName").attr('class', 'form-control vaidationTextBoxError');
                $("#txtFunctionName").focus();
                isValid = false;
            } else {
                $("#txtFunctionName").attr('class', 'form-control');
                $("#txtFunctionName").focus();
            }

            if ($("#from-date-picker").val() == "") {
                $("#from-date-picker").attr('class', 'form-control vaidationTextBoxError');
                $("#from-date-picker").focus();
                isValid = false;
            } else {
                $("#from-date-picker").attr('class', 'form-control');
                $("#from-date-picker").focus();
            }

            if ($("ddlMenuMaster").val() == "") { 
                $("ddlMenuMaster").attr('class', 'form-control vaidationTextBoxError');
                $("ddlMenuMaster").focus();
                isValid = false;
            } else {
                $("#ddlMenuMaster").attr('class', 'form-control');
                $("#ddlMenuMaster").focus();
            }
            return isValid;
        }

        function checkValidationOnChange() {
            $(function () {
                $("#ddlUser").change(function () {
                    if ($('option:selected', this).val() == "0") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#ddlRole").change(function () {
                    if ($('option:selected', this).val() == "0") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#ddlFunction").change(function () {
                    if ($('option:selected', this).val() == "0") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtFunctionName").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#from-date-picker").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#ddlMenuMaster").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });
            });
        }

        function clearControls() {
            $("#ddlUser").prop("selectedIndex", 0).val();
            $("#ddlRole").prop("selectedIndex", 0).val();
            $("#ddlFunction").prop("selectedIndex", 0).val();
            $("#txtFunctionName").val("");
            $("#from-date-picker").val("");
            $("#to-date-picker").val("");
            $("#ddlMenuMaster").val("");
            $("#chkIsActive").prop("checked", false);
        }

        function getUserRoleAccessList() {
            if ($.fn.DataTable.isDataTable("#tblUserRoleAccess")) {
                $('#tblUserRoleAccess tbody').empty();
                $('#tblUserRoleAccess').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "UserRoleAccess/getUserRoleAccessList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $.each(data, function (i, item) {
                            var sno = 0;
                            var rows = "";
                            var row = "";
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewUserRoleAccess(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editUserRoleAccess(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteUserRoleAccess(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }

                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.userName + '</td>' +
                                '<td>' + item.roleName + '</td>' +
                                '<td>' + item.functionName + '</td>' +
                                '<td>' + item.startDateString + '</td>' +
                                '<td>' + item.endDateString + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.createDate + '</td>' +
                                '<td>' + item.createdBy + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updateBy + '</td>' +
                                '<td>' + item.codes + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            $("#userAccessBody").append(rows);
                            rows = "";
                            $("#tblUserRoleAccess").focus();
                        });
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="11" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#userAccessBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }

        function updateUserRoleAccess() {
            var isValid = checkValidation();

            if (isValid == true) {
                if ($('#ddlUser option:selected').val() != "0"
                    && $('#ddlRole option:selected').val() != "0"
                    && $('#ddlFunction option:selected').val() != "0"
                    && $("#txtFunctionName").val() != ""
                    && $("#from-date-picker").val() != ""
                    &&  $('#ddlMenuMaster').val() != "0"
                    ) {
                    var id = $('#hdnUserRoleAccessId').val();
                    var userId = $('#ddlUser option:selected').val();
                    var roleId = $('#ddlRole option:selected').val();
                    var functionId = $('#ddlFunction option:selected').val();
                    var functionName = $("#txtFunctionName").val();
                    var isActive = $("#chkIsActive").is(":checked");
                    var startDate = $("#from-date-picker").val();
                    var endDate = $("#to-date-picker").val();
                    var fromDate = startDate.split("-").reverse().join("-");
                    var toDate = "";
                    var menuType = $('#ddlMenuMaster').val();
                    if (endDate != "") {
                        toDate = endDate.split("-").reverse().join("-");
                    }
                   

                    $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "UserRoleAccess/Update")',
                        type: "POST",
                        dataType: "json",
                        data: { id: id, userId: userId, roleId: roleId, functionId: functionId, functionName: functionName,
                            startDate: fromDate, endDate: toDate, isActive: isActive, menuType:menuType},
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'Update User Role Access!',
                                        content: "User Role Access has been updated successfully!",
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    clearControls();
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "UserRoleAccess/Update?userRoleAccessId=")' + $("#hdnUserRoleAccessId").val();
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'User Role Access Already Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                    $("#divUserRoleAccess").hide();
                                }
                            } else {
                                console.log(data);
                                //clearControls();
                                $.confirm({
                                    title: 'Error Occoured!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divUserRoleAccess").hide();
                            }
                        }
                    });
                }
            }
        }

        function getUserRoleAccessbyId(userRoleAccessId) {
            if ($.fn.DataTable.isDataTable("#tblUserRoleAccess")) {
                $('#tblUserRoleAccess tbody').empty();
                $('#tblUserRoleAccess').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "UserRoleAccess/getUserRoleAccessbyId")',
                type: "GET",
                data: { userRoleAccessId: userRoleAccessId },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        var sno = 0;
                        var rows = "";
                        var row = "";
                        sno = sno + 1;
                        if (fullAccess === "True" || viewAccess === "True") {
                            viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewUserRoleAccess(\'' + data.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || updateAccess === "True") {
                            updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editUserRoleAccess(\'' + data.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || deleteAccess === "True") {
                            deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteUserRoleAccess(\'' + data.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                        }
                        row = '<tr>' +
                            '<td>' +
                            '<div class="d-flex align-items-center">' +
                            viewButton +
                            updateButton +
                            deleteButton +
                            '</div>' +
                            '</td>' +
                            '<td>' + data.userName + '</td>' +
                            '<td>' + data.roleName + '</td>' +
                            '<td>' + data.functionName + '</td>' +
                            '<td>' + data.startDateString + '</td>' +
                            '<td>' + data.endDateString + '</td>' +
                            '<td>' + data.isActive + '</td>' +
                            '<td>' + data.createDate + '</td>' +
                            '<td>' + data.createdBy + '</td>' +
                            '<td>' + data.updateDate + '</td>' +
                            '<td>' + data.updateBy + '</td>' +
                            '<td>' + data.codes + '</td>' +
                            '</tr>';

                        //Setting User Role Access Details to Page Controls
                        // $('#ddlUser option').map(function () {
                        //     if ($(this).val() == data.userId) return this;
                        // }).attr('selected', 'selected');
                        // $('#ddlRole option').map(function () {
                        //     if ($(this).val() == data.roleId) return this;
                        // }).attr('selected', 'selected');
                        // $('#ddlFunction option').map(function () {
                        //     if ($(this).val() == data.functionId) return this;
                        // }).attr('selected', 'selected');

                        getUserList(data.userId);

                        getRoleList(data.roleId);

                        getFunctionList(data.functionId);


                        $('#txtFunctionName').val(data.functionName);
                        $("#chkIsActive").prop('checked', data.isActive);
                        $('#hdnUserRoleAccessId').val(data.id);
                        $('#from-date-picker').val(data.startDateString);
                        $('#to-date-picker').val(data.endDateString);
                        $('#ddlMenuMaster').val(data.menuTypeId);
                        getMenuList(data.menuTypeId);

                        rows = rows + row;
                        $("#userAccessBody").html(rows);
                        rows = "";
                        $("#tblUserRoleAccess").focus();

                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="11" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#userAccessBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}