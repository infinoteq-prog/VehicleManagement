@{
}
@model VMS.ViewModel.VMDieselHisab
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Driver Hisab Detail";
}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <div style="text-align: right; margin-bottom: 10px;">
                        <button type="button" class="btn btn-success" onclick="downloadExcel()">Download Excel</button>
                    </div>
                    <h4 class="card-title">Add Diesel Hisab</h4>
                    <div>
                        <form id="frmVehicleMaster" name="frmVehicleMaster" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <label id="lblMandatoryMessage" class="reqFields">@utilityHelper.reqFieldMessage</label>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlVehicleNo">Vehicle No:<span class="reqFields">*</span> </label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlVehicleNo" name="ddlVehicleNo"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtTripNumber">Trip Number:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtTripNumber" placeholder="Enter a trip number." class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-12">
                                    <div class="form-group row">
                                        <h5>Previous Trip History :</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripStartDate">LastTrip Start Date:</label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtLastTripStartDate" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripEndDate">LastTrip End Date:</label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtLastTripEndDate" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripRouteDesc">LastTrip Route Desc:</label>
                                        <div class="col-sm-8">
                                            @Html.TextAreaFor(m => m.LastTripRouteLine, new { @class = "form-control", cols = "10", rows = "5", id = "txtLastTripRouteDesc", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripVendor">LastTrip Vendor:</label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtLastTripVendor" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripDriver">LastTrip Driver:</label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtLastTripDriver" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtEngineNo">LastTrip Driver Father: </label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtLastTripDriverFather" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row rowHeight">
                                <div class="col-md-12">
                                    <div class="form-group row">
                                        <h5>New Trip Details:</h5>
                                    </div>
                                </div>
                            </div>

                            <div class="card" style="padding: 15px; margin-bottom: 20px; border: 1px solid #ccc; border-radius: 6px;">
                                <div class="row rowHeight">
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txtDriverName">Driver Name:<span class="reqFields">*</span></label>
                                            <div class="col-sm-8">
                                                <select class="form-control" id="ddlDriver" name="ddlDriver"></select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txtDriverFatherName">Driver Father Name: <span class="reqFields">*</span> </label>
                                            <div class="col-sm-8">
                                                <input type="text" id="txtDriverFatherName" class="form-control alphanumericonlywithspace" maxlength="100" onchange="setTextboxStyle(this);" placeholder="Please Enter Driver Father Name" readonly="readonly" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row rowHeight">
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="from-date-picker">Trip Start Date : <span class="reqFields">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" id="from-date-picker" placeholder="Select From Date" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="to-date-picker">Trip End Date : <span class="reqFields">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" id="to-date-picker" placeholder="Select To Date" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row rowHeight">
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txtStartOdometer">Start Odometer:<span class="reqFields">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" id="txtStartOdometer" class="form-control numberonly" maxlength="15" onchange="setTextboxStyle(this);" placeholder="Please Enter Start Odometer" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txtEndOdometer">End Odometer: <span class="reqFields">*</span> </label>
                                            <div class="col-sm-8">
                                                <input type="text" id="txtEndOdometer" class="form-control numberonly" maxlength="15" onchange="setTextboxStyle(this);" placeholder="Please Enter End Odometer" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row rowHeight">
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txtRunningKm">Running Km:<span class="reqFields">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" id="txtRunningKm" class="form-control numberonly" maxlength="20" readonly="readonly" onchange="setTextboxStyle(this);" placeholder="Please Enter Run Km" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txtOpeningDiesel">Opening Diesel:<span class="reqFields">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" id="txtOpeningDiesel" class="form-control numberonly" maxlength="20" readonly="readonly" onchange="setTextboxStyle(this);" placeholder="Please Enter Opening Diesel" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txtClosingDiesel">Closing Diesel:<span class="reqFields">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" id="txtClosingDiesel" class="form-control numberonly" maxlength="20" readonly="readonly" onchange="setTextboxStyle(this);" placeholder="Please Enter Opening Diesel" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txt">Discount%:</label>
                                            <div class="col-sm-8">
                                                <input type="text" id="txtDiscountPer" class="form-control numberonly" maxlength="20" readonly="readonly" onchange="setTextboxStyle(this);" placeholder="Please Enter Discount%" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row rowHeight">
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txtRouteDescription">Remarks :<span class="reqFields">*</span></label>
                                            <div class="col-sm-8">
                                                <textarea id="txtRouteDescription" class="form-control" maxlength="300" readonly="readonly" onchange="setTextboxStyle(this);" placeholder="Please Enter Route Description" rows="3"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txtRouteName">Route Name:<span class="reqFields">*</span></label>
                                            <div class="col-sm-8">
                                                <select class="form-control" id="ddlRouteName" readonly="readonly" name="ddlRouteName"></select>
                                               
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txtDriverScore">Driver Score:<span class="reqFields">*</span></label>
                                            <div class="col-sm-8">
                                                <select class="form-control" id="ddlDriverScore" readonly="readonly" name="ddlDriverScore"></select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txtDriverChangeRemarks">Driver Change Desc:<span class="reqFields">*</span></label>
                                            <div class="col-sm-8">
                                                <textarea id="txtDriverChangeRemarks" class="form-control" readonly="readonly" maxlength="300" onchange="setTextboxStyle(this);" placeholder="Please Enter Driver Change Remarks" rows="3"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txtDieselRate">Diesel Rate:<span class="reqFields">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" id="txtDieselRate" class="form-control" readonly="readonly" maxlength="20" inputmode="decimal" pattern="^\d*\.?\d*$" onchange="setTextboxStyle(this);" placeholder="Please Enter DieselRate" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <!-- Diesel Filling Table -->
                            <div class="row rowHeight">
                                <div class="col-md-12">
                                    <div class="form-group row">
                                        <h5>Diesel Filling:</h5>
                                    </div>
                                </div>
                            </div>

                            <div class="card" style="padding: 15px; margin-bottom: 20px; border: 1px solid #ccc; border-radius: 6px;">                               

                                <div class="table-responsive">
                                    <table id="dieselFillingTable" class="table table-bordered">
                                        <thead class="thead-light">
                                            <tr>
                                                <th style="width: 120px;">Date</th>
                                                <th style="display:none;">VendorId</th>
                                                <th style="width: 120px;">Vendor</th>
                                                <th style="width: 120px;">Litre</th>
                                                @* <th>Actions</th> *@
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Table rows will be dynamically added here -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Station Details Section -->
                            <div class="row rowHeight">
                                <div class="col-md-12">
                                    <div class="form-group row">
                                        <h5>Station Details:</h5>
                                    </div>
                                </div>
                            </div>

                            <div class="card" style="padding: 15px; margin-bottom: 20px; border: 1px solid #ccc; border-radius: 6px;">

                                <!-- Station Details Table -->
                                <div class="table-responsive">
                                    <table id="stationDetailsTable" class="table table-bordered">
                                        <thead class="thead-light">
                                            <tr>
                                                <th style="display:none;">StationId</th>
                                                <th style="display:none;">LoadTypeId</th>
                                                <th>Station</th>
                                                <th>Distance</th>
                                                <th>Load Type</th>
                                                <th>Average</th>
                                                <th>Estimated KM</th>
                                                @* <th>Actions</th> *@
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Table rows will be dynamically added -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </form>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                    @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true){ *@
                    <div id="divDieslHisabMaster" style="visibility:hidden">
                        <div class="table-responsive pt-3">
                            <table id="tblDieselHisabMaster" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th>Actions</th>
                                        <th>Vehicle No</th>
                                        <th>Trip Number</th>
                                        <th>Driver Name</th>
                                        <th>Driver Father's Name</th>
                                        <th>Opening Diesel</th>
                                        <th>Start Odometer</th>
                                        <th>End Odometer</th>
                                        <th>Running Km</th>
                                        <th>Is Active</th>
                                        <th>Creation Date</th>
                                        <th>Created By</th>
                                        <th>Update Date</th>
                                        <th>Updatd By</th>
                                    </tr>
                                </thead>
                                <tbody id="DieselHisabMasterBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                    @*   } *@
                </div>
            </div>
        </div>
    </div>
</div>


@section scripts {
      <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        var fullAccess = 'True';
        var viewAccess = 'True';

        $(document).ready(function () {

            getRouteNameMaster();
            getDriverScoreMaster();
            setSideMenu("diesel-hisab-master");
            if (fullAccess === "True" || viewAccess === "True") {
                 getVehicleNumber();
                 getDriverMaster();
                 getVendorMaster();
                makeFieldsReadOnly();
                var tripid = GetParameterValues('tripid');
                getDieselHisabById(tripid);
            }
        });

        function makeFieldsReadOnly() {
                    // Textboxes - Set as readonly
                 $("#txtTripNumber").prop("readonly", true);
                 $("#txtLastTripStartDate").prop("readonly", true);
                 $("#txtLastTripEndDate").prop("readonly", true);
                 $("#txtLastTripVendor").prop("readonly", true);
                 $("#txtLastTripDriver").prop("readonly", true);
                 $("#txtLastTripDriverFather").prop("readonly", true);
                 $("#txtDriverFatherName").prop("readonly", true);
                 $("#from-date-picker").prop("readonly", true);
                 $("#to-date-picker").prop("readonly", true);
                 $("#txtStartOdometer").prop("readonly", true);
                 $("#txtEndOdometer").prop("readonly", true);
                 $("#txtRunningKm").prop("readonly", true);
                 $("#txtOpeningDiesel").prop("readonly", true);
                 $("#txtRouteDescription").prop("readonly", true);
                 $("#txt-filling-date").prop("readonly", true);
                 $("#txtLitre").prop("readonly", true);

                 // TextArea - Set as readonly
                 $("#txtLastTripRouteDesc").prop("readonly", true);

                 // Dropdowns - Disable
                 $("#ddlVehicleNo").prop("disabled", true);
                 $("#ddlDriver").prop("disabled", true);
                 $("#ddlVendor").prop("disabled", true);
            $("#ddlRouteName").prop("disabled", true);
            $("#ddlDriverScore").prop("disabled", true);

                 // Button - Disable
                 $("#btnAddFilling").prop("disabled", true);

        }

        function getDieselHisabById(tripid) {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DieselHisab/getDieselHisablWithId")',
                type: "GET",
                data: { tripid: tripid },
                dataType: "json",
                success: function (data) {

                   console.log('gaurave');
                  console.log(data);
                    if (data != null && data != undefined) {

                        $("#ddlVehicleNo").val(data.vehicleNo).trigger('change');
                 $('#txtTripNumber').val(data.tripId);

                 //New Trip
                        $("#ddlDriver").val(data.driverId).trigger('change');
                 $("#txtDriverFatherName").val(data.driverFatherName);
                 $("#from-date-picker").val(data.tripStartDate);
                 $("#to-date-picker").val(data.tripEndDate);
                 $("#txtStartOdometer").val(data.startOdometer);
                 $("#txtEndOdometer").val(data.endOdometer);
                 $("#txtRunningKm").val(data.runningKm);
                 $("#txtOpeningDiesel").val(data.openingDiesel);
                 $("#txtRouteDescription").val(data.lastTripRouteDescr);

                        $("#txtClosingDiesel").val(data.closingDiesel);

                        $("#txtDiscountPer").val(data.discountPer);
                        $("#txtDieselRate").val(data.dieselRate);

                        $('#ddlRouteName').val(data.routeNameId).trigger('change');
                        $('#ddlDriverScore').val(data.driverScoreId).trigger('change');
                        $("#txtDriverChangeRemarks").val(data.driverChnageRemarks);

                 //Last Trip Detail
                        if (data.lastTripHistory != null && data.lastTripHistory != undefined) { 
                        if (data.lastTripHistory.lastTripStartDate) { 
                   $("#txtLastTripStartDate").val(data.lastTripHistory.lastTripStartDate);
                        }
                        if (data.lastTripHistory.lastTripEndDate) { 
                    $("#txtLastTripEndDate").val(data.lastTripHistory.lastTripEndDate);
                        }
                    $("#txtLastTripRouteDesc").val(data.lastTripHistory.lastTripRouteDescr);
                    $("#txtLastTripDriver").val(data.lastTripHistory.lastTripDriver);
                    $("#txtLastTripDriverFather").val(data.lastTripHistory.lastTripDriverFatherName);
                    $("#txtLastTripVendor").val(data.lastTripHistory.lastTripVendor);
                        }

                 fillDieselFillingTable(data.dieselFillingList);
                        fillstationDetailsTable(data.stationList);
                    } else {
                        $.confirm({
                            title: 'Diesel Hisab',
                            content: 'Diesel Hisab does not Exists!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }

              function fillDieselFillingTable(dieselFillingList) {
            const table = document.getElementById("dieselFillingTable");

            dieselFillingList.forEach(entry => {
                const row = table.insertRow();

                // Format date if needed
                const fillingDate = entry.dieselFillingDate; // dd/mm/yyyy

                row.insertCell(0).textContent = fillingDate;

                const vendorIdCell = row.insertCell(1);
                vendorIdCell.textContent = entry.VendorId || ''; // If available
                vendorIdCell.style.display = 'none';

                row.insertCell(2).textContent = entry.vendorName;
                row.insertCell(3).textContent = entry.litre;
            });
        }


        function fillstationDetailsTable(stationDetailsList) {
            const table = document.getElementById("stationDetailsTable");

            stationDetailsList.forEach(entry => {
                const row = table.insertRow();

                
                const routeId = row.insertCell(0);
                routeId.textContent = entry.routeId; // If available
                routeId.style.display = 'none';

                const loadTypeId = row.insertCell(1);
                loadTypeId.textContent = entry.loadTypeId; // If available
                loadTypeId.style.display = 'none';

                row.insertCell(2).textContent = entry.routeDesc;
                row.insertCell(3).textContent = entry.distance;
                row.insertCell(4).textContent = entry.loadType;
                row.insertCell(5).textContent = entry.average;
                row.insertCell(6).textContent = entry.estimatedDiesel;              

                
            });
        }

        function downloadExcel() {
            var tripid = GetParameterValues('tripid');
            if (tripid) {
                window.location.href = '@Url.Action("DownloadDetailedExcelByTripId", "DieselHisab")?tripid=' + tripid;
            } else {
                alert("No Settlement ID found to download Excel.");
            }
        }
    </script>
}