<style>
    table {
        width: 100%;
        border-collapse: collapse;
       table-layout: fixed; 
    }

    table, th, td {
        font-size: 0.85em;
        border: 1px solid black;
        padding: 8px;
        text-align: center;
        word-wrap: break-word; /* Recommended for long words */
        font-weight: bold;
    }

    th {
        background-color: #f2f2f2;
        font-weight: normal;
    }

     th span[id^="xFillingDate"] { /* Target the date spans */
         font-size: 0.85em; /* Reduce font size (adjust as needed) */
         white-space: nowrap; /* Prevent text from wrapping */
     }

    .print-button {
        position: absolute;
        top: 10px;
        right: 10px;
        cursor: pointer;
        background-color: #4CAF50;
        color: white;
        padding: 10px 15px;
        border: none;
        border-radius: 5px;
    }

    .container {
        position: relative; /* Needed for absolute positioning of the button */
    }
</style>

<style media="print">
    table {
