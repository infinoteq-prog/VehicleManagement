@section scripts {
    <script>
        $(document).ready(function () {
            setSideMenu("diesel-hisab-master");
            var tripid = GetParameterValues('tripid');
            getDieselHisabById(tripid);
        });

        function getDieselHisabById(tripid) {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DieselHisab/getDieselHisablWithId")',
                type: "GET",
                data: { tripid: tripid },
                dataType: "json",
                success: function (data) {

                    console.log('gaurave');
                    console.log(data);
                    if (data != null && data != undefined) {
                        
                        var totalFillingQty=0;
                        var totalRunKm = 0;
                        var totalEstimateDiesel = 0;
                        var totalConsumedDiesel = 0;
                        var totalDieselProfitLoss=0;
                        var totalAvgDieselValue=0;
                        var totalDieselFillingRow=0;

                        var totalKhaliKaKm=0;
                        var totalKhaliKaDiesel=0;
                        var totalLoadUnloadDiesel=0;
                        var totalDiscountValue=0;

                         // $("#driverName").html(`Driver Name: <span>${data.driverName}</span>`);
                        $("#driverName").text(data.driverName);
                        $("#vehicleNumber").text(data.vehicleNumber);
                        $("#tripStartDate").text(data.tripStartDate);
                        $("#tripEndDate").text(data.tripEndDate);
                        $("#srNo").text(` `+data.tripId);
                        $("#odoMeterStart").text(data.startOdometer);
                        $("#odoMeterEnd").text(data.endOdometer);
                        $("#totalRunningKm").text(data.runningKm);
                        $("#userName").text(data.dieselHeaderCreatedByName);
                        $("#userName1").text(data.dieselHeaderCreatedByName);
                        $("#currentDate").text(data.dieselHeaderCreationDate);
                        totalDiscountValue = data.discountValue;
                        
                        //Diesel Filling    
                        data.dieselFillingList.forEach((entry, index) => {
                            totalDieselFillingRow=index+1;
                            const xFillingDate = `xFillingDate${index}`;
                            const xFillingPumpName = `xFillingPumpName${index}`;
                            const xFillingQty = `xFillingQty${index}`;
                            totalFillingQty=parseFloat(totalFillingQty)+ parseFloat(entry.litre);
                            try { 
                            $(`#${xFillingDate}`).text(entry.dieselFillingDate);
                            $(`#${xFillingPumpName}`).text(entry.vendorName);
                            $(`#${xFillingQty}`).text(entry.litre);
                        }catch{}
                        });

                        
                        try{
                        $("#openingBalance").text(data.openingDiesel);
                        $("#closingBalance").text(data.closingDiesel);
                        totalConsumedDiesel=((parseFloat(data.openingDiesel) + parseFloat(totalFillingQty)) - parseFloat(data.closingDiesel));
                        $("#dieselConsumed").text(totalConsumedDiesel);
                        }
                        catch{}

                        //Station Details
                        data.stationList.forEach((entry, index) => {
                            const station = `stationdetail_station${index}`; 
                            const km = `stationdetail_km${index}`;
                            const avg = `stationdetail_Avg${index}`;
                            const avgDiesel = `stationdetail_AvgDiesel${index}`;
                            const loadType = `stationdetail_loadType${index}`;
                            try {

                                if(entry.loadType=="KHALI")
                                {
                                    totalKhaliKaKm=totalKhaliKaKm+entry.distance;
                                    if (parseFloat(entry.average)>0)
                                    totalKhaliKaDiesel=totalKhaliKaDiesel+(entry.distance / entry.average);
                                }

                                if (entry.routeDesc.toUpperCase() === "LOADING/UNLOADING") {
                                    if (parseFloat(entry.average) > 0)
                                        totalLoadUnloadDiesel = totalLoadUnloadDiesel + entry.estimatedDiesel;
                                }
                                $(`#${station}`).text(entry.routeDesc);
                                $(`#${loadType}`).text(entry.loadType);
                                $(`#${km}`).text(entry.distance);
                                $(`#${avg}`).text(entry.average); 
                                 $(`#${avgDiesel}`).text(entry.estimatedDiesel);
                                 avgDieselValue=entry.estimatedDiesel;
                                // var avgDieselValue = 0;
                                // try {
                                //     avgDieselValue = entry.distance / entry.average;
                                //     $(`#${avgDiesel}`).text(avgDieselValue.toFixed(2));
                                // } catch (error) {
                                //     console.error("Error calculating average diesel:", error);
                                //     $(`#${avgDiesel}`).text("Error"); // Display an error message to the user
                                // }

                                totalRunKm = totalRunKm + entry.distance;
                                totalEstimateDiesel = totalEstimateDiesel+ avgDieselValue;
                                totalAvgDieselValue=totalAvgDieselValue+avgDieselValue;
                        }catch{}
                        });
                        $("#totalRunKm").text(totalRunKm.toFixed(2));// Total Run Kilometer
                        $("#totalEstimateDiesel").text(totalEstimateDiesel.toFixed(2));// Total Estimate Diesel


                        try
                        {
                            //Khali ka Diesel
                            $("#khaliKaDisel").text(Math.round(parseFloat(totalKhaliKaDiesel)));
                            $("#khaliKaKiloMeter").text(Math.round(parseFloat(totalKhaliKaKm)));
                            $("#bhariKaDiesel").text(Math.round((parseFloat(totalConsumedDiesel) - parseFloat(totalKhaliKaDiesel) - parseFloat(totalLoadUnloadDiesel))));
                            $("#bhariKaKilometer").text(Math.round((parseFloat(totalRunKm) - parseFloat(totalKhaliKaKm))));
                            if ((parseFloat(totalConsumedDiesel) - parseFloat(totalKhaliKaDiesel)) > 0) {
                                $("#bhariKaAverage").text(((parseFloat(totalRunKm) - parseFloat(totalKhaliKaKm)) / (parseFloat(totalConsumedDiesel) - parseFloat(totalKhaliKaDiesel) - parseFloat(totalLoadUnloadDiesel))).toFixed(2));
                            }else{
                                $("#bhariKaAverage").text("0");
                            }
                            totalDieselProfitLoss = (parseFloat(totalEstimateDiesel) - parseFloat(totalConsumedDiesel) -  totalDiscountValue).toFixed(2);
                            $("#discountValue").text(totalDiscountValue.toFixed(2));
                            $("#dieselProfitLoss").text(totalDieselProfitLoss);

                            var percentageLoss=parseFloat((parseFloat(totalDieselProfitLoss)*100) / parseFloat(totalAvgDieselValue) ).toFixed(2);
                            $("#percentageOfLoss").text(percentageLoss);
                            $("#khaliBhariTotalKi").text(((parseFloat(totalRunKm) / parseFloat(totalConsumedDiesel))).toFixed(2));
                        }
                        catch{}
                        
                        $("#naamDaalneWala").text('');
                        $("#dieselJyadaAaneKaKaran").text('');
                        $("#solution").text('');


                    } else {
                        $.confirm({
                            title: 'Diesel Hisab',
                            content: 'Diesel Hisab does not Exists!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
        </script>

    @* Print script *@
    <script>
        function prepareForPrint() {
