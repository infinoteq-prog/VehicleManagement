@section scripts {
<script>
    function prepareForPrint() {
        let container = document.querySelector('.container');
        if (container) {
            // Hide all elements except the container's contents
            let allElements = document.querySelectorAll('body *');
            allElements.forEach(el => {
                el.style.visibility = 'hidden';
            });
            container.querySelectorAll('*').forEach(el => {
                el.style.visibility = 'visible';
            });
            container.style.position = 'absolute';
            container.style.left = '0';
            container.style.top = '0';
        }
        window.print();

        // Attempt to restore styles (this is the tricky part)
        setTimeout(function () { // Use setTimeout to delay restoration
            window.location.reload(); // Simplest way: just reload the page
        }, 100); // Small delay, adjust if needed
    }
</script>
