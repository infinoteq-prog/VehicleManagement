    function calculateEstkm() {
        var distance = ($("#txtDistance").val()) || 0;
        var average = ($("#txtAverage").val()) || 0;
        var Estkm = 0;

        if (average !== 0) {
            Estkm = (distance / average).toFixed(2);
        } else {
            Estkm = "0.00";
        }

        // Update the Estkm display (assuming you have an element with id 'txtEstDiesel')
        $("#txtEstDiesel").val(Estkm); //  Make sure you have an input with id txtEstDiesel
        console.log("Calculated Estkm:", Estkm); // Good for debugging
    }

