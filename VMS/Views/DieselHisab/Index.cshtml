    function getCurrentTripNumber(vehicleNo) {
        $.ajax({
            cache: false,
            url: '@(utilityHelper.SiteUrl() + "DieselHisab/getCurrentTripNumber")',
            type: "GET",
            data: { vehicleNo: vehicleNo },
            dataType: "json",
            success: function (data) {
                if (data != null && data != undefined) {
                    $("#txtTripNumber").val(data.tripId);
                    getLastDieselTripHistory(vehicleNo);
                } else {
                    console.log(data);
                }
            }
        });
    }

    function getLastDieselTripHistory(vehicleNo) {
        $.ajax({
            cache: false,
            url: '@(utilityHelper.SiteUrl() + "DieselHisab/getLastDieselTripHistory")',
            type: "GET",
            data: { vehicleNo: vehicleNo },
            dataType: "json",
                success: function (data) {  
                if (data != null && data != undefined) {
                    $("#txtLastTripStartDate").val(data.lastTripStartDate);
                    $("#txtLastTripEndDate").val(data.lastTripEndDate);
                    $("#txtLastTripRouteDesc").val(data.lastTripRouteDescr);
                    $("#txtLastTripDriver").val(data.lastTripDriver);
                    $("#txtLastTripDriverFather").val(data.lastTripDriverFatherName);
                    $("#txtLastTripVendor").val(data.lastTripVendor);
                } else {
                    $("#txtLastTripStartDate").val("N/A");
                    $("#txtLastTripEndDate").val("N/A");
                    $("#txtLastTripRouteDesc").val("N/A");
                    $("#txtLastTripDriver").val("N/A");
                    $("#txtLastTripDriverFather").val("N/A");
                    $("#txtLastTripVendor").val("N/A");
                    $("#txtOpeningDiesel").val("0")

                    $.confirm({
                        title: 'Last Trip Not Found',
                        content: 'Vehicle - ' + $("#ddlVehicleNo option:selected" ).text() + ' Last Trip Not Found!',
                        icon: 'fa fa-warning',
                        type: 'red',
                        buttons: {
                            omg: {
                                text: 'OK',
                                btnClass: 'btn-red',
                            },
                        }
                    });
                    console.log(data);
                }
            }
        });
    }

    function calculateRunningKm(){
        if($("#txtStartOdometer").val() != "" && $("#txtEndOdometer").val() != ""){
            var startOdometer = parseInt($("#txtStartOdometer").val());
            var endOdometer = parseInt($("#txtEndOdometer").val());
            var runningKm = endOdometer - startOdometer;

            if(startOdometer > endOdometer){
                $.confirm({
                    title: 'Start Odometer Cannot be Greater',
                    content: 'Start Odometer cannot be greater than End Odometer!',
                    icon: 'fa fa-warning',
                    type: 'red',
                    buttons: {
                        omg: {
                            text: 'OK',
                            btnClass: 'btn-red',
                        },
                    }
                });
                $("#txtRunningKm").val("");
            }else if(startOdometer == endOdometer){
                $.confirm({
                    title: 'Start and End Odometer Cannot be Equal',
                    content: 'Start Odometer cannot be equal to End Odometer!',
                    icon: 'fa fa-warning',
                    type: 'red',
                    buttons: {
                        omg: {
                            text: 'OK',
                            btnClass: 'btn-red',
                        },
                    }
                });
                $("#txtRunningKm").val("");
            }else{
                $("#txtRunningKm").val(runningKm);
            }
        }
    }

    function saveDriverMaster() {
        var isValid = checkValidation();
        if (isValid == true) {
                if ($('#ddlVehicleNo option:selected').val() != "0" &&
                $('#ddlDriver option:selected').val() != "0" &&
                $("#txtTripNumber").val() != "" &&
                $("#txtFatherName").val() != "" &&
                $("#txtStartOdometer").val() != "" &&
                $("#txtEndOdometer").val() != "" &&
                $("#txtRunningKm").val() != "" &&
                $("#from-date-picker").val() != "" &&
                $("#to-date-picker").val() != "" && 
                $("#txtOpeningDiesel").val() != "" &&
                $("#txtRouteDescription").val() != ""){

                var tripStartDate = $("#from-date-picker").val().split("-").reverse().join("-");
                var tripEndDate = $("#to-date-picker").val().split("-").reverse().join("-");

                var formData = new FormData();
                formData.append("vehicleNo", $("#ddlVehicleNo option:selected").val());
                formData.append("driverId", $("#ddlDriver option:selected").val());
                formData.append("tripNo", $('#txtTripNumber').val());
                formData.append("driverName", $("#ddlDriver option:selected").text());
                formData.append("driverFatherName", $("#txtFatherName").val());
                formData.append("tripStartDate", tripStartDate);
                formData.append("tripEndDate", tripEndDate);
                formData.append("startOdometer", $("#txtStartOdometer").val());
                formData.append("endOdometer", $("#txtEndOdometer").val());
                formData.append("openingDiesel", $("#txtOpeningDiesel").val());
                formData.append("tripRouteDescription", $("#txtRouteDescription").val());
               
                $.ajax({
                    cache: false,
                    url: '@(utilityHelper.SiteUrl() + "DieselHisab/Save")',
                    type: "POST",
                    dataType: "json",
                    processData: false,
                    contentType: false,
                    data: formData,
                    success: function (data) {
                        if (data != null && data != undefined) {
                            if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                console.log(data);
                                $.confirm({
                                    title: 'Save Diesel Hisab!',
                                        content: "Diesel Hisab has been saved successfully!",
                                    type: 'green',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-green',
                                            action: function () {
                                                //getUserList();
                                                //clearControls();
                                                window.location.href = '@(utilityHelper.SiteUrl() + "DriverMaster/Index")';
                                            }
                                        },
                                    }
                                });
                            } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                $.confirm({
                                    title: 'Diesel Hisab Already Exists!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divDieslHisabMaster").hide();
                            }
                        } else {
                            console.log(data);
                            //clearControls();
                            $.confirm({
                                title: 'Error Occoured!',
                                content: data.transactionMessage.message,
                                icon: 'fa fa-warning',
                                type: 'red',
                                buttons: {
                                    omg: {
                                        text: 'OK',
                                        btnClass: 'btn-red',
                                    },
                                }
                            });
                            $("#divDieslHisabMaster").hide();
                        }
                    }
                });
            }
        }
    }

    function getDriverFather(){
        var driverMasterId = $('#ddlDriver option:selected').val();
        $.ajax({
            cache: false,
            url: '@(utilityHelper.SiteUrl() + "DriverMaster/getDriverFather")',
            type: "GET",
            data: { driverMasterId: driverMasterId },
            dataType: "json",
            success: function (data) {
                if (data != null && data != undefined) {
                    console.log(data);
                        $("#txtDriverFatherName").val(data.driverFatherName);
                } else {
                    console.log(data);
                }
            }
        });
    }

    function getDieselHisabByVehicle() {
        var vehicleNo = $('#ddlVehicleNo option:selected').val();
        if ($.fn.DataTable.isDataTable("#tblDieselHisabMaster")) {
            $('#tblDieselHisabMaster tbody').empty();
            $('#tblDieselHisabMaster').DataTable().clear().destroy();
        }
        $.ajax({
            cache: false,
            url: '@(utilityHelper.SiteUrl() + "DieselHisab/getDieselHisablListByVehicle")',
            type: "GET",
            data: { vehicleNo: vehicleNo },
            dataType: "json",
            success: function (data) {
                console.log(data);
                if (data != null && data != undefined) {
                    $.each(data, function (i, item) {
                        var sno = 0;
                        var rows = "";
                        var row = "";
                        sno = sno + 1;
                        if (fullAccess === "True" || viewAccess === "True") {
                            viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewUserSubscription(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || updateAccess === "True") {
                            updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editUserSubscription(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || deleteAccess === "True") {
                            deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteUserSubscription(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                        }
                        row = '<tr>' +
                            '<td>' +
                            '<div class="d-flex align-items-center">' +
                            viewButton +
                            updateButton +
                            deleteButton +
                            '</div>' +
                            '</td>' +
                            '<td>' + item.vehicleNo + '</td>' +
                            '<td>' + item.tripId + '</td>' +
                            '<td>' + item.driverName + '</td>' +
                            '<td>' + item.driverFatherName + '</td>' +
                            '<td>' + item.openingDiesel + '</td>' +
                            '<td>' + item.startOdometer + '</td>' +
                            '<td>' + item.endOdometer + '</td>' +
                            '<td>' + item.runningKm + '</td>' +
                            '<td>' + item.isActive + '</td>' +
                            '<td>' + item.createDate + '</td>' +
                            '<td>' + item.createdBy + '</td>' +
                            '<td>' + item.updateDate + '</td>' +
                            '<td>' + item.updateBy + '</td>' +
                            '</tr>';
                            rows = rows + row;
                            $("#DieselHisabMasterBody").append(rows);
                        rows = "";
                        $("#tblDieselHisabMaster").focus();
                    });
                    bindDataTable();
                } else {
                    var row = '<tr>' +
                        '<td colspan="14" style="text-align:center">No Data Found!!!</td>' +
                        '</tr>';
                        $("#DieselHisabMasterBody").html(row);
                }
            },
            error: function (ex) {
                alert(ex);
            }
        });
    }
</script>
