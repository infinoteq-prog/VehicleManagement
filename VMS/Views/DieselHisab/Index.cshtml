                                            @Html.TextAreaFor(m => m.LastTripRouteLine, new { @class = "form-control", cols = "10", rows = "5", id = "txtLastTripRouteDesc", @readonly="readonly" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripVendor">LastTrip Vendor:</label>
