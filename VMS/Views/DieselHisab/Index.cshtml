    <script>
           // Add Diesel Filling Record
           function addDieselFilling() {
               const fillingDate = document.getElementById('txt-filling-date').value;
               const vendorId = $("#ddlVendor option:selected").val();
               const vendorName = $("#ddlVendor option:selected").text();
               const litre = document.getElementById('txtLitre').value;
           
               if (!fillingDate || !vendorId || !litre) {
                   alert('Please fill all fields');
                   return;
               }
           
               const table = document.getElementById('dieselFillingTable').getElementsByTagName('tbody')[0];
           
               // // Check if the vendorId already exists in the table
               // for (let i = 0; i < table.rows.length; i++) {
               //     const existingVendorId = table.rows[i].cells[1].textContent;
               //     if (existingVendorId === vendorId) {
               //         alert('This vendor already exists in the table.');
               //         return;
               //     }
               // }
           
               const row = table.insertRow();           
               row.insertCell(0).textContent = fillingDate;
               const vendorIdCell = row.insertCell(1);
                vendorIdCell.textContent = vendorId;
                vendorIdCell.style.display = 'none';
               row.insertCell(2).textContent = vendorName;
               row.insertCell(3).textContent = litre;
           
               const actionsCell = row.insertCell(4);
               actionsCell.innerHTML = `
                   <button class="btn btn-danger btn-sm" onclick="deleteFillingRecord(this)">Delete</button>
               `;

               clearFillingForm();
           }


            // Clear Form Fields after Adding Record
            function clearFillingForm() {
                document.getElementById('txt-filling-date').value = '';
                document.getElementById('ddlVendor').selectedIndex = 0;
                document.getElementById('txtLitre').value = '';
            }

            // Delete Diesel Filling Record
            function deleteFillingRecord(button) {
