    @* Station Detail Section  *@
    <script>

        function addStationDetails() {
            const stationId = $("#ddlDistanceMaster option:selected").val();
            const loadTypeId = $("#ddlLoadType option:selected").val();
            const station = $("#ddlDistanceMaster option:selected").text();
            const distance = $("#txtDistance").val();
            const loadType = $("#ddlLoadType option:selected").text();
            const average = $("#txtAverage").val();
            const estKm = $("#txtEstDiesel").val();
            const addDifferenceChecked = document.getElementById('addDifference').checked; // Get the boolean value
            const addLoadingUnloadingChecked = document.getElementById('addLoadingUnloading').checked;

            if (!station || !distance || !loadType || !average || !estKm) {
                alert("Please fill all required fields.");
                return;
            }

            const table = document.getElementById('stationDetailsTable').getElementsByTagName('tbody')[0];

            // Check if the stationId already exists in the table, excluding the difference row
            for (let i = 0; i < table.rows.length; i++) {
                const row = table.rows[i];
                if (row.id !== 'differenceRow' && row.id !== 'loadingUnloadingRow' && row.id !== 'totalRow') { // Exclude the difference row from the check
                    const existingStationId = row.cells[0].textContent;
                    if (existingStationId === stationId) {
                        alert('This station already exists in the table.');
                        return;
                    }
                }
            }

            let row;
            //insert row before the difference row if it exists
            const differenceRow = document.getElementById('differenceRow');
            const loadingUnloadingRow = document.getElementById('loadingUnloadingRow');
            const totalRow = document.getElementById('totalRow');
            if (differenceRow) {
                row = table.insertRow(differenceRow.rowIndex - 1);
            }
            else if (loadingUnloadingRow) {
                row = table.insertRow(loadingUnloadingRow.rowIndex - 1);
            }
            else if (totalRow) {
                row = table.insertRow(totalRow.rowIndex - 1);
            }
            else {
                row = table.insertRow();
            }


            const stationidCell = row.insertCell(0);
            stationidCell.textContent = stationId;
            stationidCell.style.display = 'none';
            const loadTypeIdCell = row.insertCell(1);
            loadTypeIdCell.textContent = loadTypeId;
            loadTypeIdCell.style.display = 'none';

            row.insertCell(2).textContent = station;
            row.insertCell(3).textContent = distance;
            row.insertCell(4).textContent = loadType;
            row.insertCell(5).textContent = average;
            row.insertCell(6).textContent = estKm;

            const actionsCell = row.insertCell(7);
            actionsCell.innerHTML = `<button class="btn btn-danger btn-sm" onclick="deleteStationRow(this)">Delete</button>`;


            // Clear inputs after adding
            $("#ddlDistanceMaster").val("");
            $("#txtDistance").val("");
            $("#ddlLoadType").val("");
            $("#txtAverage").val("");
            $("#txtEstDiesel").val("");

            //Call addDifferenceLine and addLoadingUnloadingLine to make sure the difference row is at the last
            if (document.getElementById('addDifference').checked) {
                addDifferenceLine();
            }
            if (document.getElementById('addLoadingUnloading').checked) {
                addLoadingUnloadingLine();
            }
            addTotalRow();

            // Example of appending the checkbox value to formData:
            const formData = new FormData();
            formData.append("stationId", stationId);
            formData.append("loadTypeId", loadTypeId);
            formData.append("station", station);
            formData.append("distance", distance);
            formData.append("loadType", loadType);
            formData.append("average", average);
            formData.append("estKm", estKm);
            formData.append("addDifference", addDifferenceChecked); // Append the checkbox value
            formData.append("addLoadingUnloading", addLoadingUnloadingChecked);
            // ... append other form data ...
        }

        function deleteStationRow(btn) {
            $(btn).closest("tr").remove();
            addTotalRow();
        }

        function editStationRow(btn) {
            const row = $(btn).closest("tr");
            const tds = row.find("td");

            // Set back values to fields
            $("#ddlDistanceMaster").val(tds.eq(0).text());
            $("#txtDistance").val(tds.eq(1).text());
            $("#ddlLoadType").val(tds.eq(2).text());
            $("#txtAverage").val(tds.eq(3).text());
            $("#txtEstDiesel").val(tds.eq(4).text());

            // Remove the row so it can be re-added after editing
            row.remove();
        }
    </script>

    @* DieselHisab Update Section  *@
    <script>

        function getDieselHisabByID(tripId) {
            clearControls();

            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DieselHisab/getDieselHisablWithId")',
                type: "GET",
                data: { tripId: tripId },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {

                        $('#hdnDieselHisabID').val(data.tripId);
                        $('#hdnLastTripId').val(data.lastTripId);
                        //Setting Diesel Hisab Details to Page Controls
                        // Dropdowns - Disable
                        $("#ddlVehicleNo").prop("disabled", true);
                        $("#ddlVehicleNo").val(data.vehicleNo);
                        $('#txtTripNumber').val(data.tripId);

                        //New Trip
                        $("#ddlDriver").val(data.driverId);
                        $("#txtDriverFatherName").val(data.driverFatherName);
                        $("#from-date-picker").val(data.tripStartDate);
                        $("#to-date-picker").val(data.tripEndDate);
                        $("#txtStartOdometer").val(data.startOdometer);
                        $("#txtEndOdometer").val(data.endOdometer);
                        $("#txtRunningKm").val(data.runningKm);
                        $("#txtOpeningDiesel").val(data.openingDiesel);
                        $("#txtClosingDiesel").val(data.closingDiesel);
                        $("#txtRouteDescription").val(data.lastTripRouteDescr);

                        //Last Trip Detail
                        try
                        {
                        $("#txtLastTripStartDate").val(data.lastTripHistory.lastTripStartDate);
                        $("#txtLastTripEndDate").val(data.lastTripHistory.lastTripEndDate);
                        $("#txtLastTripRouteDesc").val(data.lastTripHistory.lastTripRouteDescr);
                        $("#txtLastTripDriver").val(data.lastTripHistory.lastTripDriver);
                        $("#txtLastTripDriverFather").val(data.lastTripHistory.lastTripDriverFatherName);
                        $("#txtLastTripVendor").val(data.lastTripHistory.lastTripVendor);
                        }catch{}

                        document.getElementById('addDifference').checked = data.IsDifferenceAdded;
                        document.getElementById('addLoadingUnloading').checked = data.IsLoadingAdded;

                        fillDieselFillingTable(data.dieselFillingList);
                        fillstationDetailsTable(data.stationList);

                        bindDataTable();
                    } else {
                       
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }

        function fillDieselFillingTable(dieselFillingList) {
            const table = document.getElementById('dieselFillingTable').getElementsByTagName('tbody')[0];
            dieselFillingList.forEach(entry => {
                const row = table.insertRow();

                // Format date if needed
                const fillingDate = entry.dieselFillingDate; // dd/mm/yyyy

                row.insertCell(0).textContent = fillingDate;

                const vendorIdCell = row.insertCell(1);
                vendorIdCell.textContent = entry.vendorId || ''; // If available
                vendorIdCell.style.display = 'none';

                row.insertCell(2).textContent = entry.vendorName;
                row.insertCell(3).textContent = entry.litre;
                const actionsCell = row.insertCell(4);
                actionsCell.innerHTML = `
                           <button class="btn btn-danger btn-sm" onclick="deleteFillingRecord(this)">Delete</button>
                       `;
            });
        }

        function fillstationDetailsTable(stationDetailsList) {
            const table = document.getElementById('stationDetailsTable').getElementsByTagName('tbody')[0];
            table.innerHTML = ''; // Clear the table body

            let differenceRowAdded = false;
            let loadingUnloadingRowAdded = false;

            stationDetailsList.forEach(entry => {
                if (entry.routeDesc === 'Difference') {
                    addDifferenceLine();
                    differenceRowAdded = true;
                    return; // Skip adding this as a regular row
                } 
                
                if (entry.routeDesc === 'Loading/Unloading') {
                    // addLoadingUnloadingLine();
                    // loadingUnloadingRowAdded = true;
                    // return; // Skip adding this as a regular row
                }

                const row = table.insertRow();

                const routeId = row.insertCell(0);
                routeId.textContent = entry.routeId;
                routeId.style.display = 'none';

                const loadTypeId = row.insertCell(1);
                loadTypeId.textContent = entry.loadTypeId;
                loadTypeId.style.display = 'none';

                row.insertCell(2).textContent = entry.routeDesc;
                row.insertCell(3).textContent = entry.distance;
                row.insertCell(4).textContent = entry.loadType;
                row.insertCell(5).textContent = entry.average;
                row.insertCell(6).textContent = entry.estimatedDiesel;

                const actionsCell = row.insertCell(7);
                actionsCell.innerHTML = `<button class="btn btn-danger btn-sm" onclick="deleteStationRow(this)">Delete</button>`;
            });
            //check box should be checked or unchecked based on the data
            if (differenceRowAdded) {
                document.getElementById('addDifference').checked = true;
            } else {
                document.getElementById('addDifference').checked = false;
            }
            if (loadingUnloadingRowAdded) {
                document.getElementById('addLoadingUnloading').checked = true;
            } else {
                document.getElementById('addLoadingUnloading').checked = false;
            }
            addTotalRow();
        }

        function addTotalRow() {
            const table = document.getElementById('stationDetailsTable').getElementsByTagName('tbody')[0];
            let row;
            if (document.getElementById('totalRow')) {
                table.removeChild(document.getElementById('totalRow'));
            }
            row = table.insertRow();
            row.id = 'totalRow';

            const routeId = row.insertCell(0);
            routeId.style.display = 'none';

            const loadTypeId = row.insertCell(1);
            loadTypeId.style.display = 'none';

            row.insertCell(2).textContent = "Total";
            let totalDistance = 0;
            let totalEstKm = 0;
            for (let i = 0; i < table.rows.length - 1; i++) {
                if (table.rows[i].id !== 'differenceRow' && table.rows[i].id !== 'loadingUnloadingRow') {
                    totalDistance += Number(table.rows[i].cells[3].textContent);
                    totalEstKm += Number(table.rows[i].cells[6].textContent);
                }
            }
            row.insertCell(3).textContent = totalDistance.toFixed(0)
            row.insertCell(4).textContent = "";
            row.insertCell(5).textContent = "";
            row.insertCell(6).textContent = totalEstKm.toFixed(2)
            row.insertCell(7).textContent = "";
        }
    </script>

    @* Check box select unselect FOR DIFFERENCE *@
    <script>

        function handleCheckboxChange_AddDifference(checkbox) {
            if (checkbox.checked) {
              console.log("Checkbox is checked");
                addDifferenceLine();
            } else {
              console.log("Checkbox is unchecked");
                deleteDifferenceLine();
            }
        }

        function addDifferenceLine() {
            const table = document.getElementById('stationDetailsTable').getElementsByTagName('tbody')[0];
            let row;

            // Check if the difference row already exists
            if (document.getElementById('differenceRow')) {
                // If it exists, remove it before adding a new one
                table.removeChild(document.getElementById('differenceRow'));
            }
            // Check if the total row exists
            if (document.getElementById('totalRow')) {
                row = table.insertRow(table.rows.length - 1); // Insert before total
            }
            else {
                row = table.insertRow();
            }
            row.id = 'differenceRow'; // Set an ID for the row

            const routeId = row.insertCell(0);
            routeId.textContent = 0;
            getRouteId()
                .then(distanceId => {
                    console.log("DistanceId:", distanceId);
                    let myDistanceId = distanceId;
                    routeId.textContent = myDistanceId; // If available
                })
                .catch(error => {
                    console.error("Error:", error);
                });

            routeId.style.display = 'none';

            const loadTypeId = row.insertCell(1);
            loadTypeId.textContent = 22; // 22 is for UL
            loadTypeId.style.display = 'none';

             let totalDistance = 0;
            for (let i = 0; i < table.rows.length - 1; i++) {
                if (table.rows[i].id !== 'differenceRow' && table.rows[i].id !== 'loadingUnloadingRow' && table.rows[i].id !== 'Total') {
                    totalDistance += Number(table.rows[i].cells[3].textContent);
                }
            }

            let totalKm = Math.round($("#txtRunningKm").val());
            row.insertCell(2).textContent = "Difference";
            row.insertCell(3).textContent = Math.round((totalKm - totalDistance));
            row.insertCell(4).textContent = "UL";
            row.insertCell(5).textContent = 2.9;
            row.insertCell(6).textContent =Math.round((totalKm - totalDistance)/2.9);

            const actionsCell = row.insertCell(7);
            actionsCell.innerHTML = `<button class="btn btn-danger btn-sm" onclick="deleteStationRow(this)">Delete</button>`;
        }

        function deleteDifferenceLine() {
            const table = document.getElementById('stationDetailsTable').getElementsByTagName('tbody')[0];
            const rowToDelete = document.getElementById('differenceRow');
            if (rowToDelete) {
                table.deleteRow(rowToDelete.rowIndex - 1);
            }
        }

        function getRouteId() {
            return new Promise((resolve, reject) => {
                const url = '@(utilityHelper.SiteUrl() + "DieselHisab/getDifferenceRouteMasterId")'; // Get URL

                fetch(url) // Use fetch API
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! Status: ${response.status}`);
                        }
                        return response.json(); // Parse the JSON response
                    })
                    .then(data => {
                        console.log(data);
                        if (data && data.DistanceId) {
                            resolve(data.DistanceId);
                        } else {
                            reject("DistanceId not found in response.");
                        }
                    })
                    .catch(error => {
                        console.error("Fetch error:", error);
                        reject("Fetch request failed: " + error.message);
                    });
            });
        }
    </script>

