    function calculateRunningKm(){
        if($("#txtStartOdometer").val() != "" && $("#txtEndOdometer").val() != ""){
            var startOdometer = parseInt($("#txtStartOdometer").val());
            var endOdometer = parseInt($("#txtEndOdometer").val());
            var runningKm = endOdometer - startOdometer;

            if(startOdometer > endOdometer){
                $.confirm({
                    title: 'Start Odometer Cannot be Greater',
                    content: 'Start Odometer cannot be greater than End Odometer!',
                    icon: 'fa fa-warning',
                    type: 'red',
                    buttons: {
                        omg: {
                            text: 'OK',
                            btnClass: 'btn-red',
                        },
                    }
                });
                $("#txtRunningKm").val("");
            }else if(startOdometer == endOdometer){
                $.confirm({
                    title: 'Start and End Odometer Cannot be Equal',
                    content: 'Start Odometer cannot be equal to End Odometer!',
                    icon: 'fa fa-warning',
                    type: 'red',
                    buttons: {
                        omg: {
                            text: 'OK',
                            btnClass: 'btn-red',
                        },
                    }
                });
                $("#txtRunningKm").val("");
            }else{
                $("#txtRunningKm").val(runningKm);
            }
        }
    }

    function saveDieselHisab() {
        var isValid = checkValidation();
        if (isValid == true) {

                if ($('#ddlVehicleNo option:selected').val() != "0" &&
                $('#ddlDriver option:selected').val() != "0" &&
                $("#txtTripNumber").val() != "" &&
                $("#txtFatherName").val() != "" &&
                $("#txtStartOdometer").val() != "" &&
                $("#txtEndOdometer").val() != "" &&
                $("#txtRunningKm").val() != "" &&
                $("#from-date-picker").val() != "" &&
                $("#to-date-picker").val() != "" && 
                $("#txtOpeningDiesel").val() != "" &&
                $("#txtClosingDiesel").val() != "" &&
                $("#txtRouteDescription").val() != ""){

                var tripStartDate = $("#from-date-picker").val().split("-").reverse().join("-");
                var tripEndDate = $("#to-date-picker").val().split("-").reverse().join("-");

                var formData = new FormData();

                    var tripId = $('#hdnDieselHisabID').val();
                    if (tripId && tripId.length > 0 && parseInt(tripId[0]) > 0) {
                        formData.append("tripId", tripId);
                    }
                   
                    const addDifferenceChecked = document.getElementById('addDifference').checked; // Get the boolean value
                    const addLoadingUnloadingChecked = document.getElementById('addLoadingUnloading').checked;

                formData.append("lastTripId",  $("#hdnLastTripId").val());
                formData.append("vehicleNo", $("#ddlVehicleNo option:selected").val());
                formData.append("driverId", $("#ddlDriver option:selected").val());
                formData.append("tripNo", $('#txtTripNumber').val());
                formData.append("driverName", $("#ddlDriver option:selected").text());
                formData.append("driverFatherName", $("#txtFatherName").val());
                formData.append("tripStartDate", tripStartDate);
                formData.append("tripEndDate", tripEndDate);
                formData.append("startOdometer", $("#txtStartOdometer").val());
                formData.append("endOdometer", $("#txtEndOdometer").val());
                formData.append("openingDiesel", $("#txtOpeningDiesel").val());
                formData.append("closingDiesel", $("#txtClosingDiesel").val());
                formData.append("runningKm", $("#txtRunningKm").val());
                formData.append("tripRouteDescription", $("#txtRouteDescription").val());
                    formData.append("IsDifferenceAdded", addDifferenceChecked); // Append the checkbox value
                    formData.append("IsLoadingAdded", addLoadingUnloadingChecked);

                 // Diesel Filling Entries from Table
                   $("#dieselFillingTable tbody tr").each(function (index, row) {
                       var date = $(row).find("td:eq(0)").text();
                       var vendorId = $(row).find("td:eq(1)").text();
                       var litre = $(row).find("td:eq(3)").text();

                       formData.append(`_lstDieselFilling[${index}].DieselFillingDate`, date);
                       formData.append(`_lstDieselFilling[${index}].VendorId`, vendorId);
                       formData.append(`_lstDieselFilling[${index}].DieselQty`, litre);
                   });

                    // Diesel Line Entries from Table
                    $("#stationDetailsTable tbody tr").each(function (index, row) {
                       
                        var routeId = $(row).find("td:eq(0)").text();
                        var routeDesc = $(row).find("td:eq(2)").text();                        
                        var Distance = $(row).find("td:eq(3)").text();
                        var LoadType = $(row).find("td:eq(4)").text();
                        var Average = $(row).find("td:eq(5)").text();
                        var EstimatedDiesel = $(row).find("td:eq(6)").text();
                        if (routeDesc !== 'Total') {
                            formData.append(`_lstDieselLine[${index}].RouteId`, routeId);
                            formData.append(`_lstDieselLine[${index}].RouteDesc`, routeDesc);
                            formData.append(`_lstDieselLine[${index}].LoadType`, LoadType);
                            formData.append(`_lstDieselLine[${index}].Distance`, Distance);
                            formData.append(`_lstDieselLine[${index}].Average`, Average);
                            formData.append(`_lstDieselLine[${index}].EstimatedDiesel`, EstimatedDiesel);
                        }
                    });
               
                $.ajax({
                    cache: false,
                        url: '@(utilityHelper.SiteUrl() + "DieselHisab/SaveUpdate")',
                    type: "POST",
                    dataType: "json",
                    processData: false,
                    contentType: false,
                    data: formData,
                    success: function (data) {
                        if (data != null && data != undefined) {
                            if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                console.log(data);
                                $.confirm({
                                    title: 'Save Diesel Hisab!',
                                        content: "Diesel Hisab has been saved successfully!",
                                    type: 'green',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-green',
                                            action: function () {
                                                //getUserList();
                                                //clearControls();
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "DieselHisab/List")';
                                            }
                                        },
                                    }
                                });
                            } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                $.confirm({
                                    title: 'Diesel Hisab Already Exists!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divDieslHisabMaster").hide();
                            }
                        } else {
                            console.log(data);
                            //clearControls();
                            $.confirm({
                                title: 'Error Occoured!',
                                content: data.transactionMessage.message,
                                icon: 'fa fa-warning',
                                type: 'red',
                                buttons: {
                                    omg: {
                                        text: 'OK',
                                        btnClass: 'btn-red',
                                    },
                                }
                            });
                            $("#divDieslHisabMaster").hide();
                        }
                    }
                });
            }
        }else{

        }
