@{
}
@model VMS.ViewModel.VMDieselHisab
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Diesel Hisab Add/Update";
}

<style>
       .form-check-inline {
            display: flex;
            align-items: center;
            margin-right: 1rem;
        }

        .form-check-input {
            margin-top: 0 !important;
            margin-right: 0.3rem;
        }

        .form-check-inline .form-check-label {
            margin-left: 0 !important;
        }
</style>

<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Add Diesel Hisab</h4>
                    <div>
                        <form id="frmVehicleMaster" name="frmVehicleMaster" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <input id="hdnDieselHisabID" name="hdnDieselHisabID" type="hidden">
                            <input id="hdnLastTripId" name="hdnLastTripId" type="hidden">
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <label id="lblMandatoryMessage" class="reqFields">@utilityHelper.reqFieldMessage</label>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlVehicleNo">Vehicle No:<span class="reqFields">*</span> </label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlVehicleNo" name="ddlVehicleNo" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtTripNumber">Trip Number:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtTripNumber" placeholder="Enter a trip number." class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-12">
                                    <div class="form-group row">
                                        <h5>Previous Trip History :</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripStartDate">LastTrip Start Date:</label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtLastTripStartDate" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripEndDate">LastTrip End Date:</label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtLastTripEndDate" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripRouteDesc">LastTrip Route Desc:</label>
                                        <div class="col-sm-8">
                                            @Html.TextAreaFor(m => m.LastTripRouteLine, new { @class = "form-control", cols = "10", rows = "5", id = "txtLastTripRouteDesc", @readonly="readonly" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripVendor">LastTrip Vendor:</label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtLastTripVendor" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripDriver">LastTrip Driver:</label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtLastTripDriver" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtEngineNo">LastTrip Driver Father: </label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtLastTripDriverFather" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                        <div class="row rowHeight">
                            <div class="col-md-12">
                                <div class="form-group row">
                                    <h5>New Trip Details:</h5>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card" style="padding: 15px; margin-bottom: 20px; border: 1px solid #ccc; border-radius: 6px;">
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtDriverName">Driver Name:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlDriver" name="ddlDriver" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtDriverFatherName">Driver Father Name: <span class="reqFields">*</span> </label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtDriverFatherName" class="form-control alphanumericonlywithspace" maxlength="100" onchange="setTextboxStyle(this);" placeholder="Please Enter Driver Father Name" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="from-date-picker">Trip Start Date : <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="from-date-picker" placeholder="Select From Date" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="to-date-picker">Trip End Date : <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="to-date-picker" placeholder="Select To Date" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtStartOdometer">Start Odometer:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtStartOdometer" class="form-control numberonly" maxlength="15" onchange="setTextboxStyle(this);" placeholder="Please Enter Start Odometer" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtEndOdometer">End Odometer: <span class="reqFields">*</span> </label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtEndOdometer" class="form-control numberonly" maxlength="15" onchange="setTextboxStyle(this);" placeholder="Please Enter End Odometer" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtRunningKm">Running Km:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtRunningKm" class="form-control numberonly" maxlength="20" readonly="readonly" onchange="setTextboxStyle(this);" placeholder="Please Enter Run Km" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtOpeningDiesel">Opening Diesel:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtOpeningDiesel" class="form-control numberonly" maxlength="20" onchange="setTextboxStyle(this);" placeholder="Please Enter Opening Diesel" />
                                        </div>
                                    </div>
                                </div>
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="txtClosingDiesel">Closing Diesel:<span class="reqFields">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" id="txtClosingDiesel" class="form-control numberonly" maxlength="20" onchange="setTextboxStyle(this);" placeholder="Please Enter Opening Diesel" />
                                            </div>
                                        </div>
                                    </div>
                            </div>
                        
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtRouteDescription">Route Desc :<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                                <textarea id="txtRouteDescription" class="form-control" maxlength="300" onchange="setTextboxStyle(this);" placeholder="Please Enter Route Description" rows="3"></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6"></div>
                            </div>
                        </div>


                        <!-- Diesel Filling Table -->
                       <div class="row rowHeight">
                        <div class="col-md-12">
                            <div class="form-group row">
                                <h5>Diesel Filling:</h5>
                            </div>
                        </div>
                      </div>

                    <div class="card" style="padding: 15px; margin-bottom: 20px; border: 1px solid #ccc; border-radius: 6px;">
                        <div class="row rowHeight">
                             <div class="col-md-3">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txt-filling-date">Date : <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txt-filling-date" placeholder="Select Filling Date" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                        </div>
                                    </div>
                                </div>
                            <div class="col-md-3">
                                <div class="form-group row">
                                    <label class="col-sm-4 col-form-label" for="ddlVendor">Vendor: <span class="reqFields">*</span></label>
                                    <div class="col-sm-8">
                                        <select class="form-control" id="ddlVendor" name="ddlVendor" onchange="setDropDownStyle(this);">
                                            <!-- Vendor options will be populated here from VendorMaster API -->
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group row">
                                    <label class="col-sm-4 col-form-label" for="txtLitre">Litre: <span class="reqFields">*</span></label>
                                    <div class="col-sm-8">
                                        <input type="text" id="txtLitre" class="form-control numberonly" maxlength="10" onchange="setTextboxStyle(this);" placeholder="Please Enter Litre" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group row">
                                    <div class="col-md-12">
                                        <button type="button" class="btn btn-primary" id="btnAddFilling" onclick="addDieselFilling();">Add</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table id="dieselFillingTable" class="table table-bordered">
                                        <thead class="thead-light">
                                    <tr>
                                        <th style="width: 120px;">Date</th>
                                        <th style="display:none;">VendorId</th>
                                        <th style="width: 120px;">Vendor</th>
                                        <th style="width: 120px;">Litre</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Table rows will be dynamically added here -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Station Details Section -->
                     <div class="row" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                         <div style="align-self: center;">
                             <h5>Station Details:</h5>
                         </div>
                         <div style="display: flex; align-items: center;">
                             <div class="form-check form-check-inline" style="margin-right: 15px;">
                                        <input class="form-check-input" type="checkbox" id="addLoadingUnloading" onchange="handleCheckboxChange_AddLoadingUnloading(this)">
                                 <label class="form-check-label" for="addLoadingUnloading">Add Loading/Unloading</label>
                             </div>
                             <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" id="addDifference" onchange="handleCheckboxChange_AddDifference(this)">
                                 <label class="form-check-label" for="addDifference">Add Difference</label>
                             </div>
                         </div>
                      </div>
                        
                       <div class="card" style="padding: 15px; margin-bottom: 20px; border: 1px solid #ccc; border-radius: 6px;">
                        <div class="row rowHeight align-items-center">
                               <div class="col-md-2">
                                   <div class="form-group">
                                      <label for="ddlDistanceMaster">Station:</label> 
                                      <select class="form-control" name="ddlDistanceMaster" id="ddlDistanceMaster"></select>
                                      @*   <select class="form-control" id="ddlDistanceMaster" onchange="setDropDownStyle(this);">
                                           </select> *@
                                   </div>
                               </div>
                               <div class="col-md-2">
                                   <div class="form-group">
                                       <label for="txtDistance">Distance:</label>
                                       <input type="text" id="txtDistance" class="form-control" />
                                   </div>
                               </div>
                               <div class="col-md-2">
                                   <div class="form-group">
                                       <label for="ddlLoadType">Load Type:</label>
                                       <select class="form-control" id="ddlLoadType" onchange="setDropDownStyle(this);">
                                           </select>
                                   </div>
                               </div>
                               <div class="col-md-2">
                                   <div class="form-group">
                                       <label for="txtAverage">Average:</label>
                                       <input type="text" id="txtAverage" class="form-control" />
                                   </div>
                               </div>
                               <div class="col-md-2">
                                   <div class="form-group">
                                       <label for="txtEstDiesel">Estimated Diesel:</label>
                                       <input type="text" id="txtEstDiesel" class="form-control" />
                                   </div>
                               </div>
                               <div class="col-md-2">
                                   <div class="form-group">
                                       <button type="button" class="btn btn-primary" onclick="addStationDetails();" style="margin-top: 20px;">Add</button>
                                   </div>
                               </div>
                              </div>

                                                    <div class="table-responsive mt-3">
                                  <table id="stationDetailsTable" class="table table-bordered">
                                      <thead class="thead-light">
                                          <tr>
                                              <th style="display:none;">StationId</th>
                                              <th style="display:none;">LoadTypeId</th>
                                              <th>Station</th>
                                              <th>Distance(KM)</th>
                                              <th>Load Type</th>
                                              <th>Average</th>
                                              <th>Estimated Diesel</th>
                                              <th>Actions</th>
                                          </tr>
                                      </thead>
                                      <tbody>
                                          </tbody>
                                  </table>
                              </div>
                        </div>

                           @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleAddAccess == true)
                            { *@
                                <div class="row rowHeight" style="text-align:center;">
                                    <div class="col-md-12">
                                    <button type="button" id="saveButton" class="btn btn-primary mr-2" onclick="saveDieselHisab();">Save</button>
                                        <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button>
                                    </div>
                                </div>
                            @* } *@
                        </form>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                    @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true){ *@
                    <div id="divDieslHisabMaster" style="visibility:hidden">
                        <div class="table-responsive pt-3">
                            <table id="tblDieselHisabMaster" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th>Actions</th>
                                        <th>Vehicle No</th>
                                        <th>Trip Number</th>
                                        <th>Driver Name</th>
                                        <th>Driver Father's Name</th>
                                        <th>Opening Diesel</th>
                                        <th>Start Odometer</th>
                                        <th>End Odometer</th>
                                        <th>Running Km</th>
                                        <th>Is Active</th>
                                        <th>Creation Date</th>
                                        <th>Created By</th>
                                        <th>Update Date</th>
                                        <th>Updatd By</th>
                                    </tr>
                                </thead>
                                <tbody id="DieselHisabMasterBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                  @*   } *@
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {    
    
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script type="text/javascript">
    // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
    // var addAccess = '@ViewBag.AddUserRoleAddAccess';
    // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
    // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
    // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
    var fullAccess = 'True';
    var addAccess = 'True';
    var viewAccess = 'True';
    var updateAccess = 'True';
    var deleteAccess = 'True';

    var viewButton = "";
    var updateButton = "";
    var deleteButton = "";

    $(document).ready(function () {
        $('#ddlDistanceMaster').select2();
        //Fill Vehicle Master DropdownList
       setSideMenu("diesel-hisab-master");
        getVehicleNumber();
        getDriverMaster();
        getVendorMaster();
        getDistanceMaster();
         getLoadTypeMaster();
        // $("#chkIsActive").attr("checked", true);
        // $("#chkIsActive").attr("disabled", true);    
        
        if (fullAccess === "True" || addAccess === "True") {
            //checkValidationOnChange();
            getDieselHisabByVehicle(); 
        }
        if (fullAccess === "True" || viewAccess === "True") {
            //getVehicleMasterList();
        }

        $(function () {
            $("#ddlVehicleNo").change(function () {
                var selectedValue = $(this).val();
                getCurrentTripNumber($(this).val());
                getDieselHisabByVehicle($(this).val());
            });

            $("#ddlDistanceMaster").change(function () {
                var selectedValue = $(this).val();
                getDistanceByStation(selectedValue)
            });

            $("#ddlLoadType").change(function () {
                var selectedValue=$('#ddlLoadType option:selected').text();
                var vehicleNo=$('#ddlVehicleNo option:selected').val();
                getDieselAverageAsPerLoadType(vehicleNo, selectedValue) 
            });

            $("#ddlDriver").change(function () {
               getDriverFather();
            });


            $('#txtStartOdometer').on('blur', function() {
                calculateRunningKm();
            });

            $('#txtEndOdometer').on('blur', function() {
                calculateRunningKm();
            }); 

            // Calculate Estkm and update when txtAverage changes.
              $("#txtAverage").on("input", calculateEstkm); 

             // Also calculate when txtDistance changes (assuming you have this input).
              $("#txtDistance").on("input", calculateEstkm); 
        });

        $(function () {
            var d = new Date();

            var month = d.getMonth()+1;
            var day = d.getDate();

            var output = d.getFullYear() + '-' +
                (month<10 ? '0' : '') + month + '-' +
                (day<10 ? '0' : '') + day;

            $("#txtVehicleCreationDate").val(output);
        });

            //Check if Page is Opening on Edit Click
            var tripId = GetParameterValues('tripid');
        if (tripId && tripId.length > 0 && parseInt(tripId[0]) > 0) {
            document.getElementById("saveButton").textContent = "Update";
                getDieselHisabByID(tripId);
        }
    });


    function setDropDownStyle(cltr){
        if ($(cltr).find(":selected").val() == "0") {
            $(cltr).attr('class', 'form-control vaidationTextBoxError');
        } else {
            $(cltr).attr('class', 'form-control');
        }
    }

    function setTextboxStyle(cltr) {
        if ($(cltr).val() == "") {
            $(cltr).attr('class', 'form-control vaidationTextBoxError');
        } else {
            $(cltr).attr('class', 'form-control');
        }
    }

    function bindDataTable() {
        $('#tblDieselHisabMaster').DataTable({
            deferRender: true,
            scroller: true,
            scrollX: true,
            scrollY: true,
            searching: true,
            info: true,
            paging: true,
            dom: 'Bfrtip',
            "bDestroy": true,
            buttons: [
                {
                    extend: 'copyHtml5',
                    text: 'Copy'
                },
                {
                    extend: 'csvHtml5',
                    text: 'Csv',
                    title: function () {
                        return "Diesel Hisab Master List";
                    },
                    text: '<span class="fa fa-file-pdf-o">Csv</span>',
                    titleAttr: 'Csv'
                },
                {
                    extend: 'excelHtml5',
                    text: 'Excel',
                    title: function () {
                        return "Diesel Hisab Master List";
                    },
                    text: '<span class="fa fa-file-pdf-o">Excel</span>',
                    titleAttr: 'Excel'
                },
                {
                    extend: "print",
                    exportOptions: {
                        orientation: 'landscape'
                    },
                    pageSize: 'A0',
                    customize: function (win) {
                        var last = null;
                        var current = null;
                        var bod = [];

                        var css = '@@page { size: landscape; }',
                            head = win.document.head || win.document.getElementsByTagName('head')[0],
                            style = win.document.createElement('style');

                        style.type = 'text/css';
                        style.media = 'print';

                        if (style.styleSheet) {
                            style.styleSheet.cssText = css;
                        }
                        else {
                            style.appendChild(win.document.createTextNode(css));
                        }
                        head.appendChild(style);
                    }
                },
                {
                    extend: 'pdfHtml5',
                    title: function () {
                            return "Diesel Hisab Master List";
                    },
                    orientation: 'landscape',
                    pageSize: 'A4',
                    text: '<span class="fa fa-file-pdf-o">PDF</span>',
                    titleAttr: 'PDF'
                }
            ]
        });
    }

    function checkValidation() {
        var isValid = true;
        if ($('#ddlVehicleNo option:selected').val() == "0" || $('#ddlState option:selected').val() == "") {
            $("#ddlVehicleNo").attr('class', 'form-control vaidationTextBoxError');
            $("#ddlVehicleNo").focus();
            isValid = false;
        } else {
            $("#ddlVehicleNo").attr('class', 'form-control');
            $("#ddlVehicleNo").focus();
        }

        if ($('#ddlDriver option:selected').val() == "0" || $('#ddlState option:selected').val() == "") {
            $("#ddlDriver").attr('class', 'form-control vaidationTextBoxError');
            $("#ddlDriver").focus();
