@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";

        $(document).ready(function () {
            setSideMenu("function-master");
            $("#chkIsActive").attr("checked", true);
            $("#chkIsActive").attr("disabled", true);
            getFunctionName('FUNCTION MASTER', function (userRights) {
                if (userRights) {
                    console.log("Update Access:", userRights.updateAccess);
                    console.log("Add Access:", userRights.addAccess);
                    console.log("Delete Access:", userRights.deleteAccess);
                    console.log("View Access:", userRights.viewAccess);
                    console.log("Full Access:", userRights.fullAccess);

                    fullAccess = userRights.fullAccess;
                    addAccess = userRights.addAccess;
                    viewAccess = userRights.viewAccess;
                    updateAccess = userRights.updateAccess;
                    deleteAccess = userRights.deleteAccess;
                    if (addAccess === "False") {
                        const buttons = document.querySelectorAll('button[type="button"], input[type="button"]');
                        buttons.forEach(button => {
                            // Prevent removing the trigger button itself, if it also has type="button"
                            if (button.id !== 'removeAllTypeButtonsBtn') {
                                button.remove();
                            }
                        });
                    }
                } else {
                    console.log("Failed to get user rights.");
                }
            });
            if (fullAccess === "True" || addAccess === "True") {
                checkValidationOnChange();
            }
            if (fullAccess === "True" || viewAccess === "True") {
                getFunctionMasterList();
            }
        });

        function bindDataTable() {
            $('#tblFunctionMaster').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "Function Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "Function Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "Function Master List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }

        function checkValidation() {
            var isValid = true;
            if ($("#txtFunctionName").val() == "") {
                $("#txtFunctionName").attr('class', 'form-control vaidationTextBoxError');
                $("#txtFunctionName").focus();
                isValid = false;
            } else {
                $("#txtFunctionName").attr('class', 'form-control');
                $("#txtFunctionName").focus();
            }

            if ($("#from-date-picker").val() == "") {
                $("#from-date-picker").attr('class', 'form-control vaidationTextBoxError');
                $("#from-date-picker").focus();
                isValid = false;
            } else {
                $("#from-date-picker").attr('class', 'form-control');
                $("#from-date-picker").focus();
            }

            if ($("#to-date-picker").val() == "") {
                $("#to-date-picker").attr('class', 'form-control vaidationTextBoxError');
                $("#to-date-picker").focus();
                isValid = false;
            } else {
                $("#to-date-picker").attr('class', 'form-control');
                $("#to-date-picker").focus();
            }
            return isValid;
        }

        function checkValidationOnChange() {
            $(function () {

                $("#txtFunctionName").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#from-date-picker").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#to-date-picker").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });
            });
        }

        function clearControls() {
            $("#from-date-picker").val("");
            $("#to-date-picker").val("");
            $("#txtFunctionName").val("");
            $("#chkIsActive").prop("checked", false);
        }

        function getFunctionMasterList() {
            if ($.fn.DataTable.isDataTable("#tblFunctionMaster")) {
                $('#tblFunctionMaster tbody').empty();
                $('#tblFunctionMaster').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "FunctionMaster/getFunctionMasterList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $.each(data, function (i, item) {
                            var sno = 0;
                            var rows = "";
                            var row = "";
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewFunctionMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editFunctionMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton =  '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteFunctionMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.functionName + '</td>' +
                                '<td>' + item.startDateString + '</td>' +
                                '<td>' + item.endDateString + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.createDate + '</td>' +
                                '<td>' + item.createdBy + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updateBy + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            $("#functionMasterBody").append(rows);
                            rows = "";
                            $("#tblFunctionMaster").focus();
                        });
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="9" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#functionMasterBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }

        function saveUserRole() {
            var isValid = checkValidation();

            if (isValid == true) {
                if ($("#txtFunctionName").val() != ""
                    && $("#from-date-picker").val() != ""
                    && $("#to-date-picker").val() != "") {
                    var functionName = $("#txtFunctionName").val();
                    var isActive = $("#chkIsActive").is(":checked");
                    var startDate = $("#from-date-picker").val();
                    var endDate = $("#to-date-picker").val();
                    var fromDate = startDate.split("-").reverse().join("-");
                    var toDate = endDate.split("-").reverse().join("-");
                    $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "FunctionMaster/Save")',
                        type: "POST",
                        dataType: "json",
                        data: { functionName: functionName, isActive: isActive, startDate: fromDate, endDate: toDate},
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'Save Function Master!',
                                        content: "Function Master has been saved successfully!",
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    //getUserList();
                                                    //clearControls();
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "FunctionMaster/Index")';
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'Function Master Already Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                    $("#divFunctionMaster").hide();
                                }
                            } else {
                                console.log(data);
                                //clearControls();
                                $.confirm({
                                    title: 'Error Occoured!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divFunctionMaster").hide();
                            }
                        }
                    });
                }
            }
        }
    </script>
}