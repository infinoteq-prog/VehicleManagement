    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Add Function Master</h4>
                    <div id="divSaveRateMaster">
                        <form id="frmFunctionMaster" name="frmFunctionMaster" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
