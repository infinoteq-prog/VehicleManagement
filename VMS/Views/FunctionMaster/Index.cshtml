                   @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
                        { *@
                        <div id="divFunctionMaster">
                            <div class="table-responsive pt-3">
                            <table id="tblFunctionMaster" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th>Actions</th>
                                        <th>Function Name</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Is Active</th>
                                        <th>Creation Date</th>
                                        <th>Created By</th>
                                        <th>Update Date</th>
                                        <th>Updatd By</th>
