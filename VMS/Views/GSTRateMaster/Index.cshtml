@model VMS.ViewModel.VMGstRateMaster
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
} *@

@* @if (userAccess.RateMasterFullAccess == true || userAccess.RateMasterAddAccess == true)
{ *@
<div class="content-wrapper">
        <div class="row">
            <div class="col-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Add GST Rate Master</h4>
                        <div id="divsaveGstRateMaster">
                        <form id="frmGstRateMaster" name="frmGstRateMaster" method="post" class="forms-sample">
                            @Html.AntiForgeryToken() 
                            <input id="hdnTotalBasicRate" name="hdnTotalBasicRate" type="hidden">
                            <input id="hdnTotalLongRouteRate" name="hdnTotalLongRouteRate" type="hidden">
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <label id="lblMandatoryMessage" class="reqFields">@SiteConstants.ReqFieldMessage</label>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtSgstRate">SGST Rate :</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.SgstRate, new { @class = "form-control decimalnumberonly", @maxlength = "10", id = "txtSgstRate" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtCgstRate">CGST Rate :</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.CgstRate, new { @class = "form-control decimalnumberonly", @maxlength = "10", id = "txtCgstRate" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtIgstRate">IGST Rate :</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.IgstRate, new { @class = "form-control decimalnumberonly", @maxlength = "10", id = "txtIgstRate" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtUgstRate">UGST Rate :</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.UgstRate, new { @class = "form-control decimalnumberonly", @maxlength = "10", id = "txtUgstRate" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtEffectiveDate">Effective Date : </label>
                                        <div class="col-sm-8 input-group date" data-date-format="dd/mm/yyyy">
                                            @Html.TextBoxFor(x => x.EffectiveDate, new { @class = "form-control datepicker", id = "txtEffectiveDate", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="chkIsActive">Is Active:</label>
                                        <div class="col-sm-8">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-label checkboxStyle", id = "chkIsActive" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-12"></div>
                            </div>
                            @* @if (userAccess.RateMasterFullAccess == true || userAccess.RateMasterAddAccess == true)
                            { *@
                                <div class="row rowHeight" style="text-align:center;">
                                    <div class="col-md-12">
                                        <button type="button" class="btn btn-primary mr-2" onclick="saveGstRateMaster();">Save</button>
                                        <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button>
                                    </div>
                                </div>
                            @* } *@
                            </form>
                        </div>
                        <div class="row rowHeight">
                            <div class="col-md-12"></div>
                        </div>
                        @* @if (userAccess.RateMasterFullAccess == true || userAccess.RateMasterViewAccess == true)
                        { *@
                            <div id="divViewGstRateMaster">
                                <div class="table-responsive pt-3">
                                    <table id="tblGstRateMasterList" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th>Actions</th>
                                                <th>SGST Rate</th>
                                                <th>CGST Rate</th>
                                                <th>IGST Rate</th>
                                                <th>UTGST Rate</th>
                                                <th>Effective Date</th>
                                                <th>End Date</th>
                                                <th>Is Active</th>
                                                <th>Created By</th>
                                                <th>Created Date</th>
                                                <th>Updated By</th>
                                                <th>Updated Date</th>
                                            </tr>
                                        </thead>
                                        <tbody id="gstRateMasterBody">
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                       @*  } *@
                    </div>
                </div>
            </div>
        </div>
    </div>
@* } *@
@section scripts {
<script type="text/javascript">
    // var fullAccess = '@ViewBag.RateMasterFullAccess';
    // var addAccess = '@ViewBag.RateMasterAddAccess';
    // var viewAccess = '@ViewBag.RateMasterViewAccess';
    // var updateAccess = '@ViewBag.RateMasterUpdateAccess';
    // var deleteAccess = '@ViewBag.RateMasterDeleteAccess';
    var fullAccess = 'True';
    var addAccess = 'True';
    var viewAccess = 'True';
    var updateAccess = 'True';
    var deleteAccess = 'True';
    var viewButton = "";
    var updateButton = "";
    var deleteButton = "";

    $(document).ready(function () {
        setSideMenu("gstrate-master");
        $("#chkIsActive").attr("checked", true);
        $("#chkIsActive").attr("disabled", true);
            getFunctionName('GST MASTER', function (userRights) {
                if (userRights) {
                    console.log("Update Access:", userRights.updateAccess);
                    console.log("Add Access:", userRights.addAccess);
                    console.log("Delete Access:", userRights.deleteAccess);
                    console.log("View Access:", userRights.viewAccess);
                    console.log("Full Access:", userRights.fullAccess);

                    fullAccess = userRights.fullAccess;
                    addAccess = userRights.addAccess;
                    viewAccess = userRights.viewAccess;
                    updateAccess = userRights.updateAccess;
                    deleteAccess = userRights.deleteAccess;
                    if (addAccess === "False") {
                        const buttons = document.querySelectorAll('button[type="button"], input[type="button"]');
                        buttons.forEach(button => {
                            // Prevent removing the trigger button itself, if it also has type="button"
                            if (button.id !== 'removeAllTypeButtonsBtn') {
                                button.remove();
                            }
                        });
                    }
                } else {
                    console.log("Failed to get user rights.");
                }
            });
        if (fullAccess === "True" || addAccess === "True") {
            checkValidationOnChange();
        }

        if (fullAccess === "True" || viewAccess === "True") {
            getGSTRateMasterList();
        }
    });

    function bindDataTable() {
        $('#tblGstRateMasterList').DataTable({
            deferRender: true,
            scroller: true,
            scrollX: true,
            scrollY: true,
            searching: true,
            info: true,
            paging: true,
            dom: 'Bfrtip',
            "bDestroy": true,
            buttons: [
                {
                    extend: 'copyHtml5',
                    text: 'Copy'
                },
                {
                    extend: 'csvHtml5',
                    text: 'Csv',
                    title: function () {
                        return "GST Rate Master List";
                    },
                    text: '<span class="fa fa-file-pdf-o">Csv</span>',
                    titleAttr: 'Csv'
                },
                {
                    extend: 'excelHtml5',
                    text: 'Excel',
                    title: function () {
                        return "GST Rate Master List";
                    },
                    text: '<span class="fa fa-file-pdf-o">Excel</span>',
                    titleAttr: 'Excel'
                },
                {
                    extend: "print",
                    exportOptions: {
                        orientation: 'landscape'
                    },
                    pageSize: 'A0',
                    customize: function (win) {
                        var last = null;
                        var current = null;
                        var bod = [];

                        var css = '@@page { size: landscape; }',
                            head = win.document.head || win.document.getElementsByTagName('head')[0],
                            style = win.document.createElement('style');

                        style.type = 'text/css';
                        style.media = 'print';

                        if (style.styleSheet) {
                            style.styleSheet.cssText = css;
                        }
                        else {
                            style.appendChild(win.document.createTextNode(css));
                        }
                        head.appendChild(style);
                    }
                },
                {
                    extend: 'pdfHtml5',
                    title: function () {
                        return "GST Rate Master List";
                    },
                    orientation: 'landscape',
                    pageSize: 'A3',
                    text: '<span class="fa fa-file-pdf-o">PDF</span>',
                    titleAttr: 'PDF'
                }
            ]
        });
    }

    function checkValidation() {
        var isValid = true;        
        if ($("#txtSgstRate").val() == "") {
            $("#txtSgstRate").attr('class', 'form-control vaidationTextBoxError');
            $("#txtSgstRate").focus();
                 isValid = false;
        } else {
            $("#txtSgstRate").attr('class', 'form-control');
            $("#txtSgstRate").focus();
        }

        if ($("#txtCgstRate").val() == "") {
            $("#txtCgstRate").attr('class', 'form-control vaidationTextBoxError');
            $("#txtCgstRate").focus();
                 isValid = false;
        } else {
            $("#txtCgstRate").attr('class', 'form-control');
            $("#txtCgstRate").focus();
        }

        if ($("#txtIgstRate").val() == "") {
            $("#txtIgstRate").attr('class', 'form-control vaidationTextBoxError');
            $("#txtIgstRate").focus();
            isValid = false;
        } else {
            $("#txtIgstRate").attr('class', 'form-control');
            $("#txtIgstRate").focus();
        }

        if ($("#txtUgstRate").val() == "") {
            $("#txtUgstRate").attr('class', 'form-control vaidationTextBoxError');
            $("#txtUgstRate").focus();
            isValid = false;
        } else {
            $("#txtUgstRate").attr('class', 'form-control');
            $("#txtUgstRate").focus();
        }

        if ($("#txtEffectiveDate").val() == "") {
            $("#txtEffectiveDate").attr('class', 'form-control vaidationTextBoxError');
            $("#txtEffectiveDate").focus();
            isValid = false;
        } else {
            $("#txtEffectiveDate").attr('class', 'form-control');
            $("#txtEffectiveDate").focus();
        }
        return isValid;
    }

    function checkValidationOnChange() {
        $(function () {
            $("#txtSgstRate").on("input", function () {
                if ($(this).val() == "") {
                    $(this).attr('class', 'form-control vaidationTextBoxError');
                    $(this).focus();
                } else {
                    $(this).attr('class', 'form-control');
                    $(this).focus();
                }
            });

            $("#txtCgstRate").on("input", function () {
                if ($(this).val() == "") {
                    $(this).attr('class', 'form-control vaidationTextBoxError');
                    $(this).focus();
                } else {
                    $(this).attr('class', 'form-control');
                    $(this).focus();
                }
            });

            $("#txtIgstRate").on("input", function () {
                if ($(this).val() == "") {
                    $(this).attr('class', 'form-control vaidationTextBoxError');
                    $(this).focus();
                } else {
                    $(this).attr('class', 'form-control');
                    $(this).focus();
                }
            });

            $("#txtUgstRate").on("input", function () {
                if ($(this).val() == "") {
                    $(this).attr('class', 'form-control vaidationTextBoxError');
                    $(this).focus();
                } else {
                    $(this).attr('class', 'form-control');
                    $(this).focus();
                }
            });

            $("#txtEffectiveDate").on("input", function () {
                if ($(this).val() == "") {
                    $(this).attr('class', 'form-control vaidationTextBoxError');
                    $(this).focus();
                } else {
                    $(this).attr('class', 'form-control');
                    $(this).focus();
                }
            });
        });
    }

    function clearControls() {
        $("#txtSgstRate").val("");
        $("#txtCgstRate").val("");
        $("#txtIgstRate").val("");
        $("#txtUgstRate").val("");
        $("#txtEffectiveDate").val("");      
    }

    function getTransporter() {
        $.ajax({
            cache: false,
            url: '@(utilityHelper.SiteUrl() + "GSTRateMaster/getTransporterList")',
            type: "GET",
            dataType: "json",
            success: function (data) {
                if (data != null && data != undefined) {
                    var s = '<option value="0">Select Transporter</option>';
                    for (var i = 0; i < data.length; i++) {
                        console.log(data[i])
                        s += '<option value="' + data[i].transCode + '">' + data[i].name + '</option>';
                    }
                    $("#ddlTransporter").html(s);
                } else {
                    console.log(data);
                }
            }
        });
    }

    function saveGstRateMaster(){
        checkValidation();
            if ($("#txtSgstRate").val() != ""
                && $("#txtCgstRate").val() != ""
                && $("#txtIgstRate").val() != ""
                && $("#txtUgstRate").val() != ""
                && $("#txtEffectiveDate").val() != "") {
                    var sgstRate = $('#txtSgstRate').val();
                    var cgstRate = $('#txtCgstRate').val();
                    var igstRate = $('#txtIgstRate').val();
                    var ugstRate = $('#txtUgstRate').val();
                    var effectiveDate = $("#txtEffectiveDate").val();
                    var newEffectiveDate = effectiveDate.split("-").reverse().join("-");
                    var isActive = $("#chkIsActive").is(":checked");
                $.ajax({
                    cache: false,
                    url: '@(utilityHelper.SiteUrl() + "GSTRateMaster/Save")',
                    type: "POST",
                    dataType: "json",
                    data: { sgstRate: sgstRate, cgstRate: cgstRate, igstRate: igstRate, ugstRate: ugstRate, effectiveDate: newEffectiveDate, isActive: isActive },
                    success: function (data) {
                        if (data != null && data != undefined) {
                            if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                console.log(data);
                                $.confirm({
                                    title: 'GST Rate Master Entry Success!',
                                    content: "GST Rate Master Detail has been saved successfully.",
                                    type: 'green',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-green',
                                            action: function () {
                                                window.location.href = '@(utilityHelper.SiteUrl() + "GSTRateMaster/Index")';
                                            }
                                        },
                                    }
                                });
                            } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                $.confirm({
                                    title: 'GST Rate Entry Exists!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                //$("#divViewGstRateMaster").hide();
                            }
                        } else {
                            console.log(data);
                            //clearControls();
                            $.confirm({
                                title: 'Error Occoured!',
                                content: data.transactionMessage.message,
                                icon: 'fa fa-warning',
                                type: 'red',
                                buttons: {
                                    omg: {
                                        text: 'OK',
                                        btnClass: 'btn-red',
                                    },
                                }
                            });
                            //$("#divViewGstRateMaster").hide();
                        }
                    }
                });
                // }else{
                //     $("#ddlSite").attr('class', 'form-control vaidationTextBoxError');
                //     $("#ddlSource").attr('class', 'form-control vaidationTextBoxError');
                //     $("#ddlSite").focus();
                //     $.confirm({
                //         title: 'Site and Source Validation!',
                //         content: "Site and Source cannot be same. Please try again! ",
                //         icon: 'fa fa-warning',
                //         type: 'red',
                //         buttons: {
                //             omg: {
                //                 text: 'OK',
                //                 btnClass: 'btn-red',
                //             },
                //         }
                //     });
                // }
            }
        }

    function getGSTRateMasterList() {
        if ($.fn.DataTable.isDataTable("#tblGstRateMasterList")) {
            $('#tblGstRateMasterList tbody').empty();
            $('#tblGstRateMasterList').DataTable().clear().destroy();
        }
        $.ajax({
            cache: false,
            url: '@(utilityHelper.SiteUrl() + "GSTRateMaster/getGSTRateMasterList")',
            type: "GET",
            dataType: "json",
            success: function (data) {
                console.log(data);
                if (data != null && data != undefined) {
                    var sno = 0;
                    var rows = "";
                    var row = "";
                    $.each(data, function (i, item) {
                        sno = sno + 1;
                        if (fullAccess === "True" || viewAccess === "True") {
                            viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewGSTRateMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || updateAccess === "True") {
                            updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editGSTRateMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteGSTRateMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                        }
                        row = '<tr>' +
                            '<td>' +
                            '<div class="d-flex align-items-center">' +
                            viewButton +
                            updateButton +
                            deleteButton +
                            '</div>' +
                            '</td>' +
                            '<td>' + item.sgstRate + '</td>' +
                            '<td>' + item.cgstRate + '</td>' +
                            '<td>' + item.igstRate + '</td>' +
                            '<td>' + item.ugstRate + '</td>' +
                            '<td>' + item.effectiveDate + '</td>' +
                            '<td>' + item.endDate + '</td>' +
                            '<td>' + item.isActive + '</td>' +
                            '<td>' + item.creationDate + '</td>' +
                            '<td>' + item.createdBy + '</td>' +
                            '<td>' + item.updateDate + '</td>' +
                            '<td>' + item.updatedBy + '</td>' +
                            '</tr>';
                        rows = rows + row;
                    });
                    $("#gstRateMasterBody").html(rows);
                    rows = "";
                    $("#tblGstRateMasterList").focus();
                    bindDataTable();
                    // $.confirm({
                    //     title: 'Rate Master Entry Found!',
                    //     content: "Rate Master Detail has been fetched successfully.",
                    //     type: 'green',
                    //     buttons: {
                    //         omg: {
                    //             text: 'OK',
                    //             btnClass: 'btn-green',
                    //             action: function () {
                    //                 //window.location.href = '@Url.Action("List", "VehicleRelease")';
                    //                 //getGstRateMaster(data.id);
                    //             }
                    //         },
                    //     }
                    // });
                } else {
                    $.confirm({
                        title: 'GST Rate Master Entry',
                        content: 'GST Rate Master Entry Not Found!',
                        icon: 'fa fa-warning',
                        type: 'red',
                        buttons: {
                            omg: {
                                text: 'OK',
                                btnClass: 'btn-red',
                            },
                        }
                    });
                    var row = '<tr>' +
                        '<td colspan="12" style="text-align:center">No Data Found!!!</td>' +
                        '</tr>';
                    $("#gstRateMasterBody").html(row);
                }
            },
            error: function (ex) {
                alert(ex);
            }
        });
    }
</script>
}