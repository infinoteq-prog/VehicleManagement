@model VMS.ViewModel.VMGstRateMaster
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
} *@

@* @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleUpdateAccess == true)
{ *@
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Update GST Rate Master</h4>
                    <div id="divUpdateUserRole">
                        <form id="frmGstRateMaster" name="frmGstRateMaster" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <input id="hdnGstRateMasterID" name="hdnGstRateMasterID" type="hidden">
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <label id="lblMandatoryMessage" class="reqFields">@SiteConstants.ReqFieldMessage</label>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtSgstRate">SGST Rate :</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.SgstRate, new { @class = "form-control decimalnumberonly", @maxlength = "10", id = "txtSgstRate" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtCgstRate">CGST Rate :</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.CgstRate, new { @class = "form-control decimalnumberonly", @maxlength = "10", id = "txtCgstRate" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtIgstRate">IGST Rate :</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.IgstRate, new { @class = "form-control decimalnumberonly", @maxlength = "10", id = "txtIgstRate" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtUgstRate">UGST Rate :</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.UgstRate, new { @class = "form-control decimalnumberonly", @maxlength = "10", id = "txtUgstRate" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtEffectiveDate">Effective Date : </label>
                                        <div class="col-sm-8 input-group date" data-date-format="dd/mm/yyyy">
                                            @Html.TextBoxFor(x => x.EffectiveDate, new { @class = "form-control datepicker", id = "txtEffectiveDate", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtEndDate">End Date : </label>
                                        <div class="col-sm-8 input-group date" data-date-format="dd/mm/yyyy">
                                            @Html.TextBoxFor(x => x.EndDate, new { @class = "form-control datepicker", id = "txtEndDate", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="chkIsActive">Is Active:</label>
                                        <div class="col-sm-8">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-label checkboxStyle", id = "chkIsActive" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-12"></div>
                            </div>
                            @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleUpdateAccess == true)
                            { *@
                            <div class="row rowHeight" style="text-align:center;">
                                <div class="col-md-12">
                                    <button type="button" class="btn btn-primary mr-2" onclick="updateGstRateMaster();">Update</button>
                                    <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button>
                                </div>
                            </div>
                            @*  } *@
                        </form>
                    </div>
                </div>
                <div class="row rowHeight">
                    <div class="col-md-12"></div>
                </div>
                @* @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
                    { *@
                <div id="divGstRateMaster">
                        <div class="table-responsive pt-3">
                            <table id="tblGstRateMasterList" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th>Actions</th>
                                        <th>SGST Rate</th>
                                        <th>CGST Rate</th>
                                        <th>IGST Rate</th>
                                        <th>UTGST Rate</th>
                                        <th>Effective Date</th>
                                        <th>End Date</th>
                                        <th>Is Active</th>
                                        <th>Created By</th>
                                        <th>Created Date</th>
                                        <th>Updated By</th>
                                        <th>Updated Date</th>
                                    </tr>
                                </thead>
                                <tbody id="gstRateMasterBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                @* } *@
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";
        $(document).ready(function () {
            setSideMenu("gstrate-master");
            if (fullAccess === "True" || viewAccess === "True") {
                clearControls();
                checkValidationOnChange();
                var gstRateMasterId = GetParameterValues('gstRateMasterId');
                getGstRateMasterById(gstRateMasterId);
            }
        });

        function bindDataTable() {
            $('#tblGstRateMasterList').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "GST Rate Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "GST Rate List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "GST Rate List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }

            function checkValidation() {
            var isValid = true;
            if ($("#txtSgstRate").val() == "") {
                $("#txtSgstRate").attr('class', 'form-control vaidationTextBoxError');
                $("#txtSgstRate").focus();
                     isValid = false;
            } else {
                $("#txtSgstRate").attr('class', 'form-control');
                $("#txtSgstRate").focus();
            }

            if ($("#txtCgstRate").val() == "") {
                $("#txtCgstRate").attr('class', 'form-control vaidationTextBoxError');
                $("#txtCgstRate").focus();
                     isValid = false;
            } else {
                $("#txtCgstRate").attr('class', 'form-control');
                $("#txtCgstRate").focus();
            }

            if ($("#txtIgstRate").val() == "") {
                $("#txtIgstRate").attr('class', 'form-control vaidationTextBoxError');
                $("#txtIgstRate").focus();
                isValid = false;
            } else {
                $("#txtIgstRate").attr('class', 'form-control');
                $("#txtIgstRate").focus();
            }

            if ($("#txtUgstRate").val() == "") {
                $("#txtUgstRate").attr('class', 'form-control vaidationTextBoxError');
                $("#txtUgstRate").focus();
                isValid = false;
            } else {
                $("#txtUgstRate").attr('class', 'form-control');
                $("#txtUgstRate").focus();
            }

            if ($("#txtEffectiveDate").val() == "") {
                $("#txtEffectiveDate").attr('class', 'form-control vaidationTextBoxError');
                $("#txtEffectiveDate").focus();
                isValid = false;
            } else {
                $("#txtEffectiveDate").attr('class', 'form-control');
                $("#txtEffectiveDate").focus();
            }
            return isValid;
        }

        function checkValidationOnChange() {
            $(function () {
                $("#txtSgstRate").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtCgstRate").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtIgstRate").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtUgstRate").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtEffectiveDate").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });
            });
        }

        function clearControls() {
            $("#txtSgstRate").val("");
            $("#txtCgstRate").val("");
            $("#txtIgstRate").val("");
            $("#txtUgstRate").val("");
            $("#txtEffectiveDate").val("");
            $("#txtEndDate").val("");
        }

        function getGSTRateMasterList() {
            if ($.fn.DataTable.isDataTable("#tblGstRateMasterList")) {
                $('#tblGstRateMasterList tbody').empty();
                $('#tblGstRateMasterList').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "GSTRateMaster/getGSTRateMasterList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $.each(data, function (i, item) {
                            var sno = 0;
                            var rows = "";
                            var row = "";
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewGSTRateMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editGSTRateMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteGSTRateMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.sgstRate + '</td>' +
                                '<td>' + item.cgstRate + '</td>' +
                                '<td>' + item.igstRate + '</td>' +
                                '<td>' + item.ugstRate + '</td>' +
                                '<td>' + item.effectiveDate + '</td>' +
                                '<td>' + item.endDate + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.creationDate + '</td>' +
                                '<td>' + item.createdBy + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updatedBy + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            $("#gstRateMasterBody").append(rows);
                            rows = "";
                            $("#tblGstRateMasterList").focus();
                        });
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="12" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#gstRateMasterBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }

        function updateGstRateMaster() {
            var isValid = checkValidation();
            alert(isValid);
            if (isValid == true) {
                if ($("#txtSgstRate").val() != ""
                    && $("#txtCgstRate").val() != ""
                    && $("#txtIgstRate").val() != ""
                    && $("#txtUgstRate").val() != ""
                    && $("#txtEffectiveDate").val() != "") {
                    var id = $('#hdnGstRateMasterID').val();
                    var sgstRate = $('#txtSgstRate').val();
                    var cgstRate = $('#txtCgstRate').val();
                    var igstRate = $('#txtIgstRate').val();
                    var ugstRate = $('#txtUgstRate').val();
                    var effectiveDate = $("#txtEffectiveDate").val();
                    var newEffectiveDate = effectiveDate.split("-").reverse().join("-");
                    var endDate =  $("#txtEndDate").val();
                    var newEndDate = endDate.split("-").reverse().join("-");
                    var isActive = $("#chkIsActive").is(":checked");
                    alert(isValid);
                    $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "GSTRateMaster/Update")',
                        type: "POST",
                        dataType: "json",
                        data: {id: id, sgstRate: sgstRate, cgstRate: cgstRate, igstRate: igstRate, ugstRate: ugstRate, effectiveDate: newEffectiveDate, endDate: newEndDate, isActive: isActive },
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'Update GST Rate Master!',
                                        content: "GST Rate Master has been updated successfully!",
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    clearControls();
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "GSTRateMaster/Update?gstRateMasterId=")' + $("#hdnGstRateMasterID").val();
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'GST Rate Master Already Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                    $("#divGstRateMaster").hide();
                                }
                            } else {
                                console.log(data);
                                //clearControls();
                                $.confirm({
                                    title: 'Error Occoured!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divGstRateMaster").hide();
                            }
                        }
                    });
                }
            }
        }

        function getGstRateMasterById(gstRateMasterId) {
            if ($.fn.DataTable.isDataTable("#tblGstRateMasterList")) {
                $('#tblGstRateMasterList tbody').empty();
                $('#tblGstRateMasterList').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "GSTRateMaster/getGstRateMasterById")',
                type: "GET",
                data: { gstRateMasterId: gstRateMasterId },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        var sno = 0;
                        var rows = "";
                        var row = "";
                        sno = sno + 1;
                        if (fullAccess === "True" || viewAccess === "True") {
                            viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewGSTRateMaster(\'' + data.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || updateAccess === "True") {
                            updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editGSTRateMaster(\'' + data.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || deleteAccess === "True") {
                            deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteGSTRateMaster(\'' + data.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                        }
                        row = '<tr>' +
                            '<td>' +
                            '<div class="d-flex align-items-center">' +
                            viewButton +
                            updateButton +
                            deleteButton +
                            '</div>' +
                            '</td>' +
                            '<td>' + data.sgstRate + '</td>' +
                            '<td>' + data.cgstRate + '</td>' +
                            '<td>' + data.igstRate + '</td>' +
                            '<td>' + data.ugstRate + '</td>' +
                            '<td>' + data.effectiveDate + '</td>' +
                            '<td>' + data.endDate + '</td>' +
                            '<td>' + data.isActive + '</td>' +
                            '<td>' + data.creationDate + '</td>' +
                            '<td>' + data.createdBy + '</td>' +
                            '<td>' + data.updateDate + '</td>' +
                            '<td>' + data.updatedBy + '</td>' +
                            '</tr>';

                        //Setting GST Rate Master Details to Page Controls
                        $('#hdnGstRateMasterID').val(data.id);
                        $("#txtSgstRate").val(data.sgstRate);
                        $("#txtCgstRate").val(data.cgstRate);
                        $("#txtIgstRate").val(data.igstRate);
                        $("#txtUgstRate").val(data.ugstRate);
                        $('#txtEffectiveDate').val(data.effectiveDateString);
                        $('#txtEndDate').val(data.endDateString);
                        $("#chkIsActive").prop('checked', data.isActive);

                        rows = rows + row;
                        $("#gstRateMasterBody").html(rows);
                        rows = "";
                        $("#tblGstRateMasterList").focus();

                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="12" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#gstRateMasterBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}