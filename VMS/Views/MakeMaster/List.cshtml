@model VMS.ViewModel.VMCodeMaster
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
}
@if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
{ *@
<div class="content-wrapper">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Code Master List</h4>
                    <div class="row rowHeight">
                        <div class="col-md-6">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="ddlCodeType">Code Type: <span class="reqFields">*</span> </label>
                                <div class="col-sm-8">
                                    <select class="form-control" id="ddlCodeType" name="ddlCodeType" onchange="setDropDownStyle(this);"></select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="txtCode">Code: <span class="reqFields">*</span> </label>
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(m => m.Code, new { @class = "form-control", id = "txtCode" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-6">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="txtDescription">Description: <span class="reqFields">*</span> </label>
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(m => m.Description, new { @class = "form-control", id = "txtDescription" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="chkIsActive">Is Active:</label>
                                <div class="col-sm-8">
                                    @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-label checkboxStyle", id = "chkIsActive" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row rowHeight" style="text-align:center;">
                        <div class="col-md-12"></div>
                    </div>
                       @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
                        { *@
                            <div class="row rowHeight" style="text-align:center;">
                                <div class="col-md-12">
                                    <button type="button" class="btn btn-primary mr-2" onclick="searchCodeMaster();">Search</button>
                                    @* <button type="button" class="btn btn-primary mr-2" onclick="getMakeMasterList();">View All</button> *@
                                    <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button> 
                                </div>
                            </div>
                       @*  } *@
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group row">
                                <div class="col-sm-12"></div>
                            </div>
                        </div>
                    </div>
                    @* @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
                    { *@
                        <div id="divMakeMaster">
                            <div class="table-responsive pt-3">
                                <table id="tblMakeMaster" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                    <thead>
                                        <tr>
                                            <th>Actions</th>
                                            <th>Code Type</th>
                                            <th>Code</th>
                                            <th>Description</th>
                                            <th>Is Active</th>
                                            <th>Creation Date</th>
                                            <th>Created By</th>
                                            <th>Update Date</th>
                                            <th>Updatd By</th>
                                        </tr>
                                    </thead>
                                    <tbody id="makeMasterBody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    @* } *@
                </div>
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";

        $(document).ready(function () {
            getCodeType();
            setSideMenu("make-master");
            getFunctionName('MAKE MASTER', function (userRights) {
                if (userRights) {
                    console.log("Update Access:", userRights.updateAccess);
                    console.log("Add Access:", userRights.addAccess);
                    console.log("Delete Access:", userRights.deleteAccess);
                    console.log("View Access:", userRights.viewAccess);
                    console.log("Full Access:", userRights.fullAccess);

                    fullAccess = userRights.fullAccess;
                    addAccess = userRights.addAccess;
                    viewAccess = userRights.viewAccess;
                    updateAccess = userRights.updateAccess;
                    deleteAccess = userRights.deleteAccess;
                } else {
                    console.log("Failed to get user rights.");
                }
            });
            if (fullAccess === "True" || viewAccess === "True") {
                //checkValidationOnChange();
                getMakeMasterList();
                $(function () {
                    $("#from-date-picker").datepicker({
                        dateFormat: 'dd-mm-yy'
                    });

                    $("#to-date-picker").datepicker({
                        dateFormat: 'dd-mm-yy'
                    });
                });
            }
        });

        function bindDataTable() {
            $('#tblMakeMaster').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "Code Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "Code Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "Code Master List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }

        function checkValidation() {
            var isValid = true;
            if ($("#ddlCodeType").val() == "") {
                $("#ddlCodeType").attr('class', 'form-control vaidationTextBoxError');
                $("#ddlCodeType").focus();
                isValid = false;
            } else {
                $("#ddlCodeType").attr('class', 'form-control');
                $("#ddlCodeType").focus();
            }

            if ($("#txtCode").val() == "") {
                $("#txtCode").attr('class', 'form-control vaidationTextBoxError');
                $("#txtCode").focus();
                isValid = false;
            } else {
                $("#txtCode").attr('class', 'form-control');
                $("#txtCode").focus();
            }

            if ($("#txtDescription").val() == "") {
                $("#txtDescription").attr('class', 'form-control vaidationTextBoxError');
                $("#txtDescription").focus();
                isValid = false;
            } else {
                $("#txtDescription").attr('class', 'form-control');
                $("#txtDescription").focus();
            }
            return isValid;
        }

        function checkValidationOnChange() {
            $(function () {
                $("#ddlCodeType").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtCode").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtDescription").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });
            });
        }

        function clearControls() {
            $("#ddlCodeType").val("");
            $("#txtCode").val("");
            $("#txtDescription").val("");
            $("#chkIsActive").prop("checked", false);
        }

        function searchCodeMaster() {
            if ($.fn.DataTable.isDataTable("#tblMakeMaster")) {
                $('#tblMakeMaster tbody').empty();
                $('#tblMakeMaster').DataTable().clear().destroy();
            }

            var codeType = $("#ddlCodeType").val();
            var code = $("#txtCode").val();
            var description = $("#txtDescription").val()
            var isActive = $("#chkIsActive").is(":checked");

            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "MakeMaster/searchMakeMaster")',
                type: "GET",
                dataType: "json",
                data: { codeType : codeType, code: code, description: description, isActive: isActive},
                success: function (data) {
                    if (data != null && data != undefined) {
                        console.log(data);
                        var sno = 0;
                        var rows = "";
                        var row = "";
                        $("#makeMasterBody").html("");
                        $.each(data, function (i, item) {
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewMakeMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editMakeMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteMakeMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.codeType + '</td>' +
                                '<td>' + item.code + '</td>' +
                                '<td>' + item.description + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.creationDate + '</td>' +
                                '<td>' + item.createdByName + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updatedByName + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            row = "";
                            $("#tblMakeMaster").focus();
                        });
                        $("#makeMasterBody").append(rows);
                        bindDataTable();
                    }
                    else {
                        console.log(data);
                        $.confirm({
                            title: 'Code Master List',
                            content: 'Code Master Not Found!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                        var row = '<tr>' +
                            '<td>' +
                            '<div class="d-flex align-items-center">' +
                            '</div>' +
                            '</td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td style="text-align:center">No Data Found!!!</td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '</tr>';
                        $("#makeMasterBody").html(row);
                    }
                }
            });
            //}
        }

        function getMakeMasterList() {
            if ($.fn.DataTable.isDataTable("#tblMakeMaster")) {
                $('#tblMakeMaster tbody').empty();
                $('#tblMakeMaster').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "MakeMaster/getMakeMasterList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        var sno = 0;
                        var rows = "";
                        var row = "";
                        $("#makeMasterBody").html("");
                        $.each(data, function (i, item) {
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewMakeMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editMakeMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteMakeMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.codeType + '</td>' +
                                '<td>' + item.code + '</td>' +
                                '<td>' + item.description + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.creationDate + '</td>' +
                                '<td>' + item.createdByName + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updatedByName + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            row = "";
                            $("#tblMakeMaster").focus();
                        });
                        $("#makeMasterBody").append(rows);
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="9" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#makeMasterBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}