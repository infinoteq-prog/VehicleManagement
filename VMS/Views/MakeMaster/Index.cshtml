@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";

        $(document).ready(function () {
            getCodeType();
            setSideMenu("make-master");
            $("#chkIsActive").attr("checked", true);
            $("#chkIsActive").attr("disabled", true);

            getFunctionName('MAKE MASTER', function (userRights) {
                if (userRights) {
                    console.log("Update Access:", userRights.updateAccess);
                    console.log("Add Access:", userRights.addAccess);
                    console.log("Delete Access:", userRights.deleteAccess);
                    console.log("View Access:", userRights.viewAccess);
                    console.log("Full Access:", userRights.fullAccess);

                    fullAccess = userRights.fullAccess;
                    addAccess = userRights.addAccess;
                    viewAccess = userRights.viewAccess;
                    updateAccess = userRights.updateAccess;
                    deleteAccess = userRights.deleteAccess;
                    if (addAccess === "False") {
                        const buttons = document.querySelectorAll('button[type="button"], input[type="button"]');
                        buttons.forEach(button => {
                            // Prevent removing the trigger button itself, if it also has type="button"
                            if (button.id !== 'removeAllTypeButtonsBtn') {
                                button.remove();
                            }
                        });
                    }
                } else {
                    console.log("Failed to get user rights.");
                }
            });
            if (fullAccess === "True" || addAccess === "True") {
                checkValidationOnChange();
            }
            if (fullAccess === "True" || viewAccess === "True") {
                getUserRoleList();
            }

            $(function () {
                $("#from-date-picker").datepicker({
                    dateFormat: 'dd-mm-yy'
                });

                $("#to-date-picker").datepicker({
                    dateFormat: 'dd-mm-yy'
                });
            });
        });

        function bindDataTable() {
            $('#tblMakeMaster').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "Code Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "Code Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "Code Master List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }

        function checkValidation() {
            var isValid = true;
            if ($("#ddlCodeType").val() == "") {
                $("#ddlCodeType").attr('class', 'form-control vaidationTextBoxError');
                $("#ddlCodeType").focus();
                isValid = false;
            } else {
                $("#ddlCodeType").attr('class', 'form-control');
                $("#ddlCodeType").focus();
            }

            if ($("#txtCode").val() == "") {
                $("#txtCode").attr('class', 'form-control vaidationTextBoxError');
                $("#txtCode").focus();
                isValid = false;
            } else {
                $("#txtCode").attr('class', 'form-control');
                $("#txtCode").focus();
            }

            if ($("#txtDescription").val() == "") {
                $("#txtDescription").attr('class', 'form-control vaidationTextBoxError');
                $("#txtDescription").focus();
                isValid = false;
            } else {
                $("#txtDescription").attr('class', 'form-control');
                $("#txtDescription").focus();
            }
            return isValid;
        }

        function checkValidationOnChange() {
            $(function () {
                $("#ddlCodeType").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtCode").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtDescription").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });
            });
        }

        function clearControls() {
            $("#ddlCodeType").val("");
            $("#txtCode").val("");
            $("#txtDescription").val("");
        }

        function getUserRoleList() {
            if ($.fn.DataTable.isDataTable("#tblMakeMaster")) {
                $('#tblMakeMaster tbody').empty();
                $('#tblMakeMaster').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "MakeMaster/getMakeMasterList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $.each(data, function (i, item) {
                            var sno = 0;
                            var rows = "";
                            var row = "";
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewMakeMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editMakeMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton =  '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteMakeMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.codeType + '</td>' +
                                '<td>' + item.code + '</td>' +
                                '<td>' + item.description + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.creationDate + '</td>' +
                                '<td>' + item.createdByName + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updatedByName + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            $("#makeMasterBody").append(rows);
                            rows = "";
                            $("#tblMakeMaster").focus();
                        });
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="9" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#makeMasterBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }

        function saveMakeMaster() {
            var isValid = checkValidation();

            if (isValid == true) {
                if ($("#ddlCodeType").val() != ""
                    && $("#txtCode").val() != "" 
                    && $("#txtDescription").val() != "") {
                    var codeType = $("#ddlCodeType  option:selected").text();
                    var code = $("#txtCode").val();
                    var description = $("#txtDescription").val()
                    var isActive = true;
                    $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "MakeMaster/Save")',
                        type: "POST",
                        dataType: "json",
                        data: { codeType : codeType,code: code,description: description, isActive: isActive },
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'Save Code Master!',
                                        content: "Code Master has been saved successfully!",
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    //getUserList();
                                                    //clearControls();
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "MakeMaster/Index")';
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'Code Master Already Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                    $("#divMakeMaster").hide();
                                }
                            } else {
                                console.log(data);
                                //clearControls();
                                $.confirm({
                                    title: 'Error Occoured!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divMakeMaster").hide();
                            }
                        }
                    });
                }
            }
        }
    </script>
}