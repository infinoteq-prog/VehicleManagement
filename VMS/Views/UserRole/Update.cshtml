@model VMS.ViewModel.VMUserRole
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
} *@

@* @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleUpdateAccess == true)
{ *@
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Update User Role</h4>
                    <div id="divUpdateUserRole">
                        <form id="frmUserRole" name="frmUserRole" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <input id="hdnUserRoleID" name="hdnUserRoleID" type="hidden">
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <label id="lblMandatoryMessage" class="reqFields">@SiteConstants.ReqFieldMessage</label>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtFirstName"> Role Name: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.Role, new { @class = "form-control", id = "txtRoleName" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="chkIsActive">Is Active:</label>
                                        <div class="col-sm-8">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-label checkboxStyle", id = "chkIsActive" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-12">
                                    <div class="form-group row">
                                        <label class="col-sm-2 col-form-label" for="txtRoleDescription">Role Description: <span class="reqFields">*</span> </label>
                                        <div class="col-sm-10">
                                            @Html.TextAreaFor(m => m.RoleName, new { @class = "form-control", cols = "20", rows = "10", id = "txtRoleDescription" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="from-date-picker">From Date: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="from-date-picker" placeholder="Select From Date" class="form-control" onchange="setTextboxStyle(this);" readonly=" readonly">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="to-date-picker">To Date: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="to-date-picker" placeholder="Select To Date" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                        </div>
                                    </div>
                                </div>
                            </div
                            <div class="row rowHeight">
                                <div class="col-md-12"></div>
                            </div>
                           @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleUpdateAccess == true)
                            { *@
                                <div class="row rowHeight" style="text-align:center;">
                                    <div class="col-md-12">
                                        <button type="button" class="btn btn-primary mr-2" onclick="updateUserRole();">Update</button>
                                        <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button>
                                    </div>
                                </div>
                           @*  } *@
                        </form>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                        @* @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
                        { *@
                            <div id="divUserRole">
                                <div class="table-responsive pt-3">
                                    <table id="tblUserRole" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th>Actions</th>
                                                <th>Role Name</th>
                                                <th>Role Description</th>
                                                <th>Start Date</th>
                                                <th>End Date</th>
                                                <th>Is Active</th>
                                                <th>Creation Date</th>
                                                <th>Created By</th>
                                                <th>Update Date</th>
                                                <th>Updatd By</th>
                                            </tr>
                                        </thead>
                                        <tbody id="userRoleBody">
                                        </tbody>
                                    </table>
                                </div>
                                <input id="hdnSaveRate" name="hdnTotalBasicRate" type="hidden">
                            </div>
                        @* } *@
                    </div>
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";
        $(document).ready(function () {
             setSideMenu("users-role");
            if (fullAccess === "True" || viewAccess === "True") {
                clearControls();
                checkValidationOnChange();
                //getUserRoleList();
                var userRoleID = GetParameterValues('userRoleID');
                getUserRolebyID(userRoleID);
            }
        });

        function bindDataTable() {
            $('#tblUserRole').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "User Role List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "User Role List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "User Role List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }

        function checkValidation() {
            var isValid = true;
            if ($("#txtRoleName").val() == "") {
                $("#txtRoleName").attr('class', 'form-control vaidationTextBoxError');
                $("#txtRoleName").focus();
                isValid = false;
            } else {
                $("#txtRoleName").attr('class', 'form-control');
                $("#txtRoleName").focus();
            }

            if ($("#txtRoleDescription").val() == "") {
                $("#txtRoleDescription").attr('class', 'form-control vaidationTextBoxError');
                $("#txtRoleDescription").focus();
                isValid = false;
            } else {
                $("#txtRoleDescription").attr('class', 'form-control');
                $("#txtRoleDescription").focus();
            }

            if ($("#from-date-picker").val() == "") {
                $("#from-date-picker").attr('class', 'form-control vaidationTextBoxError');
                $("#from-date-picker").focus();
                isValid = false;
            } else {
                $("#from-date-picker").attr('class', 'form-control');
                $("#from-date-picker").focus();
            }

            // if ($("#to-date-picker").val() == "") {
            //     $("#to-date-picker").attr('class', 'form-control vaidationTextBoxError');
            //     $("#to-date-picker").focus();
            //     isValid = false;
            // } else {
            //     $("#to-date-picker").attr('class', 'form-control');
            //     $("#to-date-picker").focus();
            // }
            return isValid;
        }

        function checkValidationOnChange() {
            $(function () {

                $("#txtRoleName").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtRoleDescription").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#from-date-picker").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                // $("#to-date-picker").on("input", function () {
                //     if ($(this).val() == "") {
                //         $(this).attr('class', 'form-control vaidationTextBoxError');
                //         $(this).focus();
                //     } else {
                //         $(this).attr('class', 'form-control');
                //         $(this).focus();
                //     }
                // });
            });
        }

        function clearControls() {
            $("#from-date-picker").val("");
            $("#to-date-picker").val("");
            $("#txtRoleName").val("");
            $("#txtRoleDescription").val("");
            $("#chkIsActive").prop("checked", false);
        }

        function getUserRoleList() {
            if ($.fn.DataTable.isDataTable("#tblUserRole")) {
                $('#tblUserRole tbody').empty();
                $('#tblUserRole').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "UserRole/getUserRoleList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $.each(data, function (i, item) {
                            var sno = 0;
                            var rows = "";
                            var row = "";
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewUserRole(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editUserRole(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteUserRole(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.role + '</td>' +
                                '<td>' + item.roleName + '</td>' +
                                '<td>' + item.startDateString + '</td>' +
                                '<td>' + item.endDateString + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.createDate + '</td>' +
                                '<td>' + item.createdBy + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updateBy + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            $("#userRoleBody").append(rows);
                            rows = "";
                            $("#tblUserRole").focus();
                        });
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="10" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#userRoleBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }

        function updateUserRole() {
            var isValid = checkValidation();

            if (isValid == true) {
                if ($("#txtRoleName").val() != ""
                    && $("#from-date-picker").val() != ""
                    // && $("#to-date-picker").val() != ""
                    && $("#txtRoleDescription").val() != "") {
                    var roleName = $("#txtRoleName").val();
                    var roleDescription = $("#txtRoleDescription").val();
                    var isActive = $("#chkIsActive").is(":checked");
                    var id = $('#hdnUserRoleID').val();
                    var startDate = $("#from-date-picker").val();
                    var endDate = $("#to-date-picker").val();
                    var fromDate = startDate.split("-").reverse().join("-");
                    var toDate = "";
                    if(endDate != "") {
                        toDate = endDate.split("-").reverse().join("-");
                    }

                    $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "UserRole/Update")',
                        type: "POST",
                        dataType: "json",
                        data: { id: id, roleName: roleName, roleDescription: roleDescription, isActive: isActive, startDate: fromDate, endDate: toDate},
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'Update User Role!',
                                        content: "User Role has been updated successfully!",
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    clearControls();
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "UserRole/Update?userRoleID=")' + $("#hdnUserRoleID").val();
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'User Role Already Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                    $("#divUserRole").hide();
                                }
                            } else {
                                console.log(data);
                                //clearControls();
                                $.confirm({
                                    title: 'Error Occoured!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divUserRole").hide();
                            }
                        }
                    });
                }
            }
        }

        function getUserRolebyID(userRoleID) {
            if ($.fn.DataTable.isDataTable("#tblUserRole")) {
                $('#tblUserRole tbody').empty();
                $('#tblUserRole').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "UserRole/getUserRolebyID")',
                type: "GET",
                data: { userRoleID: userRoleID },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        var sno = 0;
                        var rows = "";
                        var row = "";
                        sno = sno + 1;
                        if (fullAccess === "True" || viewAccess === "True") {
                            viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewUserRole(\'' + data.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || updateAccess === "True") {
                            updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editUserRole(\'' + data.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || deleteAccess === "True") {
                            deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteUserRole(\'' + data.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                        }
                        row = '<tr>' +
                            '<td>' +
                            '<div class="d-flex align-items-center">' +
                            viewButton +
                            updateButton +
                            deleteButton +
                            '</div>' +
                            '</td>' +
                            '<td>' + data.role + '</td>' +
                            '<td>' + data.roleName + '</td>' +
                            '<td>' + data.startDateString + '</td>' +
                            '<td>' + data.endDateString + '</td>' +
                            '<td>' + data.isActive + '</td>' +
                            '<td>' + data.createDate + '</td>' +
                            '<td>' + data.createdBy + '</td>' +
                            '<td>' + data.updateDate + '</td>' +
                            '<td>' + data.updateBy + '</td>' +
                            '</tr>';

                        //Setting User Role Details to Page Controls
                        $('#txtRoleName').val(data.role);
                        $('#txtRoleDescription').val(data.roleName);
                        $("#chkIsActive").prop('checked', data.isActive);
                        $('#hdnUserRoleID').val(data.id);
                        $('#from-date-picker').val(data.startDateString);
                        $('#to-date-picker').val(data.endDateString);
                     
                        rows = rows + row;
                        $("#userRoleBody").html(rows);
                        rows = "";
                        $("#tblUserRole").focus();

                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="10" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#userRoleBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}