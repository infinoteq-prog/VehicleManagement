@{
}
@model VMS.ViewModel.VMDriverHisab
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Driver Hisab Add/Update";
}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Add Driver Hisab</h4>
                    <div>
                        <form id="frmDriverHisabMaster" name="frmDriverHisabMaster" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <input id="hdnDriverHisabID" name="hdnDriverHisabID" type="hidden">
                            <input id="hdnLastSettlementId" name="hdnLastSettlementId" type="hidden">
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <label id="lblMandatoryMessage" class="reqFields">@utilityHelper.reqFieldMessage</label>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtDriverName">Driver Name:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlDriver" name="ddlDriver" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtDriverFatherName">Driver Father Name: <span class="reqFields">*</span> </label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtDriverFatherName" class="form-control alphanumericonlywithspace" maxlength="100" onchange="setTextboxStyle(this);" placeholder="Please Enter Driver Father Name" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtTripNumber">Settlement Number:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtSettlementNumber" placeholder="Enter a settlement number." class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-12">
                                    <div class="form-group row">
                                        <h5>Previous Trip History :</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripStartDate">LastTrip Start Date:</label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtLastTripStartDate" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripEndDate">LastTrip End Date:</label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtLastTripEndDate" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripRouteDesc">LastTrip Route Desc:</label>
                                        <div class="col-sm-8">
                                            @Html.TextAreaFor(m => m.RouteDescription, new { @class = "form-control", cols = "10", rows = "5", id = "txtLastTripRouteDesc", @readonly="readonly" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtLastTripVehicle">LastTrip Vehicle:</label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtLastTripVehicle" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                        <div class="row rowHeight">
                            <div class="col-md-12">
                                <div class="form-group row">
                                    <h5>New Route:</h5>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card" style="padding: 15px; margin-bottom: 20px; border: 1px solid #ccc; border-radius: 6px;">
                                <div class="row rowHeight">
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label class="col-sm-4 col-form-label" for="ddlVehicleNo">Vehicle No:<span class="reqFields">*</span> </label>
                                            <div class="col-sm-8">
                                                <select class="form-control" id="ddlVehicleNo" name="ddlVehicleNo" onchange="setDropDownStyle(this);"></select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="from-date-picker">Trip Start Date : <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="from-date-picker" placeholder="Select From Date" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="to-date-picker">Trip End Date : <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="to-date-picker" placeholder="Select To Date" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtOpeningAmount">Opening Amount:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                                <input type="text" id="txtOpeningAmount" class="form-control numberonly" maxlength="20" onchange="setTextboxStyle(this);" placeholder="Please Enter Opening Amount" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtClosingAmount">Closing Amount:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                                <input type="text" id="txtClosingAmount" class="form-control numberonly" maxlength="20" onchange="setTextboxStyle(this);" placeholder="Please Enter Closing Amount" />
                                        </div>
                                    </div>
                                </div>                                
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtWeight">Weight:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                                <input type="number" id="txtWeight" class="form-control" maxlength="20" placeholder="Please Enter Weight" min="0" step="any">
                                            </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtTripDescription">Trip Desc :<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                             <textarea id="txtTripDescription" class="form-control" maxlength="300" onchange="setTextboxStyle(this);" placeholder="Please Enter Route Description" rows="3"></textarea>
                                       </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                            <!-- Expense Lines Table -->
                       <div class="row rowHeight">
                        <div class="col-md-12">
                            <div class="form-group row">
                                <h5>Expense Details:</h5>
                            </div>
                        </div>
                      </div>

                    <div class="card" style="padding: 15px; margin-bottom: 20px; border: 1px solid #ccc; border-radius: 6px;">
                        <div class="row rowHeight align-items-center">
                             <div class="col-md-3">
                                <div class="form-group">
                                    <label  for="ddlExpenseHead">Narration: <span class="reqFields">*</span></label>
                                    <select class="form-control" id="ddlExpenseHead" name="ddlExpenseHead">
                                            <!-- Vendor options will be populated here from VendorMaster API -->
                                        </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label  for="txtGroup">Group <span class="reqFields">*</span></label>
                                    <input type="text" id="txtGroup" class="form-control" disabled onchange="setTextboxStyle(this);" placeholder="Please Enter Group" />
                                    
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label for="txtAmountDR">Amount Debit: <span class="reqFields">*</span></label>
                                         <input type="text" id="txtAmountDR" class="form-control numberonly" maxlength="10" onchange="setTextboxStyle(this);" placeholder="Please Enter Amount Debit" />
                                  
                                </div>
                            </div>
                             <div class="col-md-2">
                                <div class="form-group">
                                    <label for="txtAmountCR">Amount Credit: <span class="reqFields">*</span></label>
                                   <input type="text" id="txtAmountCR" class="form-control numberonly" maxlength="10" onchange="setTextboxStyle(this);" placeholder="Please Enter Amount Credit" />
                                    
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group row">
                                    <div class="col-md-12">
                                        <button type="button" class="btn btn-primary" style="margin-top: 16px;" id="btnAddExpense" onclick="addExpense();">Add</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table id="expenseListTable" class="table table-bordered">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="width: 120px;display:none;">ExpenseHeadId/th>
                                        <th style="width: 120px;">Expense Name</th>
                                        <th style="width: 120px;">Head</th>
                                        <th style="width: 120px;">Amount Dr</th>
                                        <th style="width: 120px;">Amount Cr</th>
                                        <th style="width: 120px;">Closing Balance</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Table rows will be dynamically added here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
   

                           @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleAddAccess == true)
                            { *@
                                <div class="row rowHeight" style="text-align:center;">
                                    <div class="col-md-12">
                                    <button type="button" id="saveButton" class="btn btn-primary mr-2" onclick="saveDriverHisab();">Save</button>
                                        <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button>
                                    </div>
                                </div>
                            @* } *@
                        </form>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script type="text/javascript">
    var fullAccess = 'True';
    var addAccess = 'True';
    var viewAccess = 'True';
    var updateAccess = 'True';
    var deleteAccess = 'True';

    var viewButton = "";
    var updateButton = "";
    var deleteButton = "";

    $(document).ready(function () {
        
        $('#ddlExpenseHead').select2();
        //Fill Vehicle Master DropdownList
        setSideMenu("driver-hisab-master");
        getVehicleNumber();
        getDriverMaster();
        getExpenseHeadMasterdata();
        if (fullAccess === "True" || addAccess === "True") {
            //checkValidationOnChange();
            //getDieselHisabByVehicle(); 
        }

        $(function () {
            $("#ddlVehicleNo").change(function () {
                
            });

            $("#ddlDriver").change(function () {
                    var selectedValue = $(this).val();
                    getCurrentSettlementNumber($(this).val());
                    getDriverFather();
            });

             $("#ddlExpenseHead").change(function () {
                    var selectedOption = $(this).find('option:selected');
                        var description = selectedOption.data('description');
                     $("#txtGroup").val(description);
            });

        });

            //Check if Page is Opening on Edit Click
            var settlementId = GetParameterValues('settlementId');
        if (settlementId && settlementId.length > 0 && parseInt(settlementId[0]) > 0) {
            document.getElementById("saveButton").textContent = "Update";
                getDriverHisabById(settlementId);
        }

    });

    function setDropDownStyle(cltr){
        if ($(cltr).find(":selected").val() == "0") {
            $(cltr).attr('class', 'form-control vaidationTextBoxError');
        } else {
            $(cltr).attr('class', 'form-control');
        }
    }

    function setTextboxStyle(cltr) {
        if ($(cltr).val() == "") {
            $(cltr).attr('class', 'form-control vaidationTextBoxError');
        } else {
            $(cltr).attr('class', 'form-control');
        }
    }

    function checkValidation() {
        var isValid = true;
        if ($('#ddlVehicleNo option:selected').val() == "0" || $('#ddlState option:selected').val() == "") {
            $("#ddlVehicleNo").attr('class', 'form-control vaidationTextBoxError');
            $("#ddlVehicleNo").focus();
            isValid = false;
        } else {
            $("#ddlVehicleNo").attr('class', 'form-control');
            $("#ddlVehicleNo").focus();
        }
        
        return isValid;
    }

    function checkValidationOnChange() {
        $(function () {
            $("#ddlVehicleNo").change(function () {
                if ($('option:selected', this).val() == "0" || $('option:selected', this).val() == "") {
                    $(this).attr('class', 'form-control vaidationTextBoxError');
                    $(this).focus();
                } else {
                    $(this).attr('class', 'form-control');
                    $(this).focus();
                }
            });

            $("#ddlDriver").change(function () {
                if ($('option:selected', this).val() == "0" || $('option:selected', this).val() == "") {
                    $(this).attr('class', 'form-control vaidationTextBoxError');
                    $(this).focus();
                } else {
                    $(this).attr('class', 'form-control');
                    $(this).focus();
                }
            });

            $("#txtFatherName").on("input", function () {
                if ($(this).val() == "") {
                    $(this).attr('class', 'form-control vaidationTextBoxError');
                    $(this).focus();
                } else {
                    $(this).attr('class', 'form-control');
                    $(this).focus();
                }
            });
        });
    }

    function clearControls() {
        $("#ddlVehicleNo").prop("selectedIndex", 0).val();
        $("#ddlDriver").prop("selectedIndex", 0).val();
        $("#txtFatherName").val("");
    }

    function getCurrentSettlementNumber(driverId) {
        $.ajax({
            cache: false,
                url: '@(utilityHelper.SiteUrl() + "DriverHisab/getCurrentSettlementNumber")',
            type: "GET",
                data: { driverId: driverId },
            dataType: "json",
            success: function (data) {
                if (data != null && data != undefined) {
                        $("#txtSettlementNumber").val(data.settlementNo);
                        getLastDriverTripHistory(driverId);
                } else {
                    console.log(data);
                }
            }
        });
    }

    function getLastDriverTripHistory(driverId) {
        $.ajax({
            cache: false,
                url: '@(utilityHelper.SiteUrl() + "DriverHisab/getLastDriverTripHistory")',
            type: "GET",
                data: { driverId: driverId },
            dataType: "json",
                success: function (data) {  
                if (data != null && data != undefined) {
                    $("#hdnLastSettlementId").val(data.settlementNo);
                    $("#txtLastTripStartDate").val(data.lastTripStartDate);
                    $("#txtLastTripEndDate").val(data.lastTripEndDate);
                    $("#txtLastTripRouteDesc").val(data.lastTripRouteDescr);
                    $("#txtLastTripVehicle").val(data.vehicleNumber);
                        $("#txtOpeningAmount").val(data.closingBalance);
                } else {
                    $("#txtLastTripStartDate").val("N/A");
                    $("#txtLastTripEndDate").val("N/A");
                    $("#txtLastTripRouteDesc").val("N/A");
                    $("#txtLastTripVehicle").val("N/A");
                    $("#txtOpeningAmount").val("0")

                    $.confirm({
                        title: 'Last Trip Not Found',
                            content: 'Driver - ' + $("#ddlDriver option:selected").text() + ' Last Trip Not Found!',
                        icon: 'fa fa-warning',
                        type: 'red',
                        buttons: {
                            omg: {
                                text: 'OK',
                                btnClass: 'btn-red',
                            },
                        }
                    });
                    console.log(data);
                }
            }
        });
    }

    function saveDriverHisab() {
        var isValid = checkValidation();
        if (isValid == true) {

                if ($('#ddlVehicleNo option:selected').val() != "0" &&
                $('#ddlDriver option:selected').val() != "0" &&
                $("#txtTripNumber").val() != "" &&
                $("#txtFatherName").val() != "" &&
                $("#txtStartOdometer").val() != "" &&
                $("#txtEndOdometer").val() != "" &&
                $("#txtRunningKm").val() != "" &&
                $("#from-date-picker").val() != "" &&
                $("#to-date-picker").val() != "" && 
                $("#txtOpeningAmount").val() != "" &&
                $("#txtTripDescription").val() != ""){

                var tripStartDate = $("#from-date-picker").val().split("-").reverse().join("-");
                var tripEndDate = $("#to-date-picker").val().split("-").reverse().join("-");

                var formData = new FormData();

                    var settlementNo = $('#hdnDriverHisabID').val();
                    if (settlementNo && settlementNo.length > 0 && parseInt(settlementNo[0]) > 0) {
                        formData.append("settlementNo", settlementNo);
                    }
                     formData.append("settlementNumber",  $("#txtSettlementNumber").val());
                      formData.append("lastSettlementId", $('#hdnLastSettlementId').val());
                formData.append("vehicleNo", $("#ddlVehicleNo option:selected").val());
                formData.append("driverId", $("#ddlDriver option:selected").val());
                formData.append("driverName", $("#ddlDriver option:selected").text());
                formData.append("driverFatherName", $("#txtFatherName").val());
                formData.append("tripStartDate", tripStartDate);
                formData.append("tripEndDate", tripEndDate);
                formData.append("settlementDate", tripEndDate);
                formData.append("weight", $("#txtWeight").val());
                formData.append("openingBalance", $("#txtOpeningAmount").val());
                formData.append("closingBalance", $("#txtClosingAmount").val());
                formData.append("tripRouteDescription", $("#txtTripDescription").val());


                    // Expense Entries from Table
                    $("#expenseListTable tbody tr").each(function (index, row) {
                        var expenseCode = $(row).find("td:eq(0)").text();
                        var expenseType = $(row).find("td:eq(1)").text();                        
                        var drAmt = $(row).find("td:eq(3)").text();
                        var crAmt = $(row).find("td:eq(4)").text();

                        formData.append(`_lstDriverLine[${index}].ExpenseCode`, expenseCode);
                        formData.append(`_lstDriverLine[${index}].ExpenseType`, expenseType);
                        formData.append(`_lstDriverLine[${index}].CrAmt`, crAmt);
                        formData.append(`_lstDriverLine[${index}].DrAmt`, drAmt);
                    });
               
                $.ajax({
                    cache: false,
                        url: '@(utilityHelper.SiteUrl() + "DriverHisab/SaveUpdate")',
                    type: "POST",
                    dataType: "json",
                    processData: false,
                    contentType: false,
                    data: formData,
                    success: function (data) {
                        if (data != null && data != undefined) {
                            if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                console.log(data);
                                $.confirm({
                                    title: 'Save Driver Hisab!',
                                        content: "Driver Hisab has been saved successfully!",
                                    type: 'green',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-green',
                                            action: function () {
                                                //getUserList();
                                                //clearControls();
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "DriverHisab/List")';
                                            }
                                        },
                                    }
                                });
                            } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                $.confirm({
                                    title: 'Driver Hisab Already Exists!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divDriverHisabMaster").hide();
                            }
                        } else {
                            console.log(data);
                            //clearControls();
                            $.confirm({
                                title: 'Error Occoured!',
                                content: data.transactionMessage.message,
                                icon: 'fa fa-warning',
                                type: 'red',
                                buttons: {
                                    omg: {
                                        text: 'OK',
                                        btnClass: 'btn-red',
                                    },
                                }
                            });
                            $("#divDriverHisabMaster").hide();
                        }
                    }
                });
            }
        }else{

        }
    }

    function getDriverFather(){
        var driverMasterId = $('#ddlDriver option:selected').val();
        $.ajax({
            cache: false,
            url: '@(utilityHelper.SiteUrl() + "DriverMaster/getDriverFather")',
            type: "GET",
            data: { driverMasterId: driverMasterId },
            dataType: "json",
            success: function (data) {
                if (data != null && data != undefined) {
                    console.log(data);
                        $("#txtDriverFatherName").val(data.driverFatherName);
                } else {
                    console.log(data);
                }
            }
        });
    }
    </script>

     @* Add Expense Section  *@
    <script>

            var expenseList = [];
            
            // function calculateClosingBalance(tableId, initialAmount) {
            //     var table = document.getElementById(tableId);
