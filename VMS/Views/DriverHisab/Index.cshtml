            function addExpense() {

                    var openingBalance = $("#txtOpeningAmount").val();
                        openingBalance = openingBalance ? parseFloat(openingBalance) : 0;
                    // Get the values from the input fields
                    var expenseHeadId = $("#ddlExpenseHead").val();
                    var expenseHeadText = $("#ddlExpenseHead option:selected").text();
                    var group = $("#txtGroup").val();
                    var amountDR = $("#txtAmountDR").val();
                    var amountCR = $("#txtAmountCR").val();
                
                    // Validate the input fields
                    if (expenseHeadId === "0") {
                        alert("Please select a Narration.");
                        return;
                    }
                    if (group === "") {
                        alert("Please enter a Group.");
                        return;
                    }
                    if (amountDR === "" && amountCR === "") {
                                    alert("Please enter an Amount.");
                                    return;
                                }

            if (Math.round(amountDR) > 0 && Math.round(amountCR) >0) {
                      alert("Please enter either DR amount or CR amount.");
                         return;
                     }
                
                    // Create a new row object
                    var newExpense = {
                        expenseHeadId: expenseHeadId,
                        group: group,
                        expenseHeadText: expenseHeadText,
                        amountDR: amountDR,
                        amountCR: amountCR,
                    };
                
                    expenseList.push(newExpense); //push to array
                
                    // Create a new row in the table
                    var newRow = $("<tr>");
                    newRow.append("<td style=\"display:none;\">" + expenseHeadId + "</td>");
                    newRow.append("<td>" + group + "</td>");
                    newRow.append("<td>" + expenseHeadText + "</td>");
                    newRow.append("<td>" + amountDR + "</td>");
                    newRow.append("<td>" + amountCR + "</td>");
                    newRow.append("<td></td>"); //leave blank for now
                    // Add a delete button to the row
                    var deleteButton = $("<button>")
                        .addClass("btn btn-danger btn-sm")
                        .text("Delete")
                        .on("click", function() {
                            // Remove the row when the delete button is clicked
                            var rowToDelete = $(this).closest("tr");
                             var rowIndex = rowToDelete.index();
                            expenseList.splice(rowIndex, 1); // Remove from the array
                            rowToDelete.remove();
                            calculateClosingBalance('expenseListTable', openingBalance);
                        });
                    var actionCell = $("<td>").append(deleteButton);
                    newRow.append(actionCell);
                
                    // Add the new row to the table
                    $("#expenseListTable tbody").append(newRow);
                
                    // Clear the input fields
                    $("#ddlExpenseHead").val("0");
                    $("#txtGroup").val("");
                    $("#txtAmountDR").val("");
                    $("#txtAmountCR").val("");
                
                    calculateClosingBalance('expenseListTable', openingBalance);
                }
            
            </script>

            @* Edit driver Hisab *@
            <script>
            function calculateClosingBalance(tableId, initialAmount) {
            var table = document.getElementById(tableId);
            var rows = table.getElementsByTagName("tbody")[0].rows;
            var previousBalance = initialAmount;

            for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            var debit = parseFloat(row.cells[3].textContent) || 0;
            var credit = parseFloat(row.cells[4].textContent) || 0;
            previousBalance = previousBalance + debit - credit;
            row.cells[5].textContent = previousBalance.toFixed(2);
            }

            $("#txtClosingAmount").val(previousBalance);
            return previousBalance; // Return the final balance
            }
            function getDriverHisabById(settlementId) {
            $.ajax({
            cache: false,
            url: '@(utilityHelper.SiteUrl() + "DriverHisab/getDriverHisablWithId")',
            type: "GET",
            data: { settlementId: settlementId },
            dataType: "json",
            success: function (data) {
            if (data) {
            // Bind the form controls
            $("#hdnDriverHisabID").val(data.settlementNo);
            $("#hdnLastSettlementId").val(data.lastSettlementId);
            $("#ddlDriver").val(data.driverId);  // Assuming data.driverId holds the driver's ID
            $("#txtDriverFatherName").val(data.driverFatherName);
            $("#txtSettlementNumber").val(data.settlementNo);

            //Last Trip Detail
            try{
            $("#txtLastTripStartDate").val(data.lastTripHistory.lastTripStartDate);
            $("#txtLastTripEndDate").val(data.lastTripHistory.lastTripEndDate);
            $("#txtLastTripRouteDesc").val(data.lastTripHistory.lastTripRouteDescr);
            $("#txtLastTripVehicle").val(data.lastTripHistory.vehicleNumber);
            }catch{}

            $("#ddlVehicleNo").val(data.vehicleNo);
            $("#from-date-picker").val(data.tripStartDate);
            $("#to-date-picker").val(data.tripEndDate);
            $("#txtOpeningAmount").val(data.openingBalance);
            $("#txtClosingAmount").val(data.closingBalance);
            $("#txtWeight").val(data.weight);
            $("#txtTripDescription").val(data.tripRouteDescr);

            // Bind the expense list table
            var expenseTableBody = $("#expenseListTable tbody");
            expenseTableBody.empty(); // Clear any existing rows

            if (data.expenseList && data.expenseList.length > 0) {
            data.expenseList.forEach(function (expense) {
                var newRow = $("<tr>");
                newRow.append("<td style=\"display:none;\">" + expense.expenseCode + "</td>");
                newRow.append("<td>" + expense.code + "</td>");
                newRow.append("<td>" + expense.description + "</td>");
                newRow.append("<td>" + expense.drAmt + "</td>");
                newRow.append("<td>" + expense.crAmt + "</td>");
                newRow.append("<td>" + expense.closingBalance + "</td>");

                 var deleteButton = $("<button>")
                        .addClass("btn btn-danger btn-sm")
                        .text("Delete")
                        .on("click", function () {
                            $(this).closest("tr").remove();
                            calculateClosingBalance('expenseListTable', data.openingBalance);
                        });
                    var actionCell = $("<td>").append(deleteButton);
                    newRow.append(actionCell);
                    expenseTableBody.append(newRow);
            });
            calculateClosingBalance('expenseListTable', data.openingBalance);
            }
            else {
            calculateClosingBalance('expenseListTable', data.openingBalance);
            }
            }
            },
            error: function (xhr, status, error) {
            console.error("Error fetching data:", error);
            }
            });
            }
            </script>
