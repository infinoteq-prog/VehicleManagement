@model VMS.ViewModel.VMGstRateMaster
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Driver Hisab Master";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1 class="page-title">Driver Hisab List</h1>
            <div class="card">
                <div class="card-body">
                    <form id="searchDriverHisabForm">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="ddlVehicleNo">Vehicle No</label>
                                    <select class="form-control" id="ddlVehicleNo" name="ddlVehicleNo">
                                        <!-- Options will be dynamically populated here -->
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="ddlDriver">Driver</label>
                                    <select class="form-control" id="ddlDriver" name="ddlDriver">
                                        <!-- Options will be dynamically populated here -->
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="txtTripStartDate">Trip Start Date</label>
                                    <input type="date" class="form-control" id="txtTripStartDate" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="txtTripEndDate">Trip End Date</label>
                                    <input type="date" class="form-control" id="txtTripEndDate" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="txtOpeningDiesel">Opening Balance</label>
                                    <input type="number" class="form-control" id="txtOpeningDiesel" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-primary mt-4" onclick="searchDriverHisabMaster()">Search</button>
                            </div>
                        </div>
                    </form>

                    <table id="tblDriverHisabMasterList" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Id</th>
                                <th>Approved Status</th>
                                <th>Driver Name</th>
                                <th>Vehicle No</th>
                                <th>Trip Start Date</th>
                                <th>Trip End Date</th>                               
                                <th>Opening Amount</th>
                                <th>Closing Amount</th>
                                <th>Creation Date</th>
                                <th>Created By</th>
                                <th>Update Date</th>
                                <th>Updated By</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dynamic Rows Will Appear Here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script type="text/javascript">
        // Set permissions for accessing and interacting with records
        var fullAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        var approvalAccess = 'True';

        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";

        $(document).ready(function () {
            $('#ddlVehicleNo').select2();
            $('#ddlDriver').select2();
            $('[data-toggle="tooltip"]').tooltip(); 
            getUserAccess();
            setSideMenu("driver-hisab-master");
            getFunctionName('DRIVER HISAB', function (userRights) {
                if (userRights) {
                    console.log("Update Access:", userRights.updateAccess);
                    console.log("Add Access:", userRights.addAccess);
                    console.log("Delete Access:", userRights.deleteAccess);
                    console.log("View Access:", userRights.viewAccess);
                    console.log("Full Access:", userRights.fullAccess);

                    fullAccess = userRights.fullAccess;
                    addAccess = userRights.addAccess;
                    viewAccess = userRights.viewAccess;
                    updateAccess = userRights.updateAccess;
                    deleteAccess = userRights.deleteAccess;
                    
                } else {
                    console.log("Failed to get user rights.");
                }
            });
            if (fullAccess === "True" || viewAccess === "True") {
                getVehicleNumber();
                getDriverMaster();
                searchDriverHisabMaster(); // Load diesel data on page load
            }
        });

        function getUserAccess() {
            var roleName = '@ViewBag.roleName';
            if (roleName === 'User') {
                fullAccess = 'false';
                approvalAccess = 'false';
            }
        }

        function bindDataTable() {
            $('#tblDriverHisabMasterList').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "Driver Hisab Master List";
                        }
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "Driver Hisab Master List";
                        }
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0'
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "Driver Hisab Master List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4'
                    }
                ]
            });
        }

        function searchDriverHisabMaster() {
            if ($.fn.DataTable.isDataTable("#tblDriverHisabMasterList")) {
                $('#tblDriverHisabMasterList tr').remove();
                $('#tblDriverHisabMasterList tbody').empty();
                $('#tblDriverHisabMasterList').DataTable().clear().destroy();
            }

            var vehicleNo = $('#ddlVehicleNo option:selected').val();
            var driverId = $('#ddlDriver option:selected').val();
            var tripStartDate = $("#txtTripStartDate").val();
            var tripEndDate = $("#txtTripEndDate").val();
            var openingDiesel = $("#txtOpeningDiesel").val();

            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DriverHisab/searchDriverHisabMaster")',
                type: "POST",
                dataType: "json",
                data: {
                    id: 0, // Id can be added if needed, for now it's set to 0
                    vehicleNo: vehicleNo,
                    driverId: driverId,
                    tripStartDate: tripStartDate,
                    tripEndDate: tripEndDate,
                    openingDiesel: openingDiesel
                },
                success: function (data) {
                    if (data != null && data.length > 0) {
                        var rows = "";
                        $.each(data, function (i, item) {

                                 if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" title="View" data-toggle="tooltip" data-placement="top" onclick="viewDriverHisabMaster(\'' + item.settlementNo + '\');"> <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" title="Edit" data-toggle="tooltip" data-placement="top" onclick="editDriverHisabMaster(\'' + item.settlementNo + '\');"> <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || approvalAccess === "True") {
                                approvalButton = '<button id="approveConfirm" type="button" class="btn btn-warning btn-sm btn-icon-text mr-3" title="Approve" data-toggle="tooltip" data-placement="top" onclick="approvalDriverHisabMaster(\'' + item.settlementNo + '\',\'' + item.approvedStatus + '\');"> <i class="typcn typcn-thumbs-up btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                printButton = '<button type="button" class="btn btn-primary btn-sm btn-icon-text mr-3" title="Print" data-toggle="tooltip" data-placement="top" onclick="printDriverHisabMaster(\'' + item.settlementNo + '\');"> <i class="typcn typcn-printer btn-icon-append"></i></button> ';
                                                                                   }


                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" title="Delete" data-toggle="tooltip" data-placement="top" onclick="deleteDriverHisabMaster(\'' + item.settlementNo + '\');"> <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }

                            var row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                approvalButton+
                                printButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.settlementNo + '</td>' +
                                '<td>' + item.approvedStatus + '</td>' +
                                '<td>' + item.driverName + '</td>' +
                                '<td>' + item.vehicleNumber + '</td>' +
                                '<td>' + item.tripStartDate + '</td>' +
                                '<td>' + item.tripEndDate + '</td>' +
                                '<td>' + item.openingBalance + '</td>' +
                                '<td>' + item.closingBalance + '</td>' +
                                '<td>' + item.creationDate + '</td>' +
                                '<td>' + item.driverHeaderCreatedByName + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.driverHeaderUpdatedByName + '</td>' +
                                '</tr>';
                            rows += row;
                        });
                        $("#tblDriverHisabMasterList tbody").html(rows);
                        bindDataTable();
                    } else {
                        var row = '<tr><td colspan="12" style="text-align:center">No Data Found!</td></tr>';
                        $("#tblDriverHisabMasterList tbody").html(row);
                    }
                },
                error: function (ex) {
                    alert("Error: " + ex);
                }
            });
        }

        function getDriverHisabMasterList() {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DriverHisab/searchDriverHisabMaster")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    if (data != null && data.length > 0) {
                        var rows = "";
                        $.each(data, function (i, item) {
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" title="View" data-toggle="tooltip" data-placement="top" onclick="viewDriverHisabMaster(\'' + item.settlementNo + '\');"> <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" title="Edit" data-toggle="tooltip" data-placement="top" onclick="editDriverHisabMaster(\'' + item.settlementNo + '\');"> <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || approvalAccess === "True") {
                                approvalButton = '<button id="approveConfirm" type="button" class="btn btn-warning btn-sm btn-icon-text mr-3" title="Approve" data-toggle="tooltip" data-placement="top" onclick="approvalDriverHisabMaster(\'' + item.settlementNo + '\',\'' + item.approvedStatus + '\');"> <i class="typcn typcn-thumbs-up btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                printButton = '<button type="button" class="btn btn-primary btn-sm btn-icon-text mr-3" title="Print" data-toggle="tooltip" data-placement="top" onclick="printDriverHisabMaster(\'' + item.settlementNo + '\');"> <i class="typcn typcn-printer btn-icon-append"></i></button> ';
                            }


                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" title="Delete" data-toggle="tooltip" data-placement="top" onclick="deleteDriverHisabMaster(\'' + item.settlementNo + '\');"> <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }

                            var row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                approvalButton+
                                printButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.settlementNo + '</td>' +
                                '<td>' + item.approvedStatus + '</td>' +
                                '<td>' + item.driverName + '</td>' +
                                '<td>' + item.vehicleNo + '</td>' +
                                '<td>' + item.tripStartDate + '</td>' +
                                '<td>' + item.tripEndDate + '</td>' +
                                '<td>' + item.openingBalance + '</td>' +
                                '<td>' + item.closingBalance + '</td>' +
                                '<td>' + item.creationDate + '</td>' +
                                '<td>' + item.driverHeaderCreatedByName + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.driverHeaderUpdatedByName + '</td>' +
                                '</tr>';
                            rows += row;
                        });
                        $("#tblDriverHisabMasterList tbody").html(rows);
                        bindDataTable();
                    } else {
                        var row = '<tr><td colspan="12" style="text-align:center">No Data Found!</td></tr>';
                        $("#tblDriverHisabMasterList tbody").html(row);
                    }
                },
                error: function (ex) {
                    alert("Error: " + ex);
                }
            });
        }
    </script>
}
