@model VMS.ViewModel.VMDistanceMaster
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
}
@if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
{ *@
<div class="content-wrapper">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Distance Master List</h4>
                    <div class="row rowHeight">
                        <div class="row rowHeight">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-4 col-form-label" for="txtRouteDescription">Route Description: </label>
                                    <div class="col-sm-8">
                                        @Html.TextBoxFor(m => m.RouteDescription, new { @class = "form-control", id = "txtRouteDescription", @maxlength = "200" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-4 col-form-label" for="txtDistance">Distance: </label>
                                    <div class="col-sm-8">
                                        @Html.TextBoxFor(m => m.Distance, new { @class = "form-control numberonly", id = "txtDistance", @maxlength = "10" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-6">
                            <div class="form-group row" style="display:none;">
                                <label class="col-sm-4 col-form-label" for="chkIsActive">Is Active:</label>
                                <div class="col-sm-8">
                                    @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-label checkboxStyle", id = "chkIsActive" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group row">
                            </div>
                        </div>
                    </div>
                    <div class="row rowHeight" style="text-align:center;">
                        <div class="col-md-12"></div>
                    </div>
                    @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
                        { *@
                    <div class="row rowHeight" style="text-align:center;">
                        <div class="col-md-12">
                            <button type="button" class="btn btn-primary mr-2" onclick="searchDistanceMaster();">Search</button>
                            @* <button type="button" class="btn btn-primary mr-2" onclick="getMakeMasterList();">View All</button> *@
                            <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button>
                        </div>
                    </div>
                    @*  } *@
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group row">
                                <div class="col-sm-12"></div>
                            </div>
                        </div>
                    </div>
                    @* @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
                    { *@
                    <div id="divDistanceMaster">
                        <div class="table-responsive pt-3">
                            <table id="tblDistanceMaster" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th>Actions</th>
                                        <th>Route Description</th>
                                        <th>Distance</th>
                                        <th>Is Active</th>
                                        <th>Creation Date</th>
                                        <th>Created By</th>
                                        <th>Update Date</th>
                                        <th>Updatd By</th>
                                    </tr>
                                </thead>
                                <tbody id="distanceMasterBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                    @* } *@
                </div>
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";

        $(document).ready(function () {
            setSideMenu("distance-master");
            if (fullAccess === "True" || viewAccess === "True") {
                //checkValidationOnChange();
                getDistanceMasterList();
                $(function () {
                    $("#from-date-picker").datepicker({
                        dateFormat: 'dd-mm-yy'
                    });

                    $("#to-date-picker").datepicker({
                        dateFormat: 'dd-mm-yy'
                    });
                });
            }
        });

        function bindDataTable() {
            $('#tblDistanceMaster').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "Distance Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "Distance Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "Distance Master List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }

        function checkValidation() {
             var isValid = true;
             if ($("#txtRouteDescription").val() == "") {
                 $("#txtRouteDescription").attr('class', 'form-control vaidationTextBoxError');
                 $("#txtRouteDescription").focus();
                 isValid = false;
             } else {
                 $("#txtRouteDescription").attr('class', 'form-control');
                 $("#txtRouteDescription").focus();
             }

             if ($("#txtDistance").val() == "") {
                 $("#txtDistance").attr('class', 'form-control vaidationTextBoxError');
                 $("#txtDistance").focus();
                 isValid = false;
             } else {
                 $("#txtDistance").attr('class', 'form-control');
                 $("#txtDistance").focus();
             }
             return isValid;
         }

         function checkValidationOnChange() {
             $(function () {
                 $("#txtRouteDescription").on("input", function () {
                     if ($(this).val() == "") {
                         $(this).attr('class', 'form-control vaidationTextBoxError');
                         $(this).focus();
                     } else {
                         $(this).attr('class', 'form-control');
                         $(this).focus();
                     }
                 });

                 $("#txtDistance").on("input", function () {
                     if ($(this).val() == "") {
                         $(this).attr('class', 'form-control vaidationTextBoxError');
                         $(this).focus();
                     } else {
                         $(this).attr('class', 'form-control');
                         $(this).focus();
                     }
                 });
             });
         }

         function clearControls() {
             $("#txtRouteDescription").val("");
             $("#txtDistance").val("");
              $("#chkIsActive").prop("checked", false);
         }

        function searchDistanceMaster() {
            if ($.fn.DataTable.isDataTable("#tblDistanceMaster")) {
                $('#tblDistanceMaster tbody').empty();
                $('#tblDistanceMaster').DataTable().clear().destroy();
            }
            var routeDescription = $("#txtRouteDescription").val();
            var makeName = $("#txtDistance").val();
            var distance = $("#chkIsActive").is(":checked");

            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DistanceMaster/searchDistanceMaster")',
                type: "GET",
                dataType: "json",
                data: { routeDescription : routeDescription, distance: distance, isActive: isActive},
                success: function (data) {
                    if (data != null && data != undefined) {
                        console.log(data);
                        var rows = "";
                        var row = "";
                        $.each(data, function (i, item) {
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewDistanceMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editDistanceMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteDistanceMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.routeDescription + '</td>' +
                                '<td>' + item.distance + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.creationDate + '</td>' +
                                '<td>' + item.createdByName + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updatedByName + '</td>' +
                                '</tr>';
                            rows = rows + row;
                        });
                        $("#divDistanceMaster").show();
                        $("#tblDistanceMaster").focus();
                        $("#distanceMasterBody").html(rows);
                        rows = "";
                        bindDataTable();
                    }
                    else {
                        console.log(data);
                        $.confirm({
                            title: 'Distance Master List',
                            content: 'Distance Master Not Found!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                        var row = '<tr>' +
                            '<td>' +
                            '<div class="d-flex align-items-center">' +
                            '</div>' +
                            '</td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td style="text-align:center">No Data Found!!!</td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '</tr>';
                        $("#distanceMasterBody").html(row);
                    }
                }
            });
            //}
        }

        function getDistanceMasterList() {
            if ($.fn.DataTable.isDataTable("#tblDistanceMaster")) {
                $('#tblDistanceMaster tbody').empty();
                $('#tblDistanceMaster').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DistanceMaster/getDistanceMasterList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        var sno = 0;
                        var rows = "";
                        var row = "";
                        $("#distanceMasterBody").html("");
                        $.each(data, function (i, item) {
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewDistanceMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editDistanceMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteDistanceMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.routeDescription + '</td>' +
                                '<td>' + item.distance + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.creationDate + '</td>' +
                                '<td>' + item.createdByName + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updatedByName + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            row = "";
                            $("#tblDistanceMaster").focus();
                        });
                        $("#distanceMasterBody").append(rows);
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="8" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#distanceMasterBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}