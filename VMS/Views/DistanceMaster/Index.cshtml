    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Add Distance Master</h4>
                    <div>
                        <form id="frmUserRole" name="frmUserRole" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <div class="row rowHeight">
                                <div class="col-md-6">
