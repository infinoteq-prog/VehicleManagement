@model VMS.ViewModel.VMDistanceMaster
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
}
@if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
{ *@
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body" style="min-height:500px;">
                    <h4 class="card-title">Distance Master Details</h4>
                    <div>
                        <form id="frmUserRole" name="frmUserRole" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtRouteDescription">Route Description: </label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.RouteDescription, new { @class = "form-control", id = "txtRouteDescription" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtDistance">Distance: </label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.Distance, new { @class = "form-control", id = "txtDistance" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="chkIsActive">Is Active</label>
                                        <div class="col-sm-8">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-label checkboxStyle", id = "chkIsActive" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        var fullAccess = 'True';
        var viewAccess = 'True';

        $(document).ready(function () {
            setSideMenu("distance-master");
            if (fullAccess === "True" || viewAccess === "True") {
                makeFieldsReadOnly();
                var distanceMasterId = GetParameterValues('distanceMasterId');
                getDistanceMasterId(distanceMasterId);
            }
        });

        function makeFieldsReadOnly() {
            $("#txtRouteDescription").prop("readonly", true);
            $("#txtDistance").prop("readonly", true);
            $("#chkIsActive").attr("disabled", true);
        }

        function getDistanceMasterId(distanceMasterId) {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DistanceMaster/getDistanceMasterById")',
                type: "GET",
                data: { distanceMasterId: distanceMasterId },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $('#txtRouteDescription').val(data.routeDescription);
                        $('#txtDistance').val(data.distance);
                        $("#chkIsActive").prop('checked', data.isActive);
                    } else {
                        $.confirm({
                            title: 'Distance Master',
                            content: 'Distance Master does not Exists!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}