    <script type="text/javascript">
        $(document)
            .ajaxStart(function () {
                $('#AjaxLoader').show();
            })
            .ajaxStop(function () {
                $('#AjaxLoader').hide();
            });

        $(document).ready(function () {

            getUserDetails();
            $(".close").on("click", function () { $(".popup").removeClass("visible"); });
        });

        function getUserDetails() {
            $.ajax({
                type: "GET",
                url: '@(utilityHelper.SiteUrl() + "Login/getUserDetails")',
                dataType: "json",
                async: true,
                success: function (data) {
                    console.log(data);
                    if (data != null) {
                       $("#lblUsername").html("Name: " + data.userName);
                        if(data.transporterName != null && data.transporterName != undefined){
                            $("#lblTransporterName").html("&nbsp; | &nbsp; Transporter:&nbsp;" + data.transporterName);
                        }
                        $("#lblLastLoginTime").html("Last Login: " + data.lastLoginTime);
                    } else { 
                        $.confirm({
                            title: 'Session Logout!',
                            content: "Your session has ended due to inactivity. Please Login to continue!",
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                    action: function () {
                                        window.location.href = '@Url.Action("Index", "Login")';
                                    }
                                },
                            }
                        });
                    }
                },
                error: function () {
                    $("#lblMessage").html("Error while authenticating user credentials!");
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '@(utilityHelper.SiteUrl() + "Login/Logout")',
                dataType: "json",
                async: true,
                success: function (data) {
                    if (data == true) {
                        window.location.href = '@(utilityHelper.SiteUrl() + "Login/Index")';
                    }
                },
                error: function () {
                    $("#lblMessage").html("Error while authenticating user credentials!");
                }
            });
        }

         function checkNullValues(val){
            var newVal = "";
            if(val === null || val === undefined || val === ""){
                newVal = "-";
            }else{
                newVal = val.toString();
            }
            return newVal;
        }

        function setDatetoDDMMYYYY(dt)
        {
            let today = "";

            if(dt != "N/A"){
                today = new Date(dt);

                let dd = today.getDate();
                let mm = today.getMonth() + 1;

                let yyyy = today.getFullYear();

                if (dd < 10) {
                    dd = '0' + dd;
                }
                if (mm < 10) {
                    mm = '0' + mm;
                }
                today = dd + '-' + mm + '-' + yyyy;

                console.log(today);
            }else{
                today = "N/A";
            }
            return today;
        }

        function returnAMPM(time) {
            if (time != "" && time.length > 2) {
                var timeArr = time.split(':');
                if (timeArr.length > 0) {
                    var hour = parseInt(timeArr[0]);
                    if (hour >= 12) {
                        return time + " PM";
                    } else {
                        return time + " AM";
                    }
                }
            }
            return time;
        }

        function GetParameterValues(param) {
            var url = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
            for (var i = 0; i < url.length; i++) {
                var urlparam = url[i].split('=');
                if (urlparam[0] == param) {
                    return urlparam[1];
                }
            }
        }

        function getUserRole() {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "User/getUserRole")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    if (data != null && data != undefined) {
                        var s = '<option value="0">Select a User</option>';
                        for (var i = 0; i < data.length; i++) {
                            console.log(data[i])
                            s += '<option value="' + data[i].roleID + '">' + data[i].roleName + '</option>';
                        }
                        $("#ddlRole").html(s);
                    } else {
                        console.log(data);
                    }
                }
            });
        }

        function setTextboxStyle(cltr) {
            if ($(cltr).val() == "") {
                $(cltr).attr('class', 'form-control vaidationTextBoxError');
            } else {
                $(cltr).attr('class', 'form-control');
            }
        }

        function setDropDownStyle(cltr) {
            if ($(cltr).find(":selected").val() == "0") {
                $(cltr).attr('class', 'form-control vaidationTextBoxError');
            } else {
                $(cltr).attr('class', 'form-control');
            }
        }
    </script>
