        //LR GR NO Popup Validation
        function checkLRGRNoPopUpValidation() {
            var isValid = true;
            if ($("#txtUpdateLRGRNo").val() == "") {
                $("#txtUpdateLRGRNo").attr('class', 'form-control vaidationTextBoxError');
                $("#txtUpdateLRGRNo").focus();
                isValid = false;
            } else {
                $("#txtUpdateLRGRNo").attr('class', 'form-control');
                $("#txtUpdateLRGRNo").focus();
            }

            if($("#hdnLRGRNO").val() == "" || $("#hdnLRGRNoControl").val() == ""){
                isValid = false;
            }
            return isValid;
        }

        //LR GR NO Popup Validation
        function checkExceptionalItemPopUpValidation() {
            var isValid = true;
            if ($('#ddlExceptionalEntries option:selected').val() == "0") {
                $("#ddlExceptionalEntries").attr('class', 'form-control vaidationTextBoxError');
                $("#ddlExceptionalEntries").focus();
                isValid = false;
            } else {
                $("#ddlExceptionalEntries").attr('class', 'form-control');
                $("#ddlExceptionalEntries").focus();
            }

            if($("#hdnExceptionalItem").val() == "" || $("#hdnExceptionalItemControl").val() == ""){
                isValid = false;
            }
            return isValid;
        }
        
        //Function to Set Exceptional Entries and ControlId
        function setExceptionalItem(id,cltr) {
            $("#hdnExceptionalItem").val(id);
            $("#hdnExceptionalItemControl").val(cltr);
            $('#exceptionalEntriesDialog').dialog('open');
        }

        //Function to Set LRGRNO and ControlId
        function setLRGRNO(id,cltr) {
            $("#hdnLRGRNO").val(id);
            $("#hdnLRGRNoControl").val(cltr);
            $('#lrGRNOUpdateDialog').dialog('open');
        }

        //Function to Update Exceptional Items 
        function updateExceptionalEntry() {
           var isValid = checkExceptionalItemPopUpValidation();
            if(isValid == true){
                var id = $("#hdnExceptionalItem").val();
                var exceptionalEntry = $('#ddlExceptionalEntries option:selected').text();
                $.ajax({
                    cache: false,
                    url: '@(utilityHelper.SiteUrl() + "TransporterBill/updateExceptionalEntries")',
                    type: "POST",
                    dataType: "json",
                    data: { id: id, exceptionalEntry: exceptionalEntry },
                    success: function (data) {
                        if (data != null && data != undefined) {
                            if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                console.log(data);
                                $.confirm({
                                    title: 'Update Exceptional Entry!',
                                    content: data.transactionMessage.message,
                                    type: 'green',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-green',
                                            action: function () {
                                                var cltr = $("#hdnExceptionalItemControl").val();
                                                $("#" + cltr).html($('#ddlExceptionalEntries option:selected').text());
                                                $("#ddlExceptionalEntries").prop("selectedIndex", 0).val();
                                                $('#exceptionalEntriesDialog').dialog('close');
                                            }
                                        },
                                    }
                                });
                            } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                $.confirm({
                                    title: 'Disptach Entry Does Not Exists!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                            }
                        } else {
                            console.log(data);
                            $.confirm({
                                title: 'Disptach Entry Not Exists!',
                                content: data.transactionMessage.message,
                                icon: 'fa fa-warning',
                                type: 'red',
                                buttons: {
                                    omg: {
                                        text: 'OK',
                                        btnClass: 'btn-red',
                                    },
                                }
                            });
                        }
                    }
                });
            }
        }
        
        //Function to Update Update LRGRNO
        function updateLRGRNO() {
           var isValid = checkLRGRNoPopUpValidation();
            if(isValid == true){
                    var id = $("#hdnLRGRNO").val();
                    var lrGrNo = $("#txtUpdateLRGRNo").val();
                    $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "TransporterBill/updateLRGRNo")',
                        type: "POST",
                        dataType: "json",
                        data: { id: id, lrGrNo: lrGrNo },
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'Update LR GR NO!',
                                        content: data.transactionMessage.message,
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                   var cltr = $("#hdnLRGRNoControl").val();
                                                   $("#" + cltr).html($("#txtUpdateLRGRNo").val());
                                                   $("#txtUpdateLRGRNo").val("");
                                                   $('#lrGRNOUpdateDialog').dialog('close');
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'LR GR NO Not Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                }
                            } else {
                                console.log(data);
                                $.confirm({
                                        title: 'LR GR NO Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                            }
                        }
                    });
            }
        }

