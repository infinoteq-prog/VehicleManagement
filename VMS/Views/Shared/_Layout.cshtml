        //Function Driver Hisab Approve Functions
        function approvalDriverHisabMaster(settlementNo, approvedStatus) {

            var confirmationMessage = '';
            if (approvedStatus === 'Approved') {
                confirmationMessage = 'Are you sure! You want to Non-approval Driver hisab entry?';
            }
            else { confirmationMessage = 'Are you sure! You want to approve Driver hisab entry?'; }


            // If already approved, revert it back
            $.confirm({
                title: 'Approve Confirmation!',
                content: confirmationMessage,
                icon: 'fa fa-question-circle',
                animation: 'scale',
                closeAnimation: 'scale',
                opacity: 0.5,
                buttons: {
