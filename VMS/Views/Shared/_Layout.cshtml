        function getCodeMaster(codeType) {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "Master/getCodeMaster")',
                type: "GET",
                data: { codeType: codeType },
                dataType: "json",
                success: function (data) {
                    if (data != null && data != undefined) {
                        var s = '';
                        if(codeType == "CATEGORY"){
                            s = '<option value="0">Select a Bill Category</option>';
                        }else if(codeType == "INCOTERM"){
                            s = '<option value="0">Select a Inco Term</option>';
                        }else if(codeType == "DIVISION"){
                            s = '<option value="0">Select a Division</option>';
                        }
                        
                        for (var i = 0; i < data.length; i++) {
                           // console.log(data[i])
                            if(codeType == "CATEGORY"){
                                if(data[i].code == "TR"){
                                    s += '<option selected="selected" value="' + data[i].id + '">' + data[i].code + '</option>';
                                }else{
                                    s += '<option value="' + data[i].id + '">' + data[i].code + '</option>';
                                }
                            }else if(codeType == "INCOTERM"){
                                if(data[i].code == "FF"){
                                    s += '<option selected="selected" value="' + data[i].id + '">' + data[i].code + '</option>';
                                }else{
                                    s += '<option value="' + data[i].id + '">' + data[i].code + '</option>';
                                }
                            }else if(codeType == "DIVISION"){
                              if(data[i].code == "CM"){
                                    s += '<option selected="selected" value="' + data[i].id + '">' + data[i].code + '</option>';
                                }else{
                                    s += '<option value="' + data[i].id + '">' + data[i].code + '</option>';
                                }
                            }
                        }

                        if(codeType == "CATEGORY"){
                            $("#ddlBillCategory").html(s);
                        }else if(codeType == "INCOTERM"){
                           $("#ddlCode").html(s);
                        }else if(codeType == "DIVISION"){
                            $("#ddlDivision").html(s);
                        }
                        
                    } else {
                        var s = '';
                        if(codeType == "CATEGORY"){
                            s = '<option value="0">Select a Bill Category</option>';
                            $("#ddlBillCategory").html(s);
                        }else if(codeType == "INCOTERM"){
                            s = '<option value="0">Select a Inco Term</option>';
                            $("#ddlCode").html(s);
                        }else if(codeType == "DIVISION"){
                            s = '<option value="0">Select a Division</option>';
                            $("#ddlDivision").html(s);
                        }
                        console.log(data);
                    }
                }
            });
        }

