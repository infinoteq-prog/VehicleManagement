        function setDatetoDDMMYYYY(dt)
        {
            let today = "";
            if(dt === "" || dt === "-"){
               today = "-";
            }else{
                if(dt != "N/A"){
                    today = new Date(dt);

                    let dd = today.getDate();
                    let mm = today.getMonth() + 1;

                    let yyyy = today.getFullYear();

                    if (dd < 10) {
                        dd = '0' + dd;
                    }
                    if (mm < 10) {
                        mm = '0' + mm;
                    }
                    today = dd + '-' + mm + '-' + yyyy;

                    console.log(today);
                }else{
                    today = "N/A";
                }
            }
            return today;
        }

