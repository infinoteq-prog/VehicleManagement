        // Function to convert DD-MM-YYYY to YYYY-MM-DD
        function convertDdMmYyyyToYyyyMmDd(dateString) {
            const parts = dateString.split('-'); // ["17", "05", "2025"]
            if (parts.length === 3) {
                return `${parts[2]}-${parts[1]}-${parts[0]}`; // "2025-05-17"
            }
            return null; // Or throw an error
        }
