        function clearControls() {
            $("#ddlState").prop("selectedIndex", 0).val();
            $("#ddlDistrict").prop("selectedIndex", 0).val();
            $("#ddlCity").prop("selectedIndex", 0).val();
            $("#txtCompanyCode").val("");
            $("#txtCompanyName").val("");
            $("#txtAddress1").val("");
            $("#txtAddress2").val("");
            $("#txtAddress3").val("");
            $("#txtPincode").val("");
            $("#txtGstinNo").val("");
            $("#txtPanNo").val("");
            $("#chkIsActive").prop("checked", false);
        }

        function searchCompanyMaster() {
            if ($.fn.DataTable.isDataTable("#tblCompanyMaster")) {
                $('#tblCompanyMaster tr').remove();
                $('#tblCompanyMaster tbody').empty();
                $('#tblCompanyMaster').DataTable().clear().destroy();
            }

            var companyCode = $("#txtCompanyCode").val();
            var companyName = $("#txtCompanyName").val();
            var address1 = $("#txtAddress1").val();
            var address2 = $("#txtAddress2").val();
            var address3 = $("#txtAddress3").val();
            var stateId = 0;
            var districtId = 0;
            var cityId = 0;
            var pinCode = $("#txtPincode").val();
            var gstinNo = $("#txtGstinNo").val();
            var panNo = $("#txtPanNo").val();
            var isActive = $("#chkIsActive").is(":checked");

            if( $('#ddlState option:selected').val() != null && $('#ddlState option:selected').val() != undefined){
                stateId = $('#ddlState option:selected').val();
            }

            if( $('#ddlDistrict option:selected').val() != null &&  $('#ddlDistrict option:selected').val() != undefined){
                districtId = $('#ddlDistrict option:selected').val();
            }

            if( $('#ddlCity option:selected').val() != null &&  $('#ddlCity option:selected').val() != undefined){
                cityId = $('#ddlCity option:selected').val();
            }

            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "CompanyMaster/searchCompanyMaster")',
                type: "GET",
                dataType: "json",
                data: {
                    companyCode: companyCode, companyName: companyName,
                    address1: address1, address2: address2, address3: address3,
                    stateId: stateId, districtId: districtId, cityId: cityId,
                    pinCode: pinCode, gstinNo: gstinNo, panNo: panNo, isActive: isActive
                },
                success: function (data) {
                    if (data != null && data != undefined) {
                        console.log(data);
                        var rows = "";
                        var row = "";
                        $.each(data, function (i, item) {
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewCompanyMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editCompanyMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteCompanyMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                    viewButton +
                                    updateButton +
                                    deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.billToCode + '</td>' +
                                '<td>' + item.billToCompanyName + '</td>' +
                                '<td>' + item.address1 + '</td>' +
                                '<td>' + item.address2 + '</td>' +
                                '<td>' + item.address3 + '</td>' +
                                '<td>' + item.stateName + '</td>' +
                                '<td>' + item.districtName + '</td>' +
                                '<td>' + item.cityName + '</td>' +
                                '<td>' + item.pinCode + '</td>' +
                                '<td>' + item.gstinNo + '</td>' +
                                '<td>' + item.panNo + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.createDate + '</td>' +
                                '<td>' + item.createdBy + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updateBy + '</td>' +
                                '</tr>';
                            rows = rows + row;
                        });
                        $("#divCompanyMaster").show();
                        $("#tblCompanyMaster").focus();
                        bindDataTable();
                        $("#companyMasterBody").html(rows);
                        rows = "";
                    }
                    else {
                        console.log(data);
                        $.confirm({
                            title: 'Company Master List',
                            content: 'Company Master Not Found!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                        // var row = '<tr>' +
                        //     '<td colspan="17" style="text-align:center">No Data Found!!!</td>' +
                        //     '</tr>';

                        var row = '<tr>' +
                            '<td>' +
                            '<div class="d-flex align-items-center">' +
                            '</div>' +
                            '</td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td style="text-align:center">No Data Found!!!</td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '</tr>';
                        $("#companyMasterBody").html(row);
                    }
                }
            });
            //}
        }

        function getCompanyMasterList() {
            if ($.fn.DataTable.isDataTable("#tblCompanyMaster")) {
                $('#tblCompanyMaster tbody').empty();
                $('#tblCompanyMaster').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "CompanyMaster/getCompanyMasterList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $.each(data, function (i, item) {
                            var sno = 0;
                            var rows = "";
                            var row = "";
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewCompanyMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editCompanyMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteCompanyMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.billToCode + '</td>' +
                                '<td>' + item.billToCompanyName + '</td>' +
                                '<td>' + item.address1 + '</td>' +
                                '<td>' + item.address2 + '</td>' +
                                '<td>' + item.address3 + '</td>' +
                                '<td>' + item.stateName + '</td>' +
                                '<td>' + item.districtName + '</td>' +
                                '<td>' + item.cityName + '</td>' +
                                '<td>' + item.pinCode + '</td>' +
                                '<td>' + item.gstinNo + '</td>' +
                                '<td>' + item.panNo + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.createDate + '</td>' +
                                '<td>' + item.createdBy + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updateBy + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            $("#companyMasterBody").append(rows);
                            rows = "";
                            $("#tblCompanyMaster").focus();
                        });
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="17" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#companyMasterBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}