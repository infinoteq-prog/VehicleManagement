                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        var fullAccess = 'True';
        var viewAccess = 'True';

        $(document).ready(function () {
            setSideMenu("company-master");
            if (fullAccess === "True" || viewAccess === "True") {
                makeFieldsReadOnly();
                var companyMasterId = GetParameterValues('companyMasterId');
                getCompanyMasterDetailsWithId(companyMasterId);
            }
        });

        function makeFieldsReadOnly() {
            $("#txtStateName").prop("readonly", true);
            $("#txtDistrictName").prop("readonly", true);
            $("#txtCityName").prop("readonly", true);
            $("#txtCompanyCode").prop("readonly", true);
            $("#txtCompanyName").prop("readonly", true);
            $("#txtAddress1").prop("readonly", true);
            $("#txtAddress2").prop("readonly", true);
            $("#txtAddress3").prop("readonly", true);
            $("#txtPincode").prop("readonly", true);
            $("#txtGstinNo").prop("readonly", true);
            $("#txtPanNo").prop("readonly", true);
            $("#chkIsActive").prop('checked', false);
            $("#chkIsActive").attr("disabled", true);
        }

        function getCompanyMasterDetailsWithId(companyMasterId) {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "CompanyMaster/getCompanyMasterById")',
                type: "GET",
                data: { companyMasterId: companyMasterId },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $("#txtStateName").val(data.stateName);
                        $("#txtDistrictName").val(data.districtName);
                        $("#txtCityName").val(data.cityName);
                        $("#txtCompanyCode").val(data.billToCode);
                        $("#txtCompanyName").val(data.billToCompanyName);
                        $("#txtAddress1").val(data.address1);
                        $("#txtAddress2").val(data.address2);
                        $("#txtAddress3").val(data.address3);
                        $("#txtPincode").val(data.pinCode);
                        $("#txtGstinNo").val(data.gstinNo);
                        $("#txtPanNo").val(data.panNo);
                        $("#chkIsActive").prop('checked', data.isActive);
                    } else {
                        $.confirm({
                            title: 'Transporter Master',
                            content: 'Transporter Master does not Exists!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}