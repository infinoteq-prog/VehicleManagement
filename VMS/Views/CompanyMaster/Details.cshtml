                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtGstinNo"> GSTIN No:</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.GSTINNo, new { @class = "form-control", id = "txtGstinNo" })
