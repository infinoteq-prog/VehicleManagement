                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.BillToCompanyName, new { @class = "form-control", id = "txtCompanyName" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtAddress1"> Address Line 1:</label>
                                        <div class="col-sm-8">
                                            @Html.TextAreaFor(m => m.Address1, new { @class = "form-control", cols = "10", rows = "5", id = "txtAddress1" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtAddress2"> Address Line 2:</label>
                                        <div class="col-sm-8">
                                            @Html.TextAreaFor(m => m.Address2, new { @class = "form-control", cols = "10", rows = "5", id = "txtAddress2" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtAddress3"> Address Line 3:</label>
                                        <div class="col-sm-8">
                                            @Html.TextAreaFor(m => m.Address3, new { @class = "form-control", cols = "10", rows = "5", id = "txtAddress3" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlState">State:</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.StateId, new { @class = "form-control", id = "txtStateName" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlDistrict">District:</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.DistrictId, new { @class = "form-control", id = "txtDistrictName" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlCity">City:</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.CityId, new { @class = "form-control", id = "txtCityName" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtPincode"> Pincode:</label>
                                        <div class="col-sm-8">
