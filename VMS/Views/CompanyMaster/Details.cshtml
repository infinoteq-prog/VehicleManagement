    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
}
@if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
{ *@
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Company Master Details</h4>
                    <div>
                        <form id="frmCompanyMaster" name="frmCompanyMaster" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <input id="hdnCompanyId" name="hdnCompanyId" type="hidden">
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtCompanyCode"> Company Code:</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.BillToCode, new { @class = "form-control", id = "txtCompanyCode" })
