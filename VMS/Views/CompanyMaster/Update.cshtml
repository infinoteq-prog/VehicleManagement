        function clearControls() {
            $("#ddlState").prop("selectedIndex", 0).val();
            $("#ddlDistrict").prop("selectedIndex", 0).val();
            $("#ddlCity").prop("selectedIndex", 0).val();
            $("#txtCompanyCode").val("");
            $("#txtCompanyName").val("");
            $("#txtAddress1").val("");
            $("#txtAddress2").val("");
            $("#txtAddress3").val("");
            $("#txtPincode").val("");
            $("#txtGstinNo").val("");
            $("#txtPanNo").val("");
            $("#chkIsActive").prop("checked", false);
        }

        function getCompanyMasterList() {
            if ($.fn.DataTable.isDataTable("#tblCompanyMaster")) {
                $('#tblCompanyMaster tbody').empty();
                $('#tblCompanyMaster').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "CompanyMaster/getCompanyMasterList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $.each(data, function (i, item) {
                            var sno = 0;
                            var rows = "";
                            var row = "";
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewCompanyMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editCompanyMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteCompanyMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.billToCode + '</td>' +
                                '<td>' + item.billToCompanyName + '</td>' +
                                '<td>' + item.address1 + '</td>' +
                                '<td>' + item.address2 + '</td>' +
                                '<td>' + item.address3 + '</td>' +
                                '<td>' + item.stateName + '</td>' +
                                '<td>' + item.districtName + '</td>' +
                                '<td>' + item.cityName + '</td>' +
                                '<td>' + item.pinCode + '</td>' +
                                '<td>' + item.gstinNo + '</td>' +
                                '<td>' + item.panNo + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.createDate + '</td>' +
                                '<td>' + item.createdBy + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updateBy + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            $("#companyMasterBody").append(rows);
                            rows = "";
                            $("#tblCompanyMaster").focus();
                        });
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="17" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#companyMasterBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }

        function updateCompanyMaster() {
            var isValid = checkValidation();
            if (isValid == true) {
                if ($('#ddlState option:selected').val() != "0"
                    && $('#ddlDistrict option:selected').val() != "0"
                    && $('#ddlCity option:selected').val() != "0"
                    && $("#txtCompanyCode").val() != ""
                    && $("#txtCompanyName").val() != ""
                    && $("#txtAddress1").val() != ""
                    && $("#txtGstinNo").val() != ""
                    && $("#txtPanNo").val() != "") {
                    var id = $('#hdnCompanyMasterID').val();
                    var companyCode = $("#txtCompanyCode").val();
                    var companyName = $("#txtCompanyName").val();
                    var address1 = $("#txtAddress1").val();
                    var address2 = $("#txtAddress2").val();
                    var address3 = $("#txtAddress3").val();
                    var stateId = $('#ddlState option:selected').val();
                    var districtId = $('#ddlDistrict option:selected').val();
                    var cityId = $('#ddlCity option:selected').val();
                    var pinCode = $("#txtPincode").val();
                    var gstinNo = $("#txtGstinNo").val();
                    var panNo = $("#txtPanNo").val();
                    var isActive = $("#chkIsActive").is(":checked");

                    $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "CompanyMaster/Update")',
                        type: "POST",
                        dataType: "json",
                        data: {
                            id: id, companyCode: companyCode, companyName: companyName,
                            address1: address1, address2: address2, address3: address3,
                            stateId: stateId, districtId: districtId, cityId: cityId,
                            pinCode: pinCode, gstinNo: gstinNo, panNo: panNo, isActive: isActive
                            },
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'Update Company Master!',
                                        content: "Company Master has been updated successfully!",
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    clearControls();
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "CompanyMaster/Update?companyMasterId=")' + $("#hdnCompanyMasterID").val();
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'Company Master Already Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                    $("#divCompanyMaster").hide();
                                }
                            } else {
                                console.log(data);
                                //clearControls();
                                $.confirm({
                                    title: 'Error Occoured!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divCompanyMaster").hide();
                            }
                        }
                    });
                }
            }
        }

        function getCompanyMasterById(companyMasterId) {
            if ($.fn.DataTable.isDataTable("#tblCompanyMaster")) {
                $('#tblCompanyMaster tbody').empty();
                $('#tblCompanyMaster').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "CompanyMaster/getCompanyMasterById")',
                type: "GET",
                data: { companyMasterId: companyMasterId },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        var sno = 0;
                        var rows = "";
                        var row = "";
                        sno = sno + 1;
                        if (fullAccess === "True" || viewAccess === "True") {
                            viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewCompanyMaster(\'' + data.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || updateAccess === "True") {
                            updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editCompanyMaster(\'' + data.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || deleteAccess === "True") {
                            deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteCompanyMaster(\'' + data.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                        }
                        row = '<tr>' +
                            '<td>' +
                            '<div class="d-flex align-items-center">' +
                            viewButton +
                            updateButton +
                            deleteButton +
                            '</div>' +
                            '</td>' +
                            '<td>' + data.billToCode + '</td>' +
                            '<td>' + data.billToCompanyName + '</td>' +
                            '<td>' + data.address1 + '</td>' +
                            '<td>' + data.address2 + '</td>' +
                            '<td>' + data.address3 + '</td>' +
                            '<td>' + data.stateName + '</td>' +
                            '<td>' + data.districtName + '</td>' +
                            '<td>' + data.cityName + '</td>' +
                            '<td>' + data.pinCode + '</td>' +
                            '<td>' + data.gstinNo + '</td>' +
                            '<td>' + data.panNo + '</td>' +
                            '<td>' + data.isActive + '</td>' +
                            '<td>' + data.createDate + '</td>' +
                            '<td>' + data.createdBy + '</td>' +
                            '<td>' + data.updateDate + '</td>' +
                            '<td>' + data.updateBy + '</td>' +
                            '</tr>';

                        //Setting Company Master Details to Page Controls
                        $('#hdnCompanyMasterID').val(data.id);

                        getStateByCountryIdWithSelect(1, data.stateId);

                        // $('#ddlState option').map(function () {
                        //     if ($(this).val() == data.stateId) return this;
                        // }).attr('selected', 'selected');

                        getDistrictByStateIdWithSelect(data.stateId, data.districtId);

                        // $('#ddlDistrict option').map(function () {
                        //     if ($(this).val() == data.districtId) return this;
                        // }).attr('selected', 'selected');

                        getCityByDisctrictIdWithSelect(data.districtId, data.cityId);

                        // $('#ddlCity option').map(function () {
                        //     if ($(this).val() == data.cityId) return this;
                        // }).attr('selected', 'selected');

                        //getDistrict(data.districtId);
                        //getCity(data.cityId);

                        $("#txtCompanyCode").val(data.billToCode);
                        $("#txtCompanyName").val(data.billToCompanyName);
                        $("#txtAddress1").val(data.address1);
                        $("#txtAddress2").val(data.address2);
                        $("#txtAddress3").val(data.address3);
                        $("#txtPincode").val(data.pinCode);
                        $("#txtGstinNo").val(data.gstinNo);
                        $("#txtPanNo").val(data.panNo);
                        $("#chkIsActive").prop('checked', data.isActive);

                        rows = rows + row;
                        $("#companyMasterBody").html(rows);
                        rows = "";
                        $("#tblCompanyMaster").focus();

                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="17" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#companyMasterBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}