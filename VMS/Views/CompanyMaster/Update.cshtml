@model VMS.ViewModel.VMCompanyMaster
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
} *@

@* @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleUpdateAccess == true)
{ *@
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Update Company Master</h4>
                    <div id="divUpdateUserRole">
                        <form id="frmCompanyMaster" name="frmCompanyMaster" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <input id="hdnCompanyMasterID" name="hdnCompanyMasterID" type="hidden">
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <label id="lblMandatoryMessage" class="reqFields">@SiteConstants.ReqFieldMessage</label>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtCompanyCode"> Company Code: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.BillToCode, new { @class = "form-control alphanumericonly", id = "txtCompanyCode", @maxlength = "100" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtCompanyName"> Company Name: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.BillToCompanyName, new { @class = "form-control alphanumericonlywithspace", id = "txtCompanyName", @maxlength = "100" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtAddress1"> Address Line 1: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.Address1, new { @class = "form-control", id = "txtAddress1", @maxlength = "500" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtAddress2"> Address Line 2:</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.Address2, new { @class = "form-control", id = "txtAddress2", @maxlength = "500" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtAddress3"> Address Line 3:</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.Address3, new { @class = "form-control", id = "txtAddress3", @maxlength = "500" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlState">State:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlState" name="ddlState" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlDistrict">District:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlDistrict" name="ddlDistrict" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlCity">City:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlCity" name="ddlCity" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtPincode"> Pincode:</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.PinCode, new { @class = "form-control numberonly", id = "txtPincode", @maxlength = "10" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtGstinNo"> GSTIN No:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.GSTINNo, new { @class = "form-control gstNo alphanumericonly", id = "txtGstinNo", @maxlength = "15" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtPanNo"> Pan No:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.PanNo, new { @class = "form-control panNo alphanumericonly", id = "txtPanNo", @maxlength = "10" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="chkIsActive">Is Active:</label>
                                        <div class="col-sm-8">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-label checkboxStyle", id = "chkIsActive" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-12"></div>
                            </div>
                            @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleUpdateAccess == true)
                            { *@
                            <div class="row rowHeight" style="text-align:center;">
                                <div class="col-md-12">
                                    <button type="button" class="btn btn-primary mr-2" onclick="updateCompanyMaster();">Update</button>
                                    <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button>
                                </div>
                            </div>
                            @*  } *@
                        </form>
                    </div>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                    @* @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
                    { *@
                    <div id="divCompanyMaster">
                        <div class="table-responsive pt-3">
                            <table id="tblCompanyMaster" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th>Actions</th>
                                        <th>Company Code</th>
                                        <th>Company Name</th>
                                        <th>Address 1</th>
                                        <th>Address 2</th>
                                        <th>Address 3</th>
                                        <th>State</th>
                                        <th>District</th>
                                        <th>City</th>
                                        <th>Pin Code</th>
                                        <th>GSTIN No</th>
                                        <th>Pan No</th>
                                        <th>Is Active</th>
                                        <th>Creation Date</th>
                                        <th>Created By</th>
                                        <th>Update Date</th>
                                        <th>Updatd By</th>
                                    </tr>
                                </thead>
                                <tbody id="companyMasterBody">
                                </tbody>
                            </table>
                        </div>
                        @* } *@
                    </div>
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";
        $(document).ready(function () {
            setSideMenu("company-master");
            if (fullAccess === "True" || viewAccess === "True") {
                clearControls();
                checkValidationOnChange();
                getUserList();
                getStateList();

                $("#ddlState").on("change", function () {
                    getDistrictByStateId($(this).val());
                });

                $("#ddlDistrict").on("change", function () {
                    getCityByDisctrictId($(this).val());
                });
                //getCompanyMasterList();
                var companyMasterId = GetParameterValues('companyMasterId');
                getCompanyMasterById(companyMasterId);
            }
        });

        function bindDataTable() {
            $('#tblCompanyMaster').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "Company Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "Company Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "Company Master List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }

        function checkValidation() {
            var isValid = true;

            if ($('#ddlState option:selected').val() == "0") {
                $("#ddlState").attr('class', 'form-control vaidationTextBoxError');
                $("#ddlState").focus();
                isValid = false;
            } else {
                $("#ddlState").attr('class', 'form-control');
                $("#ddlState").focus();
            }

            if ($('#ddlDistrict option:selected').val() == "0") {
                $("#ddlDistrict").attr('class', 'form-control vaidationTextBoxError');
                $("#ddlDistrict").focus();
                isValid = false;
            } else {
                $("#ddlDistrict").attr('class', 'form-control');
                $("#ddlDistrict").focus();
            }

            if ($('#ddlCity option:selected').val() == "0") {
                $("#ddlCity").attr('class', 'form-control vaidationTextBoxError');
                $("#ddlCity").focus();
                isValid = false;
            } else {
                $("#ddlCity").attr('class', 'form-control');
                $("#ddlCity").focus();
            }

            if ($("#txtCompanyCode").val() == "") {
                $("#txtCompanyCode").attr('class', 'form-control vaidationTextBoxError');
                $("#txtCompanyCode").focus();
                isValid = false;
            } else {
                $("#txtCompanyCode").attr('class', 'form-control');
                $("#txtCompanyCode").focus();
            }

            if ($("#txtCompanyName").val() == "") {
                $("#txtCompanyName").attr('class', 'form-control vaidationTextBoxError');
                $("#txtCompanyName").focus();
                isValid = false;
            } else {
                $("#txtCompanyName").attr('class', 'form-control');
                $("#txtCompanyName").focus();
            }

            if ($("#txtAddress1").val() == "") {
                $("#txtAddress1").attr('class', 'form-control vaidationTextBoxError');
                $("#txtAddress1").focus();
                isValid = false;
            } else {
                $("#txtAddress1").attr('class', 'form-control');
                $("#txtAddress1").focus();
            }

            if ($("#txtGstinNo").val() == "") {
                $("#txtGstinNo").attr('class', 'form-control vaidationTextBoxError');
                $("#txtGstinNo").focus();
                isValid = false;
            } else {
                $("#txtGstinNo").attr('class', 'form-control');
                $("#txtGstinNo").focus();
            }

            if ($("#txtPanNo").val() == "") {
                $("#txtPanNo").attr('class', 'form-control vaidationTextBoxError');
                $("#txtPanNo").focus();
                isValid = false;
            } else {
                $("#txtPanNo").attr('class', 'form-control');
                $("#txtPanNo").focus();
            }

            if ($(".gstNo").val() != ""){
                var inputtext = $("#txtGstinNo").val();
                var gstinformat = new RegExp('^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9]{1}Z[a-zA-Z0-9]{1}$');

                if (gstinformat.test(inputtext)) {
                    $("#txtGstinNo").attr('class', 'form-control');
                    $("#txtGstinNo").focus();
                }
                else {
                    $("#txtGstinNo").attr('class', 'form-control vaidationTextBoxError');
                    $("#txtGstinNo").focus();
                    isValid = false;
                }
            }

            if ($(".panNo").val() != ""){
                var regex = /([A-Z]){5}([0-9]){4}([A-Z]){1}$/;
                if (regex.test($("#txtPanNo").val().toUpperCase())) {
                    $("#txtPanNo").attr('class', 'form-control');
                    $("#txtPanNo").focus();
                } else {
                    $("#txtGstinNo").attr('class', 'form-control vaidationTextBoxError');
                    $("#txtPanNo").focus();
                    isValid = false;
                }
            }
            return isValid;
        }

