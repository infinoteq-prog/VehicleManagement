@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";
        $(document).ready(function () {
            setSideMenu("driver-master");
            $('#ddlDriver').select2();
            getStateByCountryId(1); 
            getDriverMaster();
            $("#ddlExistingReference").val("true");

            // ✅ Because it is Yes, enable Reference Name
            enableReferenceDriverDropDown("true");
            if (fullAccess === "True" || viewAccess === "True") {
                clearControls();
                checkValidationOnChange();
                //getDriverMasterList();
                var driverMasterID = GetParameterValues('driverMasterID');
                getDriverMasterByID(driverMasterID);

                $(function () {
                      $("#txtDrivingLicenceValidity").datepicker({
                         dateFormat: 'dd-mm-yy'
                     });
                });

                $("#ddlState").on("change", function () {
                    getDistrictByStateId($(this).val());
                });

                $("#ddlDistrict").on("change", function () {
                    getCityByDisctrictId($(this).val());
                });
                  $("#ddlExistingReference").on("change", function () {
                var selectedValue = $(this).val();
                enableReferenceDriverDropDown(selectedValue);
            });
            }
            

            $("#ddlDriver").on("change", function () {
                var selectedValue = $(this).val();
                if (selectedValue === "0") {
                    return;
                }
                getDriverInfo(selectedValue)
            });
        });

        
        function getDriverInfo(driverId) {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DriverMaster/getDriverMasterByID")',
                type: "GET",
                data: { driverMasterID: driverId },
                dataType: "json",
                success: function (data) {
                    if (data != null && data != undefined) {

                        $("#txtReferenceAddress1").val(data.driverAddress1);
                        $("#txtReferenceAddress2").val(data.driverAddress2);
                        $("#txtReferenceAddress3").val(data.driverAddress3);
                        $("#txtReferenceCity").val(data.cityName);
                        $("#txtReferencePinCode").val(data.pinCode);
                        $("#txtReferenceMobile").val(data.mobileNumber1);
                    } else {
                        console.log(data);
                    }
                }
            });
        }

        function enableReferenceDriverDropDown(selectedValue) {
            // Select the ddlDriver dropdown
            var ddlDriver = $("#ddlDriver");

            // Check if the selected value is 'True' (which corresponds to 'Yes')
            if (selectedValue === "true" || selectedValue === "True") {
                ddlDriver.prop("disabled", false); // Enable the dropdown
            } else {
                ddlDriver.prop("disabled", true); // Disable the dropdown
                // Optionally, you might want to reset its value when disabled

                $("#ddlDriver").val(null).trigger('change');
                $("#txtReferenceAddress1").val("");
                $("#txtReferenceAddress2").val("");
                $("#txtReferenceAddress3").val("");
                $("#txtReferenceCity").val("");
                $("#txtReferencePinCode").val("");
                $("#txtReferenceMobile").val("");
            }
        }

        function bindDataTable() {
            $('#tblDriverMaster').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "Driver Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "Driver Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "Driver Master List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
