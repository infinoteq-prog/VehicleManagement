@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        var fullAccess = 'True';
        var viewAccess = 'True';

         $(function() {
             $("img.imgthumb").click(function(e) {
                 var newImg = '<img src='
                                + $(this).attr("src") + '></img>';
                 $('#ladiv')
                    .html($(newImg)
                    .animate({ height: '300', width: '450' }, 1500));
             });
         });

        $(document).ready(function () {
            setSideMenu("driver-master");
            if (fullAccess === "True" || viewAccess === "True") {
                makeFieldsReadOnly();
                var driverMasterID = GetParameterValues('driverMasterID');
                getdriverMasterID(driverMasterID);
            }
        });

        function makeFieldsReadOnly() {
            $("#txtState").prop("readonly", true);
            $("#txtCity").prop("readonly", true);
            $("#txtDriverName").prop("readonly", true);
            $("#txtDriverAddress1").prop("readonly", true);
            $("#txtDriverAddress2").prop("readonly", true);
            $("#txtDriverAddress3").prop("readonly", true);
            $("#txtPinCode").prop("readonly", true);
            $("#txtAadharNumber").prop("readonly", true);
            $("#txtPanNo").prop("readonly", true);
            $("#txtDrivingLicenceNo").prop("readonly", true);
            $("#txtDrivingLicenceIssueAuth").prop("readonly", true);
            $("#txtDrivingLicenceValidity").prop("readonly", true);
            $("#txtMobileNumber1").prop("readonly", true);
            $("#txtMobileNumber2").prop("readonly", true);
            $("#chkIsActive").attr("disabled", true);
            $("#txtFatherName").prop("readonly", true);
            $("#txtDistrictName").prop("readonly", true);

            $("#txtBankName").prop("readonly", true);
            $("#txtBankAccountNumber").prop("readonly", true);
            $("#txtBankIFSCCode").prop("readonly", true);
            $("#txtExistingReference").prop("readonly", true);
            $("#txtReferenceName").prop("readonly", true);
            $("#txtReferenceAddress1").prop("readonly", true);
            $("#txtReferenceAddress2").prop("readonly", true);
            $("#txtReferenceAddress3").prop("readonly", true);
            $("#txtReferenceCity").prop("readonly", true);
            $("#txtReferencePinCode").prop("readonly", true);
            $("#txtReferenceMobile").prop("readonly", true);
        }

        function getdriverMasterID(driverMasterID) {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DriverMaster/getDriverMasterByID")',
                type: "GET",
                data: { driverMasterID: driverMasterID },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $("#txtState").val(data.stateName);
                        $("#txtCity").val(data.cityName);
                        $("#txtDriverName").val(data.driverName);
                        $("#txtDriverAddress1").val(data.driverAddress1);
                        $("#txtDriverAddress2").val(data.driverAddress2);
                        $("#txtDriverAddress3").val(data.driverAddress3);
                        $("#txtPinCode").val(data.pinCode);
                        $("#txtAadharNumber").val(data.aadharNo);
                        $("#txtPanNo").val(data.panNo);
                        $("#txtDrivingLicenceNo").val(data.drivingLicenceNo);
                        $("#txtDrivingLicenceIssueAuth").val(data.drivingLicenceIssueAuth);
                        $("#txtDrivingLicenceValidity").val(data.drivingLicenceValidity);
                        $("#txtMobileNumber1").val(data.mobileNumber1);
                        $("#txtMobileNumber2").val(data.mobileNumber2);
                        $("#chkIsActive").prop('checked', data.isActive);
                        $("#txtFatherName").val(data.fatherName);
                        $("#txtDistrictName").val(data.districtName);

                        $("#txtBankName").val(data.bankName);
                        $("#txtBankAccountNumber").val(data.bankAccountNumber);
                        $("#txtBankIFSCCode").val(data.bankIFSCCode);
                        $("#txtExistingReference").val(data.isExistingReference);
                        $("#txtReferenceName").val(data.referenceName);
                        $("#txtReferenceAddress1").val(data.referenceAddress1);
                        $("#txtReferenceAddress2").val(data.referenceAddress2);
                        $("#txtReferenceAddress3").val(data.referenceAddress3);
                        $("#txtReferenceCity").val(data.referenceCity);
                        $("#txtReferencePinCode").val(data.referencePinCode);
                        $("#txtReferenceMobile").val(data.referenceMobile);
                         
                        $("#imgDriverPhoto").attr('src', '@(utilityHelper.SiteUrl())' + data.driverPhoto);
                        $("#imgDriverPhoto").attr('data-src', '@(utilityHelper.SiteUrl())' + data.driverPhoto);
                        $("#aDriverPhotoLink").attr('href', '@(utilityHelper.SiteUrl())' + data.driverPhoto);

                        $("#imgAadharPhoto").attr('src', '@(utilityHelper.SiteUrl())' + data.aadharNoImage);
                        $("#imgAadharPhoto").attr('data-src', '@(utilityHelper.SiteUrl())' + data.aadharNoImage);
                        $("#aAadharLink").attr('href', '@(utilityHelper.SiteUrl())' + data.aadharNoImage);

                        $("#imgPanNoPhoto").attr('src', '@(utilityHelper.SiteUrl())' + data.panNoImage);
                        $("#imgPanNoPhoto").attr('data-src', '@(utilityHelper.SiteUrl())' + data.panNoImage);
                        $("#aPanNoLink").attr('href', '@(utilityHelper.SiteUrl())' + data.panNoImage);
                        
                        $("#imgDLPhoto").attr('src', '@(utilityHelper.SiteUrl())' + data.drivingLicenceImage);
                        $("#imgDLPhoto").attr('data-src', '@(utilityHelper.SiteUrl())' + data.drivingLicenceImage);
                        $("#aDLLink").attr('href', '@(utilityHelper.SiteUrl())' + data.drivingLicenceImage);

                        
                    } else {
                        $.confirm({
                            title: 'Driver Master',
                            content: 'Driver Master does not Exists!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}