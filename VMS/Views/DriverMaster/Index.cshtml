@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";

        $(document).ready(function () {
            setSideMenu("driver-master");
            //Fill Driver Master DropdownList
            $("#chkIsActive").attr("checked", true);
            $("#chkIsActive").attr("disabled", true);

            $('#ddlDriver').select2();
            getStateByCountryId(1);
            getDriverMaster();
            // Set Existing Reference = Yes by default
            $("#ddlExistingReference").val("true");
            // Enable Reference Name dropdown
            enableReferenceDriverDropDown("true");
            //enableReferenceDriverDropDown("False");
            getFunctionName('DRIVER MASTER', function (userRights) {
                if (userRights) {
                    console.log("Update Access:", userRights.updateAccess);
                    console.log("Add Access:", userRights.addAccess);
                    console.log("Delete Access:", userRights.deleteAccess);
                    console.log("View Access:", userRights.viewAccess);
                    console.log("Full Access:", userRights.fullAccess);

                    fullAccess = userRights.fullAccess;
                    addAccess = userRights.addAccess;
                    viewAccess = userRights.viewAccess;
                    updateAccess = userRights.updateAccess;
                    deleteAccess = userRights.deleteAccess;
                    if (addAccess === "False") {
                        const buttons = document.querySelectorAll('button[type="button"], input[type="button"]');
                        buttons.forEach(button => {
                            // Prevent removing the trigger button itself, if it also has type="button"
                            if (button.id !== 'removeAllTypeButtonsBtn') {
                                button.remove();
                            }
                        });
                    }
                } else {
                    console.log("Failed to get user rights.");
                }
            });
            if (fullAccess === "True" || addAccess === "True") {
                checkValidationOnChange();
            }
            if (fullAccess === "True" || viewAccess === "True") {
                getDriverMasterList();
            }

            $(function () {
                $("#txtDrivingLicenceValidity").datepicker({
                    dateFormat: 'dd-mm-yy',
                    changeYear: true,
                    changeMonth: true,
                });
            });

            $("#ddlState").on("change", function () {
                getDistrictByStateId($(this).val());
            });

            $("#ddlDistrict").on("change", function () {
                getCityByDisctrictId($(this).val());
            });

            // $("#ddlExistingReference").on("change", function () {
            //     var selectedValue = $(this).val();
            //     enableReferenceDriverDropDown(selectedValue);
            // });
            $("#ddlExistingReference").on("change", function () {
                enableReferenceDriverDropDown($(this).val());
            });


            $("#ddlDriver").on("change", function () {
                var selectedValue = $(this).val();
                if (selectedValue === "0") {
                    return;
                }
                getDriverInfo(selectedValue)
            });
        });

        function getDriverInfo(driverId) {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DriverMaster/getDriverMasterByID")',
                type: "GET",
                data: { driverMasterID: driverId },
                dataType: "json",
                success: function (data) {
                    if (data != null && data != undefined) {

                        $("#txtReferenceAddress1").val(data.driverAddress1);
                        $("#txtReferenceAddress2").val(data.driverAddress2);
                        $("#txtReferenceAddress3").val(data.driverAddress3);
                        $("#txtReferenceCity").val(data.cityName);
                        $("#txtReferencePinCode").val(data.pinCode);
                        $("#txtReferenceMobile").val(data.mobileNumber1);
                    } else {
                        console.log(data);
                    }
                }
            });
        }

        function enableReferenceDriverDropDown(selectedValue) {
            // Select the ddlDriver dropdown
            var ddlDriver = $("#ddlDriver");

            // Check if the selected value is 'True' (which corresponds to 'Yes')
            if (selectedValue === "true") {
                ddlDriver.prop("disabled", false); // Enable the dropdown
            } else {
                ddlDriver.prop("disabled", true); // Disable the dropdown
                // Optionally, you might want to reset its value when disabled

                $("#ddlDriver").val(null).trigger('change');
                $("#txtReferenceAddress1").val("");
                $("#txtReferenceAddress2").val("");
                $("#txtReferenceAddress3").val("");
                $("#txtReferenceCity").val("");
                $("#txtReferencePinCode").val("");
                $("#txtReferenceMobile").val("");
            }
        }
        function setDropDownStyle(cltr){
            if ($(cltr).find(":selected").val() == "0") {
                $(cltr).attr('class', 'form-control vaidationTextBoxError');
            } else {
                $(cltr).attr('class', 'form-control');
            }
        }

        function setTextboxStyle(cltr) {
            if ($(cltr).val() == "") {
                $(cltr).attr('class', 'form-control vaidationTextBoxError');
            } else {
