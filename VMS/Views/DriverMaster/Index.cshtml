        function getDriverMasterList() {
            if ($.fn.DataTable.isDataTable("#tblDriverMaster")) {
                $('#tblDriverMaster tbody').empty();
                $('#tblDriverMaster').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "DriverMaster/getDriverMasterList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $.each(data, function (i, item) {
                            var sno = 0;
                            var rows = "";
                            var row = "";
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewDriverMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editDriverMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton =  '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteDriverMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.driverName + '</td>' +
                                '<td>' + item.fatherName + '</td>' +
                                '<td>' + item.oldFirm + '</td>' +
                              
                                '<td>' + item.driverAddress1 + '</td>' +
                                '<td>' + item.driverAddress2 + '</td>' +
                                '<td>' + item.driverAddress3 + '</td>' +
                                '<td style="text-align:center"><a href="' + initialURL + item.driverPhoto + '" target="_blank"><img src="../images/viewImage.png" style="height:100x; width:120x"/></a></td>' +
                                '<td>' + item.stateName + '</td>' +
                                '<td>' + item.districtName + '</td>' +
                                '<td>' + item.cityName + '</td>' +
                                '<td>' + item.pinCode + '</td>' +
                                '<td>' + item.aadharNo + '</td>' +
                                '<td style="text-align:center"><a href="' + initialURL + item.aadharNoImage + '" target="_blank"><img src="../images/viewImage.png" style="height:100x; width:120x"/></a></td>' +
                                '<td>' + item.panNo + '</td>' +
                                '<td style="text-align:center"><a href="' + initialURL + item.panNoImage + '" target="_blank"><img src="../images/viewImage.png" style="height:100x; width:120x"/></a></td>' +
                                '<td>' + item.bankName + '</td>' +
                                '<td>' + item.bankAccountNumber + '</td>' +
                                '<td>' + item.bankIFSCCode + '</td>' +
                                '<td>' + item.drivingLicenceNo + '</td>' +
                                '<td>' + item.drivingLicenceIssueAuth + '</td>' +
                                '<td>' + item.drivingLicenceValidity + '</td>' +
                                '<td style="text-align:center"><a href="' + initialURL + item.drivingLicenceImage + '" target="_blank"><img src="../images/viewImage.png" style="height:100x; width:120x"/></a></td>' +
                                '<td>' + item.mobileNumber1 + '</td>' +
                                '<td>' + item.mobileNumber2 + '</td>' +
                                '<td>' + item.isExistingReference + '</td>' +
                                '<td>' + item.referenceName + '</td>' +
                                '<td>' + item.referenceAddress1 + '</td>' +
                                '<td>' + item.referenceAddress2 + '</td>' +
                                '<td>' + item.referenceAddress3 + '</td>' +
                                '<td>' + item.referenceCity + '</td>' +
                                '<td>' + item.referencePinCode + '</td>' +
                                '<td>' + item.referenceMobile + '</td>' +
