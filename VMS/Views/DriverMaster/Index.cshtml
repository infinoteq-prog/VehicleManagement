        function saveDriverMaster() {
            var isValid = checkValidation(); 

            if (isValid == true) {
                // if ($('#ddlState option:selected').val() != "0" &&
                //     $('#ddlDistrict option:selected').val() != "0" &&
                //     $('#ddlCity option:selected').val() != "0" &&
                //     $("#txtDriverName").val() != "" &&
                //     $("#txtFatherName").val() != "" &&
                //     $("#txtDriverAddress1").val() != "" &&
                //     $("#txtPinCode").val() != "" &&
                //     $("#txtAadharNo").val() != "" &&
                //     $("#txtPanNo").val() != "" &&
                //     $("#txtBankName").val() != "" &&
                //     $("#txtBankAccountNumber").val() != "" &&
                //     $("#txtBankIFSCCode").val() != "" &&
                //     $("#txtDrivingLicenceNo").val() != "" &&
                //     $("#txtDrivingLicenceIssueAuth").val() != "" &&
                //     $("#txtDrivingLicenceValidity").val() != "" &&
                //     $("#txtMobileNumber1").val() != "") 
                    {
                    var drivingLicenceValidity = $("#txtDrivingLicenceValidity").val();
                    drivingLicenceValidity = drivingLicenceValidity.split("-").reverse().join("-");

                    if ($('#ddlExistingReference option:selected').val() === 'true') {
                        var driverValue = $("#ddlDriver option:selected").val();

                        if (driverValue === null || driverValue === "" || parseInt(driverValue) <= 0 || isNaN(parseInt(driverValue))) {
                            alert("Please select a reference driver.");
                            return false; // Stop further execution in this block
                        }
                    }

                    var formData = new FormData();
                    formData.append("driverName", $('#txtDriverName').val());
                    formData.append("fatherName", $("#txtFatherName").val());
                    formData.append("driverAddress1", $("#txtDriverAddress1").val());
                    formData.append("driverAddress2", $("#txtDriverAddress2").val());
                    formData.append("driverAddress3", $("#txtDriverAddress3").val());
                    formData.append("stateId", $("#ddlState option:selected").val());
                    formData.append("districtId", $("#ddlDistrict option:selected").val());
                    formData.append("cityId", $("#ddlCity option:selected").val());
                    formData.append("pinCode", $("#txtPinCode").val());
                    formData.append("driverPhoto", $("#txtDriverPhoto")[0].files[0]);
                    formData.append("aadharNo", $("#txtAadharNo").val());
                    formData.append("aadharNoImage", $("#txtAadharNoImage")[0].files[0]);
                    formData.append("panNo", $("#txtPanNo").val());
                    formData.append("panNoImage", $("#txtPanNoImage")[0].files[0]);
                    formData.append("bankName", $("#txtBankName").val());
                    formData.append("bankAccountNumber", $("#txtBankAccountNumber").val());
                    formData.append("bankIfscCode", $("#txtBankIFSCCode").val());
                    formData.append("drivingLicenceNo", $("#txtDrivingLicenceNo").val());
                    formData.append("drivingLicenceAuth", $("#txtDrivingLicenceIssueAuth").val());
                    formData.append("drivingLicenceValidity", drivingLicenceValidity);
                    formData.append("drivingLicenceImage", $("#txtDrivingLicenceImage")[0].files[0]);
                    formData.append("mobileNo1", $("#txtMobileNumber1").val());
                    formData.append("mobileNo2", $("#txtMobileNumber2").val());
                    formData.append("isExistingReference", $('#ddlExistingReference option:selected').val());
                    formData.append("referenceName", $("#ddlDriver option:selected").val());
                    formData.append("referenceAddress1", $("#txtReferenceAddress1").val());
                    formData.append("referenceAddress2", $("#txtReferenceAddress2").val());
                    formData.append("referenceAddress3", $("#txtReferenceAddress3").val());
                    formData.append("referenceCity", $("#txtReferenceCity").val());
                    formData.append("referencePin", $("#txtReferencePinCode").val());
                    formData.append("referenceMobile", $("#txtReferenceMobile").val());
                    formData.append("isActive", $("#chkIsActive").is(":checked"));
                    formData.append("oldFirm", $("#txtOldFirm").val());
                    formData.append("remark", $("#txtRemark").val());

                    $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "DriverMaster/Save")',
                        type: "POST",
                        dataType: "json",
                        processData: false,
                        contentType: false,
                        data: formData,
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'Save Driver Master!',
                                        content: "Driver Master has been saved successfully!",
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    //getUserList();
                                                    //clearControls();
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "DriverMaster/Index")';
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'Driver Master Already Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                    $("#divDriverMaster").hide();
                                }
                            } else {
                                console.log(data);
                                //clearControls();
                                $.confirm({
                                    title: 'Error Occoured!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divDriverMaster").hide();
                            }
                        }
                    });
                }
            }
        }
    </script>
