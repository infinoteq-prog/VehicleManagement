@model VMS.ViewModel.VMTransporterBill
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
} *@

@* @if (userAccess.TransporterBillFullAccess == true || userAccess.TransporterBillViewAccess == true)
{ *@

<div class="content-wrapper">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Change Password</h4>
                    <div class="row rowHeight">
                        <div class="col-md-6 div-table-style">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="txtNewPassword">New Password :</label>
                                <div class="col-sm-8">
                                    <input type="password" id="txtNewPassword" placeholder="Enter your new password" class="form-control">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 div-table-style">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="to-date-picker">Confirm Password : </label>
                                <div class="col-sm-8">
                                    <input type="password" id="txtConfirmPassword" placeholder="Enter your confirm password" class="form-control">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                    @* @if (userAccess.TransporterBillFullAccess == true || userAccess.TransporterBillViewAccess == true)
                        { *@
                    <div class="row" style="text-align:center;margin-top:30px;">
                        <div class="col-md-12">
                            <button type="button" class="btn btn-primary mr-2" onclick="changePassword();">Change Password</button>
                            <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.TransporterBillFullAccess';
        // var addAccess = '@ViewBag.TransporterBillInsertAccess';
        // var viewAccess = '@ViewBag.TransporterBillViewAccess';
        // var viewPendingBillAccess = '@ViewBag.TransporterBillPendingAccess';
        // var printAccess = '@ViewBag.TransporterBillPrintAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var viewPendingBillAccess = 'True';
        var printAccess = 'True';
        var viewButton = "";
        var viewExceptionalItemButton = "";
        var viewTransButton = "";
        var printButton = "";
        $(document).ready(function () {
            setSideMenu("transporter-bill");
            if (fullAccess === "True" || viewAccess === "True") {
                $('.chkSelect').prop('checked', false);
                $(function () {
                    $("#from-date-picker").datepicker({
                        dateFormat: 'dd-mm-yy'
                    });

                    $("#to-date-picker").datepicker({
                        dateFormat: 'dd-mm-yy'
                    });
                });
                viewTransporterBillTrans("pageload");
            }
        });

        function checkValidation() {
            var isValid = true;
            if ($("#txtNewPassword").val() == "") {
                $("#txtNewPassword").attr('class', 'form-control vaidationTextBoxError');
                $("#txtNewPassword").focus();
                isValid = false;
            } else {
                $("#txtNewPassword").attr('class', 'form-control');
                $("#txtNewPassword").focus();
            }

            if ($("#txtConfirmPassword").val() == "") {
                $("#txtConfirmPassword").attr('class', 'form-control vaidationTextBoxError');
                $("#txtConfirmPassword").focus();
                isValid = false;
            } else {
                $("#txtConfirmPassword").attr('class', 'form-control');
                $("#txtConfirmPassword").focus();
            }

            if ($("#txtNewPassword").val() != $("#txtConfirmPassword").val()) {
                $.confirm({ title: 'Password does not match!',
                            content: 'New Password and Confirm Password did not match. Please try again!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                $("#txtNewPassword").attr('class', 'form-control vaidationTextBoxError');
                $("#txtConfirmPassword").attr('class', 'form-control vaidationTextBoxError');
                $("#txtNewPassword").focus();
                isValid = false;
            } else {
                $("#txtNewPassword").attr('class', 'form-control');
                $("#txtConfirmPassword").attr('class', 'form-control');
                $("#txtNewPassword").focus();
            }

            return isValid;
        }

        function checkValidationOnChange() {
            $(function () {
                $("#txtNewPassword").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });
                $("#txtConfirmPassword").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });
            });
        }

        function clearControls() {
            $("#txtNewPassword").val("");
            $("#txtConfirmPassword").val("");
        }

        function changePassword() {
           var isValid = checkValidation();
            if (isValid == true) {
                var newPassword = $("#txtNewPassword").val();
                var confirmPassword = $("#txtNewPassword").val();
                $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "Login/ChangePasswordRequest")',
                        type: "POST",
                        dataType: "json",
                        data: {newPassword: newPassword},
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'Change Password Success!',
                                        content: data.transactionMessage.message,
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    clearControls();
                                                    //window.location.href = '@(utilityHelper.SiteUrl() + "UserRole/Update?userRoleID=")' + $("#hdnUserRoleID").val();
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'User Name Not Found!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                }
                            } else {
                                console.log(data);
                                //clearControls();
                                $.confirm({
                                    title: 'Error Occoured!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                            }
                        }
                });
            }
        }
    </script>
}