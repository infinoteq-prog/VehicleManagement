<script type="text/javascript">
$(document).ready(function () {
    setSideMenu("dashboard");

    var userRole = @userLogin.RoleName;

    if (userRole === User)
    {
        //getTrasporterBills();
        getCompanyMasterList();
        //getTransporterMasterList();
        //getGSTMasterList();
    }

    if (userRole === Admin || userRole === SuperAdmin)
    {
        getTopMakeList();
        getTopModelMasterList();
        getTopDriverMasterList();
        getTopVehicleMasterList();
        getTopDistanceMasterList();
        getExpenseMasterList();
        //getTrasporterBills();
        getCompanyMasterList();
        //getTransporterMasterList();
        //getGSTMasterList();
        getTopUserList();
        getUserSubscriptionList();
        getTopUserRoleList();
        getFunctionMasterList();
        getUserRoleAccessList();
    }
});


function bindMakeDataTable() {
            $('#tblMakeMaster').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "Code Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "Code Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "Code Master List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }


        function getTopMakeList() {
            var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var viewPendingBillAccess = 'True';
        var printAccess = 'True';
        var viewButton = "";
        var viewTransButton = "";
        var printButton = "";
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "MakeMaster/getMakeMasterList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $.each(data, function (i, item) {
                            var sno = 0;
                            var rows = "";
                            var row = "";
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewMakeMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
