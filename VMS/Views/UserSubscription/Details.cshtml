@model VMS.ViewModel.VMUserSubscription
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
}
@if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
{ *@
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">User Subscription Details</h4>
                    <div>
                        <form id="frmUserRole" name="frmUserRole" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <input id="hdnuserSubscriptionId" name="hdnuserSubscriptionId" type="hidden">
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtUserName"> User Name</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.UserName, new { @class = "form-control", id = "txtUserName" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtFinancialYear"> Financial Year</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.FinYear, new { @class = "form-control", id = "txtFinancialYear" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtAmount"> Amount</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.Amount, new { @class = "form-control", id = "txtAmount" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="from-date-picker">Paid Date :</label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtPaidDate" placeholder="Select Paid Date" class="form-control" onchange="setTextboxStyle(this);" readonly=" readonly">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtStartDate">From Date:</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.StartDate, new { @class = "form-control", id = "txtStartDate" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtEndDate">To Date :</label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(x => x.EndDate, new { @class = "form-control", id = "txtEndDate" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-12">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="chkIsActive">Is Active</label>
                                        <div class="col-sm-8">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-label checkboxStyle", id = "chkIsActive" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-12"></div>
                            </div>
                        </form>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        var fullAccess = 'True';
        var viewAccess = 'True';

        $(document).ready(function () {
            setSideMenu("user-subscription");
            if (fullAccess === "True" || viewAccess === "True") {
                makeFieldsReadOnly();
                var userSubscriptionId = GetParameterValues('userSubscriptionId');
                getUserSubscriptionID(userSubscriptionId);
            }
        });

        function makeFieldsReadOnly() {
            $('#txtUserName').prop("readonly", true);
            $('#txtFinancialYear').prop("readonly", true);
            $('#txtAmount').prop("readonly", true);
            $('#txtPaidDate').prop("readonly", true);
            $("#txtStartDate").prop("readonly", true);
            $("#txtEndDate").attr("disabled", true);
            $("#chkIsActive").attr("disabled", true);
        }

        function getUserSubscriptionID(userSubscriptionId) {
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "UserSubscription/getUserSubscriptionByID")',
                type: "GET",
                data: { userSubscriptionId: userSubscriptionId },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $('#txtUserName').val(data.userName);
                        $('#txtFinancialYear').val(data.finYear);
                        $('#txtAmount').val(data.amount);
                        $("#txtPaidDate").val(data.paidDateString);
                        $("#txtStartDate").val(data.startDateString);
                        $("#txtEndDate").val(data.endDateString);
                        $("#chkIsActive").prop('checked', data.isActive);
                    } else {
                        $.confirm({
                            title: 'User Subscription',
                            content: 'User Subscription does not Exists!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}