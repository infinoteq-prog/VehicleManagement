@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";

        $(document).ready(function () {
            setSideMenu("user-subscription");
            $("#chkIsActive").attr("checked", true);
            $("#chkIsActive").attr("disabled", true);
            if (fullAccess === "True" || addAccess === "True") {
                checkValidationOnChange();
            }
            if (fullAccess === "True" || viewAccess === "True") {
                getUserSubscriptionList();
            }
            getUserList();   
        });

        function bindDataTable() {
            $('#tblUserSubscription').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "User Subscription List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "User Subscription List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "User Subscription List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }

        function checkValidation() {
            var isValid = true;                
            if ($('#ddlUser option:selected').val() == "0") {
                $("#ddlUser").attr('class', 'form-control vaidationTextBoxError');
                $("#ddlUser").focus();
                isValid = false;
            } else {
                $("#ddlUser").attr('class', 'form-control');
                $("#ddlUser").focus();
            }

            if ($("#txtFinancialYear").val() == "") {
                $("#txtFinancialYear").attr('class', 'form-control vaidationTextBoxError');
                $("#txtFinancialYear").focus();
                isValid = false;
            } else {
                $("#txtFinancialYear").attr('class', 'form-control');
                $("#txtFinancialYear").focus();
            }

            if ($("#txtAmount").val() == "") {
                $("#txtAmount").attr('class', 'form-control vaidationTextBoxError');
                $("#txtAmount").focus();
                isValid = false;
            } else {
                $("#txtAmount").attr('class', 'form-control');
                $("#txtAmount").focus();
            }

            if ($("#txtPaidDate").val() == "") {
                $("#txtPaidDate").attr('class', 'form-control vaidationTextBoxError');
                $("#txtPaidDate").focus();
                isValid = false;
            } else {
                $("#txtPaidDate").attr('class', 'form-control');
                $("#txtPaidDate").focus();
            }

            if ($("#from-date-picker").val() == "") {
                $("#from-date-picker").attr('class', 'form-control vaidationTextBoxError');
                $("#from-date-picker").focus();
                isValid = false;
            } else {
                $("#from-date-picker").attr('class', 'form-control');
                $("#from-date-picker").focus();
            }

            if ($("#to-date-picker").val() == "") {
                $("#to-date-picker").attr('class', 'form-control vaidationTextBoxError');
                $("#to-date-picker").focus();
                isValid = false;
            } else {
                $("#to-date-picker").attr('class', 'form-control');
                $("#to-date-picker").focus();
            }
            return isValid;
        }

        function checkValidationOnChange() {
            $(function () {
                $("#ddlUser").change(function () {
                    if ($('option:selected', this).val() == "0") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtFinancialYear").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtAmount").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#txtPaidDate").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#from-date-picker").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });

                $("#to-date-picker").on("input", function () {
                    if ($(this).val() == "") {
                        $(this).attr('class', 'form-control vaidationTextBoxError');
                        $(this).focus();
                    } else {
                        $(this).attr('class', 'form-control');
                        $(this).focus();
                    }
                });
            });
        }

        function clearControls() {
            $("#ddlUser").prop("selectedIndex", 0).val();
            $("#from-date-picker").val("");
            $("#to-date-picker").val("");
            $("#txtFinancialYear").val("");
            $("#txtAmount").val("");
            $("#txtPaidDate").val("");
            $("#chkIsActive").prop("checked", false);
        }

        function getUserSubscriptionList() {
            if ($.fn.DataTable.isDataTable("#tblUserSubscription")) {
                $('#tblUserSubscription tbody').empty();
                $('#tblUserSubscription').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "UserSubscription/getUserSubscriptionList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $.each(data, function (i, item) {
                            var sno = 0;
                            var rows = "";
                            var row = "";
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewUserSubscription(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editUserSubscription(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteUserSubscription(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                                viewButton +
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.userName + '</td>' +
                                '<td>' + item.finYear + '</td>' +
                                '<td>' + item.amount.toString() + '</td>' +
                                '<td>' + item.paidDateString + '</td>' +
                                '<td>' + item.startDateString + '</td>' +
                                '<td>' + item.endDateString + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.createDate + '</td>' +
                                '<td>' + item.createdBy + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updateBy + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            $("#userSubscriptionBody").append(rows);
                            rows = "";
                            $("#tblUserSubscription").focus();
                        });
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="12" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#userSubscriptionBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }

        function saveUserSubscription() {
            var isValid = checkValidation();

            if (isValid == true) {
                if ($('#ddlUser option:selected').val() != "0"
                    && $("#txtFinancialYear").val() != ""
                    && $("#txtAmount").val() != ""
                    && $("#txtPaidDate").val() != ""
                    && $("#from-date-picker").val() != ""
                    && $("#to-date-picker").val() != "") {
                    var userId = $('#ddlUser option:selected').val();
                    var finYear = $("#txtFinancialYear").val();
                    var amount = $("#txtAmount").val();
                    var paidDate = $("#txtPaidDate").val();
                    var isActive = $("#chkIsActive").is(":checked");
                    var startDate = $("#from-date-picker").val();
                    var endDate = $("#to-date-picker").val();
                    var paidDt = paidDate.split("-").reverse().join("-");
                    var fromDate = startDate.split("-").reverse().join("-");
                    var toDate = endDate.split("-").reverse().join("-");
                    $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "UserSubscription/Save")',
                        type: "POST",
                        dataType: "json",
                        data: { userId: userId, finYear: finYear, amount: amount, paidDate: paidDt, startDate: fromDate, endDate: toDate, isActive: isActive },
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'Save User Subscription!',
                                        content: "User Subscription has been saved successfully!",
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    //getUserList();
                                                    //clearControls();
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "UserSubscription/Index")';
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'User Subscription Already Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                    $("#divUserSubscription").hide();
                                }
                            } else {
                                console.log(data);
                                //clearControls();
                                $.confirm({
                                    title: 'Error Occoured!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divUserSubscription").hide();
                            }
                        }
                    });
                }
            }
        }
    </script>
}