                                        <div class="col-sm-8">
                                            <input type="text" id="txtPaidDate" placeholder="Select Paid Date" class="form-control" onchange="setTextboxStyle(this);" readonly=" readonly">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
