                                        <div class="col-sm-8">
                                            <input type="text" id="from-date-picker" placeholder="Select From Date" class="form-control" onchange="setTextboxStyle(this);" readonly=" readonly">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="to-date-picker">To Date: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" id="to-date-picker" placeholder="Select To Date" class="form-control" onchange="setTextboxStyle(this);" readonly="readonly">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-2 col-form-label" for="chkIsActive">Is Active:</label>
                                        <div class="col-sm-10">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-label checkboxStyle", id = "chkIsActive" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-12"></div>
                            </div>
                           @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleAddAccess == true)
                            { *@
                                <div class="row rowHeight" style="text-align:center;">
                                    <div class="col-md-12">
                                        <button type="button" class="btn btn-primary mr-2" onclick="saveUserSubscription();">Save</button>
                                        <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button>
                                    </div>
                                </div>
                            @* } *@
                        </form>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                   @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
                        { *@
                        <div id="divUserSubscription">
                            <div class="table-responsive pt-3">
                                <table id="tblUserSubscription" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                    <thead>
                                        <tr>
                                            <th>Actions</th>
                                            <th>User Name</th>
                                            <th>Financial Year</th>
                                            <th>Amount Year</th>
                                            <th>Paid Date</th>
                                            <th>Start Date</th>
                                            <th>End Date</th>
                                            <th>Is Active</th>
                                            <th>Creation Date</th>
                                            <th>Created By</th>
                                            <th>Update Date</th>
                                            <th>Updatd By</th>
