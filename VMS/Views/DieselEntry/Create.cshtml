@model VMS.Models.DieselEntryModel
@{
    ViewData["Title"] = "Diesel Entry";
}

<link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css" rel="stylesheet" />
<style>
    table.dataTable thead th {
        background-color: #6c2eb9;
        color: white;
        text-align: center;
    }

    .dataTables_wrapper .dt-buttons {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 0px;
    }

    .dataTables_filter {
        display: flex;
        align-items: center;
        gap: 10px;
    }
</style>
<div class="container mb-4">
    <div class="card shadow p-4">
        <h3 class="card-title mb-4">Diesel Entry</h3>

    <form id="dieselForm" asp-action="Create" method="post">
        <input type="hidden" name="DieselEntryID" />
        <div class="row mb-3">
            <div class="col-md-3">
                <label>Start Date</label>
                <input asp-for="StartDate" type="date" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label>End Date</label>
                <input asp-for="EndDate" type="date" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label>Diesel Rate</label>
                <input asp-for="DieselRate" type="number" step="0.01" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label>Remarks</label>
                <input asp-for="Remarks" class="form-control" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" id="submitBtn" class="btn btn-success">Add Entry</button>
            <button type="button" id="cancelBtn" class="btn btn-secondary" style="display:none;">Cancel</button>
        </div>

        <div id="message" class="alert alert-success mt-3" style="display:none;"></div>
    </form>


    <hr />

    <h4 class="mt-4">All Diesel Entries</h4>
    <table id="dieselTable" class="display nowrap table table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>Actions</th>
                <th>ID</th>
                <th>Start Date</th>
                 <th>End Date</th>
                <th>Diesel Rate</th>
                <th>Remarks</th>
               @*  <th>Created By</th>
                <th>Created Date</th> *@
                <th>IsActive</th>
               @*  <th>Updated By</th>
                <th>Updated Date</th> *@
            </tr>
        </thead>
    </table>

</div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>

<script>
    $(document).ready(function () {
        var table = $('#dieselTable').DataTable({
            ajax: {
                url: '@Url.Action("GetAllDieselEntries", "DieselEntry")',
                dataSrc: 'data'
            },
            columns: [
                {
                    data: null,
                    render: function (data) {
                        return `
                                <button class="btn btn-sm btn-primary edit-btn" data-id="${data.dieselEntryID}">Edit</button>
                                <button class="btn btn-sm btn-danger delete-btn ms-2" data-id="${data.dieselEntryID}">Delete</button>
                            `;
                    },
                    orderable: false
                },
                { data: 'dieselEntryID' },
                { data: 'startDate' },
                { data: 'endDate' },
                { data: 'dieselRate' },
                { data: 'remarks' },
                // { data: 'created_By' },
                // { data: 'createdDate' },
                { data: 'isActive' },
                // { data: 'updatedBy' },
                // { data: 'updatedDate' }
            ],
            dom: 'Bfrtip',
            buttons: ['copy', 'excel', 'pdf', 'print'],
            scrollX: true,
            pageLength: 10
        });

        $('#dieselForm').on('submit', function (e) {
            e.preventDefault();
            var formData = $(this).serialize();
            var actionUrl = $(this).attr('action');

            $.post(actionUrl, formData, function (res) {
                if (res.success) {
                    $('#message').text(res.message).fadeIn().delay(3000).fadeOut();

                    resetForm();
                    table.ajax.reload(null, false); 
                } else {
                    alert("Something went wrong!");
                }
            }).fail(function () {
                alert("Server error. Check controller response.");
            });
        });

        $('#dieselTable').on('click', '.edit-btn', function () {
            var row = table.row($(this).parents('tr')).data();

            $('input[name="DieselEntryID"]').val(row.dieselEntryID);
            $('input[name="StartDate"]').val(row.startDate.split('T')[0]);
            $('input[name="EndDate"]').val(row.endDate.split('T')[0]);
            $('input[name="DieselRate"]').val(row.dieselRate);
            $('input[name="Remarks"]').val(row.remarks);

            $('#submitBtn').text('Update Entry').removeClass('btn-success').addClass('btn-primary');
            $('#cancelBtn').show();
            $('#dieselForm').attr('action', '@Url.Action("UpdateDieselEntry", "DieselEntry")');
        });

        $('#dieselTable').on('click', '.delete-btn', function () {
            var id = $(this).data('id');
            if (confirm("Are you sure you want to delete this entry?")) {
                $.post('@Url.Action("DeleteDieselEntry", "DieselEntry")', { id: id }, function (res) {
                    if (res.success) {
                        $('#message').text("Deleted successfully!").fadeIn().delay(3000).fadeOut();
                        table.ajax.reload(null, false);
                    }
                });
            }
        });

        $('#cancelBtn').click(function () {
            resetForm();
        });

        function resetForm() {
            $('#dieselForm')[0].reset();
            $('input[name="DieselEntryID"]').val('');
            $('#submitBtn').text('Add Entry').removeClass('btn-primary').addClass('btn-success');
            $('#cancelBtn').hide();
            $('#dieselForm').attr('action', '@Url.Action("Create", "DieselEntry")');
        }
    });
</script>


