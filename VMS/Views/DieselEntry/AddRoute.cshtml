@model VMS.Models.RouteModel
@{
    ViewData["Title"] = "Add Route";
}

<link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css" rel="stylesheet" />
<style>
    table.dataTable thead th {
        background-color: #6c2eb9;
        color: white;
        text-align: center;
    }

    .dataTables_wrapper .dt-buttons {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 0px;
    }

    .dataTables_filter {
        display: flex;
        align-items: center;
        gap: 10px;
    }
</style>
<div class="container mb-4">
    <div class="card shadow p-4">
        <h3 class="card-title mb-4">Add Route</h3>

    <!-- Route Form -->
    <form id="routeForm" method="post" action="@Url.Action("SaveRoute", "DieselEntry")">
        <input type="hidden" asp-for="RouteID" />
            <div id="message" class="alert alert-success mt-3" style="display:none;"></div>
        <div class="row mb-3">
            <div class="col-md-4">
                <label>Route Name</label>
                <input asp-for="RouteName" class="form-control" required />
            </div>
          
            <div class="col-md-4">
                 <label>RouteExpAmt</label>
                 <input asp-for="RouteExpAmt" class="form-control"  />
            </div>
            <div class="col-md-4">
                 <label>Status</label>
                        <input asp-for="Status" class="form-control" required />
                
             </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" id="submitBtn" class="btn btn-success">
                @(Model.RouteID > 0 ? "Update Route" : "Add Route")
            </button>
            <button type="button" id="cancelBtn" class="btn btn-secondary" @(Model.RouteID > 0 ? "" : "style='display:none;'")>Cancel</button>
        </div>

      
    </form>

    <hr />

    <!-- Route Grid -->
    <h4 class="mt-4">Route List</h4>
    <table id="routeTable" class="display nowrap table table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>Actions</th>
                <th>ID</th>
                <th>Route Name</th>
                <th>RouteExpAmt</th>
                <th>Status</th>
                <th>IsActive</th>
                @* <th>Created By</th>
                <th>Created Date</th>
                <th>Updated By</th>
                <th>Updated Date</th> *@
            </tr>
        </thead>
    </table>
</div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>

<script>
    $(document).ready(function () {
        // Initialize DataTable
        var table = $('#routeTable').DataTable({
            ajax: { url: '@Url.Action("GetAllRoutes", "DieselEntry")', dataSrc: 'data' },
            columns: [
                {
                    data: null,
                    render: function (data) {
                        return `
                            <button class="btn btn-sm btn-primary edit-btn" data-id="${data.routeID}">Edit</button>
                            <button class="btn btn-sm btn-danger delete-btn ms-2" data-id="${data.routeID}">Delete</button>
                        `;
                    },
                    orderable: false
                },
                { data: 'routeID' },
                { data: 'routeName' },
                { data: 'routeExpAmt' },
                { data: 'status' },
                { data: 'isActive' },
                // { data: 'createdBy' },
                // { data: 'createdDate' },
                // { data: 'updatedBy' },
                // { data: 'updatedDate' }
            ],
            dom: 'Bfrtip',
            buttons: ['copy', 'excel', 'pdf', 'print'],
            scrollX: true,
            pageLength: 10
        });

        // Add/Edit Route
        $('#routeForm').submit(function (e) {
            e.preventDefault();
            $.post($(this).attr('action'), $(this).serialize(), function (res) {
                if (res.success) {
                    $('#message').text(res.message).fadeIn().delay(3000).fadeOut();
                    resetForm();
                    table.ajax.reload(null, false); // reload grid

                    // Clear URL query string if redirected from RouteList
                    if (window.history.replaceState) {
                        window.history.replaceState(null, null, window.location.pathname);
                    }
                }
            });
        });

        // Edit from grid
        $('#routeTable').on('click', '.edit-btn', function () {
            var row = table.row($(this).parents('tr')).data();

            $('input[name="RouteID"]').val(row.routeID);
            $('input[name="RouteName"]').val(row.routeName);
            $('input[name="RouteExpAmt"]').val(row.routeExpAmt);
            $('input[name="Status"]').val(row.status);

            $('#submitBtn').text('Update Route')
                .removeClass('btn-success')
                .addClass('btn-primary');
            $('#cancelBtn').show();
        });

        // Delete from grid
        $('#routeTable').on('click', '.delete-btn', function () {
            var id = $(this).data('id');
            if (confirm("Are you sure you want to delete this route?")) {
                $.post('@Url.Action("DeleteRoute", "DieselEntry")', { id: id }, function (res) {
                    if (res.success) {
                        $('#message').text(res.message).fadeIn().delay(3000).fadeOut();
                        table.ajax.reload(null, false);
                        resetForm();
                    }
                });
            }
        });

        // Cancel button resets form
        $('#cancelBtn').click(function () {
            resetForm();
        });

        // Reset form helper
        function resetForm() {
            $('#routeForm')[0].reset();
            $('input[name="RouteID"]').val('');
            $('#submitBtn').text('Add Route')
                .removeClass('btn-primary')
                .addClass('btn-success');
            $('#cancelBtn').hide();
        }

        // Prefill if redirected with ID (from RouteList)
        var routeId = '@Model.RouteID';
        if (routeId && routeId != '0') {
            $('#submitBtn').text('Update Route').removeClass('btn-success').addClass('btn-primary');
            $('#cancelBtn').show();
        }
    });
</script>

