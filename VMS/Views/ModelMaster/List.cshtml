        function clearControls() {
            $("#ddlMakeMaster").prop("selectedIndex", 0).val();
            $("#txtModelNo").val("");
            $("#txtUlAvg").val("");
            $("#txtMegaHW").val("");
            $("#txtKhali").val("");
            $("#txtNh").val("");
            $("#txtOffRoad").val("");
            $("#txtOverLoad").val("");
            $("#txtOther").val("");
            $("#chkIsActive").prop("checked", false);
        }

        function searchModelMaster() {
            if ($.fn.DataTable.isDataTable("#tblModelMaster")) {
                $('#tblModelMaster tbody').empty();
                $('#tblModelMaster').DataTable().clear().destroy();
            }

            var makeId = $('#ddlMakeMaster option:selected').val();
            var modelNo = $("#txtModelNo").val();
            var ulAvg =  $("#txtUlAvg").val();
            var megaHW =  $("#txtMegaHW").val();
            var khali = $("#txtKhali").val();
            var nh = $("#txtNh").val();
            var offRoad = $("#txtOffRoad").val();
            var overLoad = $("#txtOverLoad").val();
            var other = $("#txtOther").val();
            var isActive = $("#chkIsActive").is(":checked");

            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "ModelMaster/searchModelMaster")',
                type: "GET",
                dataType: "json",
                data: {makeId: makeId, modelNo: modelNo, ulAvg: ulAvg,
                                megaHW: megaHW, khali: khali, nh: nh,
                                offRoad: offRoad, overLoad: overLoad,
                                other: other, isActive: isActive},
                success: function (data) {
                    if (data != null && data != undefined) {
                        console.log(data);
                        var rows = "";
                        var row = "";
                        $.each(data, function (i, item) {
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewModelMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editModelMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteModelMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                               
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.makeName + '</td>' +
                                '<td>' + item.modelNo + '</td>' +
                                '<td>' + item.ulAvg + '</td>' +
                                '<td>' + item.megaHw + '</td>' +
                                '<td>' + item.khali + '</td>' +
                                '<td>' + item.nh + '</td>' +
                                '<td>' + item.offRoad + '</td>' +
                                '<td>' + item.overLoad + '</td>' +
                                '<td>' + item.other + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.creationDate + '</td>' +
                                '<td>' + item.createdByName + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updatedByName + '</td>' +
                                '</tr>';
                            rows = rows + row;
                        });
                        $("#divModelMaster").show();
                        $("#tblModelMaster").focus();
                        $("#modelMasterBody").html(rows);
                        bindDataTable();
                        rows = "";
                    }
                    else {
                        console.log(data);
                        $.confirm({
                            title: 'Model Master List',
                            content: 'Model Master Not Found!',
                            icon: 'fa fa-warning',
                            type: 'red',
                            buttons: {
                                omg: {
                                    text: 'OK',
                                    btnClass: 'btn-red',
                                },
                            }
                        });
                        var row = '<tr>' +
                            '<td>' +
                            '<div class="d-flex align-items-center">' +
                            '</div>' +
                            '</td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td style="text-align:center">No Data Found!!!</td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '<td></td>' +
                            '</tr>';
                        $("#modelMasterBody").html(row);
                    }
                }
            });
            //}
        }

        function getModelMasterList() {
            if ($.fn.DataTable.isDataTable("#tblModelMaster")) {
                $('#tblModelMaster tbody').empty();
                $('#tblModelMaster').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "ModelMaster/getModelMasterList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        var sno = 0;
                        var rows = "";
                        var row = "";
                        $("#modelMasterBody").html("");
                        $.each(data, function (i, item) {
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewModelMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editModelMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteModelMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                               
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.makeName + '</td>' +
                                '<td>' + item.modelNo + '</td>' +
                                '<td>' + item.ulAvg + '</td>' +
                                '<td>' + item.megaHw + '</td>' +
                                '<td>' + item.khali + '</td>' +
                                '<td>' + item.nh + '</td>' +
                                '<td>' + item.offRoad + '</td>' +
                                '<td>' + item.overLoad + '</td>' +
                                '<td>' + item.other + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.creationDate + '</td>' +
                                '<td>' + item.createdByName + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updatedByName + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            row = "";
                            $("#tblModelMaster").focus();
                        });
                        $("#modelMasterBody").append(rows);
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="15" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#modelMasterBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}