        function clearControls() {
            $("#ddlMakeMaster").prop("selectedIndex", 0).val();
            $("#txtModelNo").val("");
            $("#txtUlAvg").val("");
            $("#txtMegaHW").val("");
            $("#txtKhali").val("");
            $("#txtNh").val("");
            $("#txtOffRoad").val("");
            $("#txtOverLoad").val("");
            $("#txtOther").val("");
            $("#chkIsActive").prop("checked", false);
        }

        function getUserRoleList() {
            if ($.fn.DataTable.isDataTable("#tblModelMaster")) {
                $('#tblModelMaster tbody').empty();
                $('#tblModelMaster').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "ModelMaster/getUserRoleList")',
                type: "GET",
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        $.each(data, function (i, item) {
                            var sno = 0;
                            var rows = "";
                            var row = "";
                            sno = sno + 1;
                            if (fullAccess === "True" || viewAccess === "True") {
                                viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewModelMaster(\'' + item.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || updateAccess === "True") {
                                updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editModelMaster(\'' + item.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                            }

                            if (fullAccess === "True" || deleteAccess === "True") {
                                deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteModelMaster(\'' + item.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                            }
                            row = '<tr>' +
                                '<td>' +
                                '<div class="d-flex align-items-center">' +
                               
                                updateButton +
                                deleteButton +
                                '</div>' +
                                '</td>' +
                                '<td>' + item.makeName + '</td>' +
                                '<td>' + item.modelNo + '</td>' +
                                '<td>' + item.ulAvg + '</td>' +
                                '<td>' + item.megaHw + '</td>' +
                                '<td>' + item.khali + '</td>' +
                                '<td>' + item.nh + '</td>' +
                                '<td>' + item.offRoad + '</td>' +
                                '<td>' + item.overLoad + '</td>' +
                                '<td>' + item.other + '</td>' +
                                '<td>' + item.isActive + '</td>' +
                                '<td>' + item.creationDate + '</td>' +
                                '<td>' + item.createdByName + '</td>' +
                                '<td>' + item.updateDate + '</td>' +
                                '<td>' + item.updatedByName + '</td>' +
                                '</tr>';
                            rows = rows + row;
                            $("#modelMasterBody").append(rows);
                            rows = "";
                            $("#tblModelMaster").focus();
                        });
                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="15" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#modelMasterBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }

        function updateModelMaster() {
            var isValid = checkValidation();

            if (isValid == true) {
                 if ($('#ddlMakeMaster option:selected').val() != "0" &&
                    $("#txtModelNo").val() != ""  &&
                    $("#txtUlAvg").val() != ""  &&
                    $("#txtMegaHW").val() != ""  &&
                    $("#txtKhali").val() != ""  &&
                    $("#txtNh").val() != ""  &&
                    $("#txtOffRoad").val() != ""  &&
                    $("#txtOverLoad").val() != ""  &&
                    $("#txtOther").val() != "") {
                    var makeId = $('#ddlMakeMaster option:selected').val();
                    var modelNo = $("#txtModelNo").val();
                    var ulAvg =  $("#txtUlAvg").val();
                    var megaHW =  $("#txtMegaHW").val();
                    var khali = $("#txtKhali").val();
                    var nh = $("#txtNh").val();
                    var offRoad = $("#txtOffRoad").val();
                    var overLoad = $("#txtOverLoad").val();
                    var other = $("#txtOther").val();
                    var isActive = $("#chkIsActive").is(":checked");
                    var id = $('#hdnModelMasterID').val();
                    $.ajax({
                        cache: false,
                        url: '@(utilityHelper.SiteUrl() + "ModelMaster/Update")',
                        type: "POST",
                        dataType: "json",
                        data: { id: id, makeId: makeId, modelNo: modelNo, ulAvg: ulAvg,
                                megaHW: megaHW, khali: khali, nh: nh,
                                offRoad: offRoad, overLoad: overLoad,
                                other: other, isActive: isActive},
                        success: function (data) {
                            if (data != null && data != undefined) {
                                if (data.transactionMessage.status == '@((byte)TransactionStatus.Success)') {
                                    console.log(data);
                                    $.confirm({
                                        title: 'Update Model Master!',
                                        content: "Model Master has been updated successfully!",
                                        type: 'green',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-green',
                                                action: function () {
                                                    clearControls();
                                                    window.location.href = '@(utilityHelper.SiteUrl() + "ModelMaster/Update?modelMasterID=")' + $("#hdnModelMasterID").val();
                                                }
                                            },
                                        }
                                    });
                                } else if (data.transactionMessage.status == '@((byte)TransactionStatus.Failed)') {
                                    $.confirm({
                                        title: 'Model Master Already Exists!',
                                        content: data.transactionMessage.message,
                                        icon: 'fa fa-warning',
                                        type: 'red',
                                        buttons: {
                                            omg: {
                                                text: 'OK',
                                                btnClass: 'btn-red',
                                            },
                                        }
                                    });
                                    $("#divModelMaster").hide();
                                }
                            } else {
                                console.log(data);
                                //clearControls();
                                $.confirm({
                                    title: 'Error Occoured!',
                                    content: data.transactionMessage.message,
                                    icon: 'fa fa-warning',
                                    type: 'red',
                                    buttons: {
                                        omg: {
                                            text: 'OK',
                                            btnClass: 'btn-red',
                                        },
                                    }
                                });
                                $("#divModelMaster").hide();
                            }
                        }
                    });
                }
            }
        }

        function getModelMasterByID(modelMasterID) {
            if ($.fn.DataTable.isDataTable("#tblModelMaster")) {
                $('#tblModelMaster tbody').empty();
                $('#tblModelMaster').DataTable().clear().destroy();
            }
            $.ajax({
                cache: false,
                url: '@(utilityHelper.SiteUrl() + "ModelMaster/getModelMasterByID")',
                type: "GET",
                data: { modelMasterID: modelMasterID },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data != null && data != undefined) {
                        var sno = 0;
                        var rows = "";
                        var row = "";
                        sno = sno + 1;
                        if (fullAccess === "True" || viewAccess === "True") {
                            viewButton = '<button type="button" class="btn btn-view btn-sm btn-icon-text mr-3" onclick="viewModelMaster(\'' + data.id + '\');"> View <i class="typcn typcn-eye-outline btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || updateAccess === "True") {
                            updateButton = '<button type="button" class="btn btn-success btn-sm btn-icon-text mr-3" onclick="editModelMaster(\'' + data.id + '\');"> Edit <i class="typcn typcn-edit btn-icon-append"></i></button> ';
                        }

                        if (fullAccess === "True" || deleteAccess === "True") {
                            deleteButton = '<button id="complexConfirm" type="button" class="btn btn-danger btn-sm btn-icon-text" onclick="deleteModelMaster(\'' + data.id + '\');"> Delete <i class="typcn typcn-delete-outline btn-icon-append"></i></button> ';
                        }
                        row = '<tr>' +
                            '<td>' +
                            '<div class="d-flex align-items-center">' +
                         
                            updateButton +
                            deleteButton +
                            '</div>' +
                            '</td>' +
                            '<td>' + data.makeName + '</td>' +
                            '<td>' + data.modelNo + '</td>' +
                            '<td>' + data.ulAvg + '</td>' +
                            '<td>' + data.megaHw + '</td>' +
                            '<td>' + data.khali + '</td>' +
                            '<td>' + data.nh + '</td>' +
                            '<td>' + data.offRoad + '</td>' +
                            '<td>' + data.overLoad + '</td>' +
                            '<td>' + data.other + '</td>' +
                            '<td>' + data.isActive + '</td>' +
                            '<td>' + data.creationDate + '</td>' +
                            '<td>' + data.createdByName + '</td>' +
                            '<td>' + data.updateDate + '</td>' +
                            '<td>' + data.updatedByName + '</td>' +
                            '</tr>';

                        //Setting Model Master Details to Page Controls
                        $('#ddlMakeMaster option').map(function () {
                            if ($(this).val() == data.makeId) return this;
                        }).attr('selected', 'selected');
                        $('#txtModelNo').val(data.modelNo);
                        $("#txtUlAvg").val(data.ulAvg);
                        $("#txtMegaHW").val(data.megaHw);
                        $("#txtKhali").val(data.khali);
                        $("#txtNh").val(data.nh);
                        $("#txtOffRoad").val(data.offRoad);
                        $("#txtOverLoad").val(data.overLoad);
                        $("#txtOther").val(data.other);
                        $("#chkIsActive").prop('checked', data.isActive);
                        $('#hdnModelMasterID').val(data.id);

                        rows = rows + row;
                        $("#modelMasterBody").html(rows);
                        rows = "";
                        $("#tblModelMaster").focus();

                        bindDataTable();
                    } else {
                        var row = '<tr>' +
                            '<td colspan="15" style="text-align:center">No Data Found!!!</td>' +
                            '</tr>';
                        $("#modelMasterBody").html(row);
                    }
                },
                error: function (ex) {
                    alert(ex);
                }
            });
        }
    </script>
}