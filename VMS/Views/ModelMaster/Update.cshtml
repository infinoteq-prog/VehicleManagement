@model VMS.ViewModel.VMModelAverageMaster
@using VMS.Helper
@using VMS.Models
@using VMS.ViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@* @{
    var userAccess = (VMUserRoleAccess)HttpContextAccessor.HttpContext.Session.GetObjectFromJson<VMUserRoleAccess>("userAccess");
} *@

@* @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleUpdateAccess == true)
{ *@
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Update Model Master</h4>
                    <div id="divUpdateUserRole">
                        <form id="frmUserRole" name="frmUserRole" method="post" class="forms-sample" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <input id="hdnModelMasterID" name="hdnModelMasterID" type="hidden">
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <label id="lblMandatoryMessage" class="reqFields">@utilityHelper.reqFieldMessage</label>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="ddlMakeMaster">Select Make: <span class="reqFields">*</span> </label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="ddlMakeMaster" name="ddlMakeMaster" onchange="setDropDownStyle(this);"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtModelNo">Model No:<span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.ModelNo, new { @class = "form-control", id = "txtModelNo", @maxlength = "10" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtUlAvg">UL Guj: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.UlAvg, new { @class = "form-control decimalnumberonly", id = "txtUlAvg", @maxlength = "8" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtMegaHW">UL_MG: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.MegaHw, new { @class = "form-control decimalnumberonly", id = "txtMegaHW", @maxlength = "8" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtKhali">Khali: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.Khali, new { @class = "form-control decimalnumberonly", id = "txtKhali", @maxlength = "8" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtNh">UL_RAJ: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.Nh, new { @class = "form-control decimalnumberonly", id = "txtNh", @maxlength = "8" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtOffRoad">Off Road: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.OffRoad, new { @class = "form-control decimalnumberonly", id = "txtOffRoad", @maxlength = "8" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtOverLoad">OL_Flexi: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.OverLoad, new { @class = "form-control decimalnumberonly", id = "txtOverLoad", @maxlength = "8" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="txtOther">Flexi/Other: <span class="reqFields">*</span></label>
                                        <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.Other, new { @class = "form-control decimalnumberonly", id = "txtOther", @maxlength = "8" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-4 col-form-label" for="chkIsActive">Is Active:</label>
                                        <div class="col-sm-8">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-label checkboxStyle", id = "chkIsActive" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row rowHeight">
                                <div class="col-md-12"></div>
                            </div>
                           @*  @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleUpdateAccess == true)
                            { *@
                                <div class="row rowHeight" style="text-align:center;">
                                    <div class="col-md-12">
                                        <button type="button" class="btn btn-primary mr-2" onclick="updateModelMaster();">Update</button>
                                        <button type="button" class="btn btn-light" onclick="clearControls();">Clear</button>
                                    </div>
                                </div>
                           @*  } *@
                        </form>
                    </div>
                    <div class="row rowHeight">
                        <div class="col-md-12"></div>
                    </div>
                        @* @if (userAccess.AddUserRoleFullAccess == true || userAccess.AddUserRoleViewAccess == true)
                        { *@
                            <div id="divModelMaster">
                                <div class="table-responsive pt-3">
                                    <table id="tblModelMaster" class="table table-striped project-orders-table nowrap hover order-column row-border stripe display" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th>Actions</th>
                                                <th>Make Name</th>
                                                <th>Model No</th>
                                                <th>UL_GUJ</th>
                                                <th>UL_MG</th>
                                                <th>Khali</th>
                                                <th>UL_RAJ</th>
                                                <th>Off Road</th>
                                                <th>OL_Flexi</th>
                                                <th>Flexi/Other</th>
                                                <th>Is Active</th>
                                                <th>Creation Date</th>
                                                <th>Created By</th>
                                                <th>Update Date</th>
                                                <th>Updatd By</th>
                                            </tr>
                                        </thead>
                                        <tbody id="modelMasterBody">
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        @* } *@
                    </div>
            </div>
        </div>
    </div>
</div>
@* } *@
@section scripts {
    <script type="text/javascript">
        // var fullAccess = '@ViewBag.AddUserRoleFullAccess';
        // var addAccess = '@ViewBag.AddUserRoleAddAccess';
        // var viewAccess = '@ViewBag.AddUserRoleViewAccess';
        // var updateAccess = '@ViewBag.AddUserRoleUpdateAccess';
        // var deleteAccess = '@ViewBag.AddUserRoleDeleteAccess';
        var fullAccess = 'True';
        var addAccess = 'True';
        var viewAccess = 'True';
        var updateAccess = 'True';
        var deleteAccess = 'True';
        var viewButton = "";
        var updateButton = "";
        var deleteButton = "";
        $(document).ready(function () {
            getMakeMaster();
            if (fullAccess === "True" || viewAccess === "True") {
                setSideMenu("model-master");
                clearControls();
                checkValidationOnChange();
                //getUserRoleList();
                var modelMasterID = GetParameterValues('modelMasterID');
                getModelMasterByID(modelMasterID);

                $(function () {
                    $("#from-date-picker").datepicker({
                        dateFormat: 'dd-mm-yy'
                    });

                    $("#to-date-picker").datepicker({
                        dateFormat: 'dd-mm-yy'
                    });
                });
            }
        });

        function bindDataTable() {
            $('#tblModelMaster').DataTable({
                deferRender: true,
                scroller: true,
                scrollX: true,
                scrollY: true,
                searching: true,
                info: true,
                paging: true,
                dom: 'Bfrtip',
                "bDestroy": true,
                buttons: [
                    {
                        extend: 'copyHtml5',
                        text: 'Copy'
                    },
                    {
                        extend: 'csvHtml5',
                        text: 'Csv',
                        title: function () {
                            return "Model Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Csv</span>',
                        titleAttr: 'Csv'
                    },
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: function () {
                            return "Model Master List";
                        },
                        text: '<span class="fa fa-file-pdf-o">Excel</span>',
                        titleAttr: 'Excel'
                    },
                    {
                        extend: "print",
                        exportOptions: {
                            orientation: 'landscape'
                        },
                        pageSize: 'A0',
                        customize: function (win) {
                            var last = null;
                            var current = null;
                            var bod = [];

                            var css = '@@page { size: landscape; }',
                                head = win.document.head || win.document.getElementsByTagName('head')[0],
                                style = win.document.createElement('style');

                            style.type = 'text/css';
                            style.media = 'print';

                            if (style.styleSheet) {
                                style.styleSheet.cssText = css;
                            }
                            else {
                                style.appendChild(win.document.createTextNode(css));
                            }
                            head.appendChild(style);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: function () {
                            return "Model Master List";
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        text: '<span class="fa fa-file-pdf-o">PDF</span>',
                        titleAttr: 'PDF'
                    }
                ]
            });
        }

